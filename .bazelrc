common --enable_bzlmod

build --announce_rc
build --color=yes
test --test_output=errors

# Disk cache is machine-local, outside the checkout; output symlinks are ignored.
common --disk_cache=~/.cache/bazel-disk

# Android builder tools and rules_android sources use Java 17 language
# features (records, sealed types), and the Bazel tools that package them run
# on JDK 21. These flags affect build tools only, not the Android minSdk.
common --java_language_version=17
common --tool_java_language_version=17
common --java_runtime_version=remotejdk_21
common --tool_java_runtime_version=remotejdk_21
