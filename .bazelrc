common --enable_bzlmod

build --announce_rc
build --color=yes
test --test_output=errors

# Android app version defaults. `projects/mobile/android/distribute.sh`
# overrides these with --define so each App Distribution build gets a higher
# versionCode; ordinary builds stay 1 / 0.1.0.
build --define=home_version_code=1
build --define=home_version_name=0.1.0

# Disk cache is machine-local, outside the checkout; output symlinks are ignored.
common --disk_cache=~/.cache/bazel-disk

# Android builder tools and rules_android sources use Java 17 language
# features (records, sealed types), and the Bazel tools that package them run
# on JDK 21. These flags affect build tools only, not the Android minSdk.
common --java_language_version=17
common --tool_java_language_version=17
common --java_runtime_version=remotejdk_21
common --tool_java_runtime_version=remotejdk_21

# Use the released protoc binary instead of compiling protoc from C++ sources:
# on a cold CI runner that compile was ~40% of the Android app build (the app
# itself has no protos; rules_android's tools need protoc).
common --incompatible_enable_proto_toolchain_resolution
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

# Dex and desugar Android libraries in persistent workers instead of one JVM per
# jar (~1200 actions for the Maven dependencies); output is unchanged.
build --persistent_android_dex_desugar
