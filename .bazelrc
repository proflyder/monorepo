common --enable_bzlmod

# `rust_clippy_test` only exits non-zero on rustc errors: the levels from the
# root Cargo.toml `[workspace.lints]` (forwarded through `extract_cargo_lints`)
# are `warn`, so without this flag a new clippy warning passes both the local
# build and PR CI. Deny warnings for every Rust unit, matching the cargo
# invocation in the Pulsar/provider scripts.
build --@rules_rust//rust/settings:clippy_flag=-Dwarnings
test --@rules_rust//rust/settings:clippy_flag=-Dwarnings

build --announce_rc
build --color=yes
test --test_output=errors

# Android app version defaults. `projects/mobile/android/distribute.sh`
# overrides these with --define so each App Distribution build gets a higher
# versionCode; ordinary builds stay 1 / 0.1.0.
build --define=home_version_code=1
build --define=home_version_name=0.1.0

# Disk cache is machine-local, outside the checkout; output symlinks are ignored.
common --disk_cache=~/.cache/bazel-disk
# The cache is shared by every checkout/worktree and has no limit by default.
# The server evicts the least recently used entries in the background while
# idle; builds never fail on it.
common --experimental_disk_cache_gc_max_size=15G
common --experimental_disk_cache_gc_max_age=14d

# Android builder tools and rules_android sources use Java 17 language
# features (records, sealed types), and the Bazel tools that package them run
# on JDK 21. These flags affect build tools only, not the Android minSdk.
common --java_language_version=17
common --tool_java_language_version=17
common --java_runtime_version=remotejdk_21
common --tool_java_runtime_version=remotejdk_21

# Third-party javac sources that run as build tools (protobuf, the rules_android
# dexer tools) are compiled in the exec configuration and emit their own
# [removal]/deprecation warnings. They are not ours to fix and only add noise to
# every cold build, so silence javac there. First-party Kotlin/Java keeps
# `warn = "error"` (//platform/android:jvm17_options) in the target
# configuration, and android_lint still runs with -Werror.
build --host_javacopt=-Xlint:none
build --host_javacopt=-nowarn

# Use the released protoc binary instead of compiling protoc from C++ sources:
# on a cold CI runner that compile was ~40% of the Android app build (the app
# itself has no protos; rules_android's tools need protoc).
common --incompatible_enable_proto_toolchain_resolution
common --@protobuf//bazel/toolchains:prefer_prebuilt_protoc

# Dex and desugar Android libraries in persistent workers instead of one JVM per
# jar (~1200 actions for the Maven dependencies); output is unchanged.
build --persistent_android_dex_desugar
