#!/usr/bin/env python3
"""Fail closed: publish only develop, never the private archive or tags."""
import subprocess
import sys
import shutil
from pathlib import Path
root = Path(__file__).resolve().parents[1]
for line in sys.stdin:
    local_ref, local_sha, remote_ref, remote_sha = line.split()
    if local_ref != 'refs/heads/develop' or remote_ref != 'refs/heads/develop':
        sys.exit('Push blocked: only develop -> develop is permitted; archive/tags stay private.')
    if local_sha != subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=root, text=True).strip():
        sys.exit('Push blocked: check out develop before publishing it.')
    if set(local_sha) == {'0'}:
        sys.exit('Push blocked: branch deletion is not permitted by this guard.')
    private = subprocess.run(['git', 'merge-base', 'local-history', local_sha], cwd=root, capture_output=True)
    if private.returncode not in (0, 1):
        sys.exit('Push blocked: cannot verify private history isolation.')
    if private.returncode == 0:
        sys.exit('Push blocked: outgoing history includes private historical ancestry.')
if subprocess.check_output(['git', 'status', '--porcelain'], cwd=root).strip():
    sys.exit('Push blocked: commit or stash changes before the publication audit.')
scanner = shutil.which('gitleaks') or str(root / 'secrets/local-tools/gitleaks')
if not Path(scanner).is_file():
    sys.exit('Push blocked: install gitleaks before publishing.')
scan = subprocess.run([scanner, 'git', '.', '--log-opts=refs/heads/develop', '--redact=100', '--no-banner', '--config=.gitleaks.toml'], cwd=root)
if scan.returncode:
    sys.exit('Push blocked: secret scan failed; inspect locally with redaction.')
result = subprocess.run([sys.executable, str(root / 'platform/quality/audit_repository.py')], cwd=root)
sys.exit(result.returncode)
