load("//platform/android:defs.bzl", "home_android_local_test", "metro_android_library")

package(default_visibility = ["//visibility:public"])

metro_android_library(
    name = "theme",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    custom_package = "dev.proflyder.home.core.theme",
    manifest = "src/main/AndroidManifest.xml",
    resource_files = glob(["src/main/res/**"]),
    deps = [
        "//packages/kotlin/core",
        "//projects/mobile/android/core/runtime",
        "@maven//:androidx_annotation_annotation_jvm",
        "@maven//:androidx_appcompat_appcompat",
        "@maven//:androidx_datastore_datastore_preferences",
        "@maven//:com_google_android_material_material",
        "@maven//:dev_zacsweers_metro_runtime_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_android",
    ],
)

home_android_local_test(
    name = "robolectric_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    associates = [":theme"],
    custom_package = "dev.proflyder.home.core.theme",
    manifest = "src/test/AndroidManifest.xml",
    test_classes = [
        "dev.proflyder.home.core.theme.ThemeTestSuite",
    ],
    deps = [
        "@maven//:androidx_appcompat_appcompat",
        "@maven//:androidx_datastore_datastore_preferences",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_android",
        "@maven//:com_google_android_material_material",
        "@maven//:junit_junit",
        "@maven//:org_robolectric_robolectric",
    ],
)
