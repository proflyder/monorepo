load("//platform/android:defs.bzl", "home_jvm_library", "home_jvm_test")

package(default_visibility = ["//visibility:public"])

home_jvm_library(
    name = "network",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    deps = [
        "//packages/kotlin/core",
        "//projects/mobile/android/core/config",
        "//projects/mobile/android/core/model",
        "@maven//:com_squareup_okhttp3_okhttp",
        "@maven//:com_squareup_retrofit2_converter_kotlinx_serialization",
        "@maven//:com_squareup_retrofit2_retrofit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json",
    ],
)

home_jvm_test(
    name = "network_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    resources = glob(["src/test/resources/**"]),
    test_class = "dev.proflyder.home.core.network.AllNetworkTests",
    deps = [
        ":network",
        "//projects/mobile/android/core/testing",
        "//projects/mobile/android/core/config",
        "//projects/mobile/android/core/model",
        "@maven//:com_squareup_okhttp3_mockwebserver",
        "@maven//:com_squareup_okhttp3_okhttp",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_core_jvm",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json",
    ],
)
