<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Soft tonal card used by every list row. -->
    <style name="Widget.Home.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/ui_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="checkedIconTint">?attr/colorPrimary</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Large light clock digits, fixed-width so they do not jitter while counting. -->
    <style name="TextAppearance.Home.Time" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">48sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Home.Countdown" parent="TextAppearance.Home.Time">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.Home.ToolbarTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Home.Pill" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Segmented selection: compact pills, one tonal indicator, no underline.
         Time's TabLayout and the voice-profile switch both use this style. -->
    <style name="Widget.Home.PillTabs" parent="Widget.Material3.TabLayout.OnSurface">
        <item name="tabMode">scrollable</item>
        <item name="tabGravity">start</item>
        <item name="tabIndicator">@drawable/ui_bg_pill_indicator</item>
        <item name="tabIndicatorColor">?attr/colorSecondaryContainer</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabTextColor">@color/ui_pill_text</item>
        <item name="tabTextAppearance">@style/TextAppearance.Home.PillTab</item>
        <item name="tabPaddingStart">0dp</item>
        <item name="tabPaddingTop">0dp</item>
        <item name="tabPaddingEnd">0dp</item>
        <item name="tabPaddingBottom">0dp</item>
        <!-- The old TabLayout showed a horizontal scrollbar as a stray line. -->
        <item name="android:scrollbars">none</item>
    </style>

    <style name="TextAppearance.Home.PillTab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Home.DangerTextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorError</item>
        <item name="rippleColor">?attr/colorError</item>
    </style>
</resources>
