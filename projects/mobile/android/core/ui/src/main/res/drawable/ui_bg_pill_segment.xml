<?xml version="1.0" encoding="utf-8"?>
<!-- Selected pill: the bottom-navigation indicator stadium; others: only a
     rounded ripple on touch. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="@dimen/ui_pill_radius" />
        </shape>
    </item>
    <item>
        <selector android:enterFadeDuration="150" android:exitFadeDuration="150">
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <solid android:color="?attr/colorSecondaryContainer" />
                    <corners android:radius="@dimen/ui_pill_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/transparent" />
                    <corners android:radius="@dimen/ui_pill_radius" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
