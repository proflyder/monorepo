<?xml version="1.0" encoding="utf-8"?>
<!-- One pill of PillSegments: compact label, stadium only when selected. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/ui_pill_height"
    android:layout_marginEnd="@dimen/ui_pill_gap"
    android:background="@drawable/ui_bg_pill_segment"
    android:gravity="center"
    android:maxLines="1"
    android:paddingStart="@dimen/ui_pill_padding_horizontal"
    android:paddingEnd="@dimen/ui_pill_padding_horizontal"
    android:textAppearance="@style/TextAppearance.Home.PillTab"
    android:textColor="@color/ui_pill_text"
    tools:ignore="SelectableText" />
