load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")

package(default_visibility = ["//visibility:public"])

kt_jvm_library(
    name = "config",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    deps = [
        "//packages/kotlin/core",
        "//projects/mobile/android/core/model",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json",
    ],
)

kt_jvm_test(
    name = "config_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    test_class = "dev.proflyder.home.core.config.ConnectionConfigTest",
    deps = [
        ":config",
        "//projects/mobile/android/core/testing",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_test",
    ],
)

kt_jvm_test(
    name = "remote_connection_source_test",
    srcs = ["src/test/kotlin/dev/proflyder/home/core/config/RemoteConnectionSourceTest.kt"],
    resources = glob(["src/test/resources/**"]),
    test_class = "dev.proflyder.home.core.config.RemoteConnectionSourceTest",
    deps = [
        ":config",
        "//projects/mobile/android/core/testing",
        "@maven//:junit_junit",
    ],
)
