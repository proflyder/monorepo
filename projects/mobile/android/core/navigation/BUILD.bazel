home_android_local_test(
    name = "robolectric_test",
    shard_count = 2,
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    custom_package = "dev.proflyder.home.core.navigation",
    manifest = "src/test/AndroidManifest.xml",
    test_classes = [
        "dev.proflyder.home.core.navigation.FragmentRouterTest",
        "dev.proflyder.home.core.navigation.NotificationTargetsTest",
    ],
    deps = [
        ":navigation",
        "//projects/mobile/android/core/access",
