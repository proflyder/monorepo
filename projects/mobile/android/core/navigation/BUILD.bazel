    manifest = "src/test/AndroidManifest.xml",
    robolectric_properties_file = "robolectric-deps.properties",
    test_class = "dev.proflyder.home.core.navigation.FragmentRouterTest",
    deps = [
        ":navigation",
        "//projects/mobile/android/core/testing",
