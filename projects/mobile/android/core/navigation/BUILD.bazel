load("//platform/android:defs.bzl", "home_android_local_test")
load("@rules_kotlin//kotlin:android.bzl", "kt_android_library")

package(default_visibility = ["//visibility:public"])

kt_android_library(
    name = "navigation",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    custom_package = "dev.proflyder.home.core.navigation",
    manifest = "src/main/AndroidManifest.xml",
    deps = [
        "//packages/kotlin/core",
        "//projects/mobile/android/core/access",
        "//projects/mobile/android/core/model",
        "@maven//:androidx_appcompat_appcompat",
        "@maven//:androidx_core_core_ktx",
        "@maven//:androidx_fragment_fragment_ktx",
