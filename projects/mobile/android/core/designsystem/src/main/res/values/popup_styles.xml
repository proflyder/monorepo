<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Animation.Home.PopupMenu" parent="">
        <item name="android:windowEnterAnimation">@anim/ds_popup_menu_in</item>
        <item name="android:windowExitAnimation">@anim/ds_popup_menu_out</item>
    </style>

    <style name="TextAppearance.Home.PopupMenuItem" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Home.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/ds_bg_popup_menu</item>
        <item name="android:popupElevation">@dimen/ds_popup_elevation</item>
        <item name="android:popupAnimationStyle">@style/Animation.Home.PopupMenu</item>
    </style>

    <style name="Widget.Home.ListPopupWindow" parent="Widget.Material3.PopupMenu.ListPopupWindow">
        <item name="android:popupBackground">@drawable/ds_bg_popup_menu</item>
        <item name="android:popupElevation">@dimen/ds_popup_elevation</item>
        <item name="android:popupAnimationStyle">@style/Animation.Home.PopupMenu</item>
    </style>
</resources>
