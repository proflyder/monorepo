<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/ds_space_xl"
    android:paddingEnd="@dimen/ds_space_xl"
    android:paddingBottom="@dimen/ds_space_l"
    tools:ignore="SelectableText">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:id="@+id/ds_sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/ds_space_s"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <NumberPicker
        android:id="@+id/ds_sheet_wheel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:descendantFocusability="blocksDescendants" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_m"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ds_sheet_cancel"
            style="@style/Widget.Home.Button.Text.M"
            android:layout_width="wrap_content"
            android:text="@string/ds_action_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ds_sheet_done"
            style="@style/Widget.Home.Button.Filled.M"
            android:layout_width="wrap_content"
            android:layout_marginStart="@dimen/ds_space_s"
            android:text="@string/ds_action_done" />
    </LinearLayout>
</LinearLayout>
