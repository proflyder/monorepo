<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Home.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/ds_radius_xl</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="checkedIconTint">?attr/colorPrimary</item>
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.Home.Card.Selected">
        <item name="strokeColor">?attr/colorPrimary</item>
        <item name="strokeWidth">@dimen/ds_stroke_thick</item>
    </style>

    <style name="Widget.Home.Card.StateOn">
        <item name="strokeColor">?attr/colorStateOn</item>
        <item name="strokeWidth">@dimen/ds_stroke_thin</item>
    </style>

    <style name="Widget.Home.Slider" parent="Widget.Material3.Slider">
        <item name="trackColorActive">?attr/colorPrimary</item>
        <item name="trackColorInactive">?attr/colorSurfaceContainerHighest</item>
        <item name="tickColorActive">?attr/colorOnPrimary</item>
        <item name="tickColorInactive">?attr/colorOnSurfaceVariant</item>
        <item name="tickRadiusActive">2dp</item>
        <item name="tickRadiusInactive">2dp</item>
        <item name="thumbColor">?attr/colorPrimary</item>
        <item name="trackHeight">@dimen/ds_slider_track_height</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <style name="Widget.Home.Slider.Gradient" parent="Widget.Home.Slider">
        <item name="trackColorActive">@android:color/transparent</item>
        <item name="trackColorInactive">@android:color/transparent</item>
        <item name="tickVisibilityMode">hidden</item>
    </style>

    <style name="Widget.Home.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/ds_radius_s</item>
    </style>

    <style name="Widget.Home.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="chipCornerRadius">@dimen/ds_radius_s</item>
    </style>

    <style name="Widget.Home.SectionHeader" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleSmall</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:paddingTop">@dimen/ds_space_l</item>
        <item name="android:paddingBottom">@dimen/ds_space_s</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="Widget.Home.StatusChip" parent="">
        <item name="android:layout_height">@dimen/ds_status_chip_height</item>
        <item name="android:minHeight">@dimen/ds_status_chip_height</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/ds_space_s</item>
        <item name="android:paddingEnd">@dimen/ds_space_s</item>
        <item name="android:maxLines">1</item>
        <item name="android:background">@drawable/ds_bg_status_chip</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
    </style>

    <style name="Widget.Home.StatusChip.Error">
        <item name="android:backgroundTint">?attr/colorErrorContainer</item>
        <item name="android:textColor">?attr/colorOnErrorContainer</item>
    </style>

    <style name="Widget.Home.StatusChip.Warning">
        <item name="android:backgroundTint">?attr/colorWarning</item>
        <item name="android:textColor">?attr/colorOnWarning</item>
    </style>

    <style name="Widget.Home.StatusChip.Success">
        <item name="android:backgroundTint">?attr/colorSuccess</item>
        <item name="android:textColor">?attr/colorOnSuccess</item>
    </style>

    <style name="Widget.Home.StatusChip.Neutral">
        <item name="android:backgroundTint">?attr/colorSurfaceContainerHighest</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Home.FieldSupportingText" parent="">
        <item name="android:layout_marginTop">@dimen/ds_space_s</item>
        <item name="android:paddingStart">@dimen/ds_field_supporting_padding</item>
        <item name="android:paddingEnd">@dimen/ds_field_supporting_padding</item>
        <item name="android:textAppearance">?attr/textAppearanceBodySmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Home.FieldSupportingText.Error">
        <item name="android:textColor">?attr/colorError</item>
    </style>

    <style name="Widget.Home.ToolbarTitle" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Home.ToolbarTitle</item>
        <item name="android:breakStrategy">balanced</item>
        <item name="android:hyphenationFrequency">none</item>
        <item name="android:ellipsize">none</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="TextAppearance.Home.Time" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">48sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Home.Countdown" parent="TextAppearance.Home.Time">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">44sp</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.Home.ToolbarTitle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Home.Pill" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="TextAppearance.Home.PillTab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="TextAppearance.Home.CardTime" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.Home.ChatMeta" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Home.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="boxStrokeColor">@color/ds_text_input_stroke</item>
        <item name="boxStrokeErrorColor">?attr/colorError</item>
        <item name="boxCornerRadiusTopStart">@dimen/ds_radius_l</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ds_radius_l</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ds_radius_l</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ds_radius_l</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Home.TextInput</item>
        <item name="shapeAppearanceOverlay">@null</item>
        <item name="hintEnabled">true</item>
        <item name="hintTextColor">?attr/colorStateOn</item>
        <item name="cursorColor">?attr/colorStateOn</item>
        <item name="endIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="startIconTint">?attr/colorOnSurfaceVariant</item>
        <item name="helperTextTextAppearance">?attr/textAppearanceBodySmall</item>
        <item name="errorTextAppearance">?attr/textAppearanceBodySmall</item>
        <item name="counterTextAppearance">?attr/textAppearanceBodySmall</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Home.TextInput</item>
    </style>

    <style name="Widget.Home.TextInput.Chat" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">?attr/colorSurfaceContainerHigh</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">@dimen/ds_stroke_thin</item>
        <item name="boxStrokeColor">@color/ds_chat_input_stroke</item>
        <item name="boxCornerRadiusTopStart">@dimen/ds_radius_l</item>
        <item name="boxCornerRadiusTopEnd">@dimen/ds_radius_l</item>
        <item name="boxCornerRadiusBottomStart">@dimen/ds_radius_l</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/ds_radius_l</item>
        <item name="hintEnabled">false</item>
        <item name="cursorColor">?attr/colorStateOn</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Home.TextInput.Chat</item>
    </style>

    <style name="ShapeAppearance.Home.TextInput" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ds_radius_l</item>
    </style>

    <style name="ThemeOverlay.Home.TextInput" parent="ThemeOverlay.Material3.TextInputEditText.FilledBox">
        <item name="colorControlActivated">?attr/colorStateOn</item>
        <item name="android:colorControlActivated">?attr/colorStateOn</item>
    </style>

    <style name="ThemeOverlay.Home.TextInput.Chat" parent="ThemeOverlay.Material3.TextInputEditText.OutlinedBox">
        <item name="colorControlActivated">?attr/colorStateOn</item>
        <item name="android:colorControlActivated">?attr/colorStateOn</item>
    </style>
</resources>
