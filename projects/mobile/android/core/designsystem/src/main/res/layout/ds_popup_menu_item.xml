<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ds_control_l"
    android:background="@drawable/ds_bg_popup_menu_item"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ds_space_l"
    android:paddingEnd="@dimen/ds_space_l">

    <ImageView
        android:id="@+id/ds_popup_menu_icon"
        android:layout_width="@dimen/ds_icon_m"
        android:layout_height="@dimen/ds_icon_m"
        android:importantForAccessibility="no"
        app:tint="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/ds_popup_menu_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_m"
        android:layout_weight="1"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Home.PopupMenuItem"
        tools:ignore="SelectableText" />
</LinearLayout>
