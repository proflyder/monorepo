<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Home" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="floatingActionButtonStyle">@style/Widget.Home.FloatingActionButton</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.Home.ExtendedFloatingActionButton</item>
        <item name="homeDeviceTileStyle">@style/Widget.Home.Card</item>
        <item name="homeToolbarTitleStyle">@style/Widget.Home.ToolbarTitle</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Home.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Home.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Home.Large</item>

        <item name="popupMenuStyle">@style/Widget.Home.PopupMenu</item>
        <item name="listPopupWindowStyle">@style/Widget.Home.ListPopupWindow</item>
        <item name="textAppearanceLargePopupMenu">@style/TextAppearance.Home.PopupMenuItem</item>
        <item name="textAppearanceSmallPopupMenu">@style/TextAppearance.Home.PopupMenuItem</item>

        <item name="textInputStyle">@style/Widget.Home.TextInput</item>
        <item name="viewInflaterClass">dev.proflyder.home.core.designsystem.HomeViewInflater</item>
        <item name="materialSwitchStyle">@style/Widget.Home.Switch</item>
    </style>

    <style name="ShapeAppearance.Home.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ds_radius_m</item>
    </style>

    <style name="ShapeAppearance.Home.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ds_radius_l</item>
    </style>

    <style name="ShapeAppearance.Home.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/ds_radius_xl</item>
    </style>
</resources>
