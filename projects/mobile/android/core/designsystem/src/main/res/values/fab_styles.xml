<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.Home.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="elevation">?attr/homeFabElevation</item>
        <item name="strokeWidth">?attr/homeFabStrokeWidth</item>
        <item name="strokeColor">?attr/homeFabStrokeColor</item>
    </style>

    <style name="Widget.Home.FloatingActionButton.SmallSecondary" parent="Widget.Material3.FloatingActionButton.Small.Secondary">
        <item name="elevation">?attr/homeFabElevation</item>
        <item name="strokeWidth">?attr/homeFabStrokeWidth</item>
        <item name="strokeColor">?attr/homeFabStrokeColor</item>
    </style>

    <style name="Widget.Home.FloatingActionButton.Small" parent="Widget.Material3.FloatingActionButton.Small.Primary">
        <item name="elevation">?attr/homeFabElevation</item>
        <item name="strokeWidth">?attr/homeFabStrokeWidth</item>
        <item name="strokeColor">?attr/homeFabStrokeColor</item>
    </style>

    <style name="Widget.Home.ExtendedFloatingActionButton" parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="elevation">?attr/homeFabElevation</item>
        <item name="strokeWidth">?attr/homeFabStrokeWidth</item>
        <item name="strokeColor">?attr/homeFabStrokeColor</item>
    </style>

    <style name="Widget.Home.FabLabel" parent="">
        <item name="android:background">@drawable/ds_bg_fab_label</item>
        <item name="android:paddingStart">@dimen/ds_space_m</item>
        <item name="android:paddingEnd">@dimen/ds_space_m</item>
        <item name="android:paddingTop">@dimen/ds_fab_label_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/ds_fab_label_padding_vertical</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
</resources>
