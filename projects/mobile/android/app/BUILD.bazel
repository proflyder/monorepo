load("@rules_kotlin//kotlin:android.bzl", "kt_android_local_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load(":robolectric_android_all.bzl", "android_all_dir")
load("//platform/android:defs.bzl", "home_android_binary", "metro_android_library")

package(default_visibility = ["//visibility:public"])

metro_android_library(
    name = "app_lib",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    custom_package = "dev.proflyder.home",
    manifest = "src/main/AndroidManifest.xml",
    resource_files = glob(["src/main/res/**"]),
    view_binding = True,
    deps = [
        "//projects/mobile/android/core/config:config",
        "//projects/mobile/android/core/model:model",
        "//projects/mobile/android/core/navigation:navigation",
        "//projects/mobile/android/core/network:network",
        "//projects/mobile/android/core/settings:settings",
        "//projects/mobile/android/core/ui:ui",
        "//projects/mobile/android/features/alarms/api:api",
        "//projects/mobile/android/features/alarms/impl:impl",
        "//projects/mobile/android/features/connection/api:api",
        "//projects/mobile/android/features/connection/impl:impl",
        "//projects/mobile/android/features/reminders/api:api",
        "//projects/mobile/android/features/reminders/impl:impl",
        "//projects/mobile/android/features/timers/api:api",
        "//projects/mobile/android/features/timers/impl:impl",
        "@maven//:androidx_activity_activity_ktx",
        "@maven//:androidx_appcompat_appcompat",
        "@maven//:androidx_core_core_ktx",
        "@maven//:androidx_fragment_fragment_ktx",
        "@maven//:androidx_lifecycle_lifecycle_runtime_ktx",
        "@maven//:androidx_lifecycle_lifecycle_viewmodel_ktx",
        "@maven//:com_google_android_material_material",
        # Runtime implementation of ListenableFuture used by
        # androidx.concurrent.futures / androidx.profileinstaller. It must be a
        # real APK dependency, not just a test-classpath artifact.
        "@maven//:com_google_guava_listenablefuture",
        "@maven//:dev_zacsweers_metro_runtime_jvm",
        "@maven//:com_squareup_okhttp3_okhttp",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_android",
    ],
)

home_android_binary(
    name = "app",
    manifest = "src/main/AndroidManifest.xml",
    deps = [":app_lib"],
)

# APK-level packaging gate. Robolectric's classpath contains test-only Guava,
# so only the packaged artifacts can prove the runtime closure is complete.
sh_test(
    name = "apk_runtime_closure_test",
    srcs = ["//platform/android:apk_runtime_closure.sh"],
    args = [
        "$(location //platform/android:apk_runtime_closure.py)",
        "$(location :app.apk)",
        "$(location :app_deploy.jar)",
    ],
    data = [
        "//platform/android:apk_runtime_closure.py",
        ":app.apk",
        ":app_deploy.jar",
    ],
)


# Robolectric resolves SDK 35 to this pinned preinstrumented jar. The staged
# properties file avoids any runtime Maven download; rules_android turns it into
# -Drobolectric-deps.properties for the test JVM.
android_all_dir(
    name = "robolectric_android_all_sdk35",
    jar = "@maven//:org_robolectric_android_all_instrumented",
    jar_name = "android-all-instrumented-15-robolectric-13954326-i7.jar",
)

kt_android_local_test(
    name = "main_activity_smoke_test",
    srcs = [
        "src/test/kotlin/dev/proflyder/home/AppSmokeTestSuite.kt",
        "src/test/kotlin/dev/proflyder/home/ConnectionSettingsClearTest.kt",
        "src/test/kotlin/dev/proflyder/home/MainActivitySmokeTest.kt",
    ],
    associates = [":app_lib"],
    custom_package = "dev.proflyder.home",
    data = [
        ":robolectric_android_all_sdk35",
        "robolectric-deps.properties",
    ],
    jvm_flags = [
        "-Drobolectric.offline=true",
        "--add-opens=java.base/java.lang=ALL-UNNAMED",
        "--add-opens=java.base/java.io=ALL-UNNAMED",
        "--add-opens=java.base/java.net=ALL-UNNAMED",
        "--add-opens=java.base/java.security=ALL-UNNAMED",
        "--add-opens=java.base/java.text=ALL-UNNAMED",
        "--add-opens=java.base/java.util=ALL-UNNAMED",
        "--add-opens=java.base/java.util.concurrent=ALL-UNNAMED",
        "--add-opens=java.base/jdk.internal.util=ALL-UNNAMED",
    ],
    manifest = "src/main/AndroidManifest.xml",
    robolectric_properties_file = "robolectric-deps.properties",
    test_class = "dev.proflyder.home.AppSmokeTestSuite",
    deps = [
        "//projects/mobile/android/core/config:config",
        "//projects/mobile/android/core/model:model",
        "//projects/mobile/android/core/network:network",
        "//projects/mobile/android/core/settings:settings",
        "@maven//:com_squareup_okhttp3_okhttp",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
        "@maven//:org_robolectric_robolectric",
    ],
)
