    ] + select({
        ":network_inspection_on": ["//projects/mobile/android/app/diagnostics"],
        "//conditions:default": [],
    }),
)

config_setting(
    name = "network_inspection_on",
    define_values = {"home_network_inspection": "on"},
)

home_android_binary(
    name = "app",
    manifest = "src/main/AndroidManifest.xml",
    deps = [":app_lib"],
)

sh_test(
    name = "apk_runtime_closure_test",
    srcs = ["//platform/android:apk_runtime_closure.sh"],
    args = [
        "$(location //platform/android/tools/apk_runtime_closure)",
        "$(location :app.apk)",
        "$(location :app_deploy.jar)",
    ],
    data = [
        ":app.apk",
        ":app_deploy.jar",
        "//platform/android/tools/apk_runtime_closure",
    ],
)

sh_test(
    name = "apk_abi_test",
    srcs = ["//platform/android:apk_abi_test.sh"],
    args = ["$(location :app.apk)"],
    data = [":app.apk"],
)

sh_test(
    name = "apk_manifest_test",
    srcs = ["//platform/android:apk_manifest_test.sh"],
    args = [
        "$(location @androidsdk//:aapt2)",
        "$(location :app.apk)",
    ],
    data = [
        ":app.apk",
        "@androidsdk//:aapt2",
    ],
)

sh_test(
    name = "apk_network_inspection_test",
    srcs = ["//platform/android:apk_network_inspection_test.sh"],
    args = ["$(location :app.apk)"] + select({
        ":network_inspection_on": ["present"],
        "//conditions:default": ["absent"],
    }),
    data = [":app.apk"],
)

