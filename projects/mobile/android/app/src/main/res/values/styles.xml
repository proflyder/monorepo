<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Toolbar overflow popup: the same tonal cards and large corners as the list. -->
    <style name="Widget.Home.PopupMenu" parent="Widget.Material3.PopupMenu">
        <item name="android:popupBackground">@drawable/app_popup_menu_background</item>
        <item name="android:popupElevation">@dimen/ui_popup_elevation</item>
        <item name="android:itemBackground">@drawable/app_popup_menu_item_background</item>
        <item name="android:itemTextAppearance">@style/TextAppearance.Home.PopupItem</item>
    </style>

    <style name="Widget.Home.PopupMenu.Overflow" parent="Widget.Home.PopupMenu" />

    <style name="ThemeOverlay.Home.Toolbar" parent="">
        <item name="popupMenuStyle">@style/Widget.Home.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Widget.Home.PopupMenu.Overflow</item>
    </style>

    <style name="TextAppearance.Home.PopupItem" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Time section switch: text-width pills; the stadium indicator follows the
         active tab, using the same tonal colour as the bottom navigation. -->
    <style name="Widget.Home.TimeTabs" parent="Widget.Material3.TabLayout.OnSurface">
        <item name="tabMode">auto</item>
        <item name="tabGravity">center</item>
        <item name="tabIndicator">@drawable/time_tab_indicator</item>
        <item name="tabIndicatorColor">?attr/colorSecondaryContainer</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorGravity">stretch</item>
        <item name="tabIndicatorAnimationMode">elastic</item>
        <item name="tabRippleColor">@color/time_tab_ripple</item>
        <item name="tabTextColor">@color/time_tab_text</item>
        <item name="tabTextAppearance">@style/TextAppearance.Home.TimeTab</item>
        <item name="tabPaddingStart">@dimen/ui_tab_gap</item>
        <item name="tabPaddingTop">0dp</item>
        <item name="tabPaddingEnd">@dimen/ui_tab_gap</item>
        <item name="tabPaddingBottom">0dp</item>
    </style>

    <style name="TextAppearance.Home.TimeTab" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
