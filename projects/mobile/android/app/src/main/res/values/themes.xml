<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Home" parent="Base.Theme.Home">
        <item name="colorPrimary">@color/theme_emerald_primary</item>
        <item name="colorOnPrimary">@color/theme_emerald_on_primary</item>
        <item name="colorPrimaryContainer">@color/theme_emerald_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/theme_emerald_on_primary_container</item>
        <item name="colorSecondary">@color/theme_emerald_secondary</item>
        <item name="colorOnSecondary">@color/theme_emerald_on_secondary</item>
        <item name="colorSecondaryContainer">@color/theme_emerald_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/theme_emerald_on_secondary_container</item>
        <item name="colorTertiary">@color/theme_emerald_tertiary</item>
        <item name="colorOnTertiary">@color/theme_emerald_on_tertiary</item>
