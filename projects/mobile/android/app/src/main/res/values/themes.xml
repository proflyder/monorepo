<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Home" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/home_primary</item>
        <item name="colorOnPrimary">@color/home_on_primary</item>
        <item name="colorPrimaryContainer">@color/home_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/home_on_primary_container</item>
        <item name="colorSecondary">@color/home_secondary</item>
        <item name="colorOnSecondary">@color/home_on_secondary</item>
        <item name="colorSecondaryContainer">@color/home_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/home_on_secondary_container</item>
        <item name="colorTertiary">@color/home_tertiary</item>
        <item name="colorOnTertiary">@color/home_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/home_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/home_on_tertiary_container</item>
        <item name="colorError">@color/home_error</item>
        <item name="android:colorBackground">@color/home_surface</item>
        <item name="colorSurface">@color/home_surface</item>
        <item name="colorOnSurface">@color/home_on_surface</item>
        <item name="colorOnBackground">@color/home_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/home_on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/home_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/home_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/home_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/home_surface_container_highest</item>
        <item name="colorOutline">@color/home_outline</item>
        <item name="colorOutlineVariant">@color/home_outline_variant</item>

        <!-- Rounder than stock M3: friendly, home-appliance feel. -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Home.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Home.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Home.Large</item>

        <item name="android:statusBarColor">@color/home_surface</item>
        <item name="android:navigationBarColor">@color/home_surface_container</item>
        <item name="android:windowLightStatusBar">@bool/home_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/home_light_bars</item>
    </style>

    <style name="ShapeAppearance.Home.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">14dp</item>
    </style>

    <style name="ShapeAppearance.Home.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">22dp</item>
    </style>

    <style name="ShapeAppearance.Home.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
</resources>
