        <item name="colorStateOn">?attr/colorPrimary</item>
        <item name="colorOnStateOn">?attr/colorOnPrimary</item>
        <item name="colorStateOnText">@color/theme_emerald_state_on_text</item>
        <item name="homeFabStrokeWidth">@dimen/theme_fab_stroke</item>
        <item name="homeFabStrokeColor">?attr/colorPrimary</item>
        <item name="homeFabGlowColor">?attr/colorPrimary</item>
        <item name="homeFabElevation">@dimen/theme_fab_elevation</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.Home.BottomSheetDialog</item>
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurfaceContainer</item>
        <item name="android:windowLightStatusBar">@bool/home_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/home_light_bars</item>
    </style>

    <style name="ThemeOverlay.Home.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="enableEdgeToEdge">true</item>
    </style>
</resources>
