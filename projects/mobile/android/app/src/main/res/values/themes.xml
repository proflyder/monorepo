        <item name="colorOnSurfaceVariant">@color/theme_emerald_on_surface_variant</item>
        <item name="colorSurfaceContainerLow">@color/theme_emerald_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/theme_emerald_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/theme_emerald_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/theme_emerald_surface_container_highest</item>
