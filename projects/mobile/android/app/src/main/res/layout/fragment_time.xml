<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Compact pills on the same grid as the screen title and the cards. -->
    <dev.proflyder.home.core.ui.PillSegments
        android:id="@+id/time_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ui_tile_gap"
        android:layout_marginBottom="@dimen/ui_tile_gap"
        android:paddingStart="@dimen/ui_screen_padding"
        android:paddingEnd="@dimen/ui_screen_padding" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/time_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
