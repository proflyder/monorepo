<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <dev.proflyder.home.core.designsystem.PillSegments
        android:id="@+id/time_tabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_s"
        android:layout_marginBottom="@dimen/ds_space_s"
        android:paddingStart="@dimen/ds_space_l"
        android:paddingEnd="@dimen/ds_space_l" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/time_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
