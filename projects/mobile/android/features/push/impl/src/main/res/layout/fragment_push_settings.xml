<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_l"
        android:paddingTop="@dimen/ds_space_l"
        android:paddingEnd="@dimen/ds_space_l"
        android:paddingBottom="@dimen/ds_space_xl">

        <TextView
            android:id="@+id/push_intro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/push_intro"
            android:textIsSelectable="true"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_l">

            <dev.proflyder.home.core.designsystem.list.GroupedRowsLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <dev.proflyder.home.core.designsystem.ListRow
                    android:id="@+id/push_notifications_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:rowIcon="@drawable/push_ic_section_notifications"
                    app:rowIconTint="?attr/colorPrimary"
                    app:rowTitle="@string/push_notifications_title">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/push_notifications_action"
                        style="@style/Widget.Home.IconButton.Tonal.M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ds_ic_open_in_new" />
                </dev.proflyder.home.core.designsystem.ListRow>

                <dev.proflyder.home.core.designsystem.ListRow
                    android:id="@+id/push_dnd_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:rowIcon="@drawable/push_ic_dnd"
                    app:rowIconTint="?attr/colorPrimary"
                    app:rowTitle="@string/push_dnd_title">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/push_dnd_action"
                        style="@style/Widget.Home.IconButton.Tonal.M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ds_ic_open_in_new" />
                </dev.proflyder.home.core.designsystem.ListRow>

                <dev.proflyder.home.core.designsystem.ListRow
                    android:id="@+id/push_full_screen_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clickable="true"
                    android:focusable="true"
                    app:rowIcon="@drawable/push_ic_fullscreen"
                    app:rowIconTint="?attr/colorPrimary"
                    app:rowTitle="@string/push_full_screen_title">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/push_full_screen_action"
                        style="@style/Widget.Home.IconButton.Tonal.M"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:icon="@drawable/ds_ic_open_in_new" />
                </dev.proflyder.home.core.designsystem.ListRow>

                <TextView
                    android:id="@+id/push_ring_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/ds_space_l"
                    android:paddingEnd="@dimen/ds_space_l"
                    android:paddingBottom="@dimen/ds_space_l"
                    android:textIsSelectable="true"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </dev.proflyder.home.core.designsystem.list.GroupedRowsLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_s">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/push_card_padding">


                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/push_device_name_title"
                    app:endIconMode="clear_text"
                    app:placeholderText="@string/push_device_name_hint"
                    app:startIconDrawable="@drawable/push_ic_device">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/push_device_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPersonName"
                        android:maxLength="64"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/push_device_name_save"
                    style="@style/Widget.Home.Button.Tonal.M"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_s"
                    android:text="@string/push_device_name_save" />

                <TextView
                    android:id="@+id/push_device_name_help"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_s"
                    android:text="@string/push_device_name_help"
                    android:textIsSelectable="true"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_s">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/push_card_padding">

                <TextView
                    android:id="@+id/push_register_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/push_ic_device_register"
                    android:drawablePadding="@dimen/push_section_icon_gap"
                    android:text="@string/push_register_title"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <TextView
                    android:id="@+id/push_registration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_s"
                    android:textIsSelectable="true"
                    android:textAppearance="?attr/textAppearanceBodyMedium" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/push_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_s"
                    android:indeterminate="true"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/push_register"
                    style="@style/Widget.Home.Button.Tonal.M"
                    android:layout_width="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_s"
                    android:text="@string/push_register"
                    app:icon="@drawable/push_ic_notification" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
