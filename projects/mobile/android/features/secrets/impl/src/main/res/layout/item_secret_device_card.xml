<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/secret_device_card"
    style="@style/Widget.Home.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ds_space_l"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="@dimen/ds_space_l"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            tools:ignore="UseCompoundDrawables">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/secrets_ic_device" />

            <TextView
                android:id="@+id/secret_device_card_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/secrets_device_card_message"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                tools:ignore="SelectableText" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secret_device_card_bind"
            style="@style/Widget.Home.Button.Tonal.S"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="@string/secrets_device_card_action" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
