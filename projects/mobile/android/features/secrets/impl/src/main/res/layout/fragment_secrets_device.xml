<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ProgressBar
        android:id="@+id/secrets_device_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp" />

    <LinearLayout
        android:id="@+id/secrets_device_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/secrets_device_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textIsSelectable="true" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secrets_device_retry"
            style="@style/Widget.Home.Button.Tonal.M"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/secrets_retry" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/secrets_device_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/secrets_device_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textIsSelectable="true"
            tools:text="Телефон не привязан." />

        <TextView
            android:id="@+id/secrets_device_enrolled_at"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:visibility="gone"
            tools:text="Привязано: 25 нояб. 2026 г." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secrets_device_rebind"
            style="@style/Widget.Home.Button.Tonal.M"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/secrets_device_rebind"
            android:visibility="gone" />

        <TextView
            android:id="@+id/secrets_device_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/secrets_device_help"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textIsSelectable="true" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/secrets_device_code_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/secrets_device_code_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/secrets_device_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="textCapCharacters"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secrets_device_bind"
            style="@style/Widget.Home.Button.Filled.L"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:text="@string/secrets_device_bind" />

        <TextView
            android:id="@+id/secrets_device_message"
            style="@style/Widget.Home.FieldSupportingText.Error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            tools:text="Код не подошёл." />
    </LinearLayout>
</LinearLayout>
