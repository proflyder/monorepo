<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/ds_space_l"
    android:paddingTop="@dimen/ds_space_l"
    android:paddingEnd="@dimen/ds_space_l"
    android:paddingBottom="@dimen/ds_space_s">

        <TextView
            android:id="@+id/secret_header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textIsSelectable="true"
            tools:text="k8s/home-assistant/scheduler-auth" />

        <TextView
            android:id="@+id/secret_header_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textIsSelectable="true"
            tools:text="Scheduler app tokens" />

        <TextView
            android:id="@+id/secret_header_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:ignore="SelectableText"
            tools:text="Current version 4" />

        <TextView
            android:id="@+id/secret_header_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:ignore="SelectableText"
            tools:text="Step-up active for reveal" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/secret_header_delete"
            style="@style/Widget.Home.Button.Destructive.M"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/secrets_delete" />
</LinearLayout>
