<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/secret_stepup_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/secrets_stepup_message"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <ProgressBar
        android:id="@+id/secret_stepup_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/secret_stepup_problem"
        style="@style/Widget.Home.FieldSupportingText.Error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:visibility="gone"
        tools:text="Подпись отклонена." />
</LinearLayout>
