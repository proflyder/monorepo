<?xml version="1.0" encoding="utf-8"?>
<dev.proflyder.home.core.designsystem.ListRow xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/secret_key_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:rowTitle="@string/secrets_key_placeholder"
    tools:rowTitle="service_token"
    tools:rowValue="••••••••">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/secret_key_copy"
        style="@style/Widget.Home.IconButton.Standard.S"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/secrets_copy"
        android:visibility="gone"
        app:icon="@drawable/secrets_ic_copy" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/secret_key_edit"
        style="@style/Widget.Home.IconButton.Standard.S"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/secrets_edit"
        app:icon="@drawable/secrets_ic_edit" />
</dev.proflyder.home.core.designsystem.ListRow>
