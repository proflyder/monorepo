<?xml version="1.0" encoding="utf-8"?>
<dev.proflyder.home.core.designsystem.glass.GlassHeaderLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/time_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <dev.proflyder.home.core.designsystem.glass.GlassScreenHeader
        android:id="@+id/time_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <dev.proflyder.home.core.designsystem.PillSegments
            android:id="@+id/time_tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_s"
            android:layout_marginBottom="@dimen/ds_space_s"
            android:paddingStart="@dimen/ds_space_l"
            android:paddingEnd="@dimen/ds_space_l" />
    </dev.proflyder.home.core.designsystem.glass.GlassScreenHeader>
</dev.proflyder.home.core.designsystem.glass.GlassHeaderLayout>
