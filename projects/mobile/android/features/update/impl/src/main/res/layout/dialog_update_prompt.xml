<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/ds_space_xl"
    android:paddingTop="@dimen/ds_space_xl"
    android:paddingEnd="@dimen/ds_space_xl"
    android:paddingBottom="@dimen/ds_space_l"
    tools:ignore="SelectableText">

    <TextView
        android:id="@+id/update_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/update_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_xs"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/update_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_m"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/update_notes_title"
        style="@style/Widget.Home.SectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_l"
        android:text="@string/home_update_notes_title" />

    <TextView
        android:id="@+id/update_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_s"
        android:ellipsize="end"
        android:maxLines="6"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/update_progress"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_space_s"
        android:layout_marginTop="@dimen/ds_space_l"
        android:visibility="gone"
        app:indicatorColor="?attr/colorPrimary"
        app:showAnimationBehavior="none"
        app:hideAnimationBehavior="none"
        app:trackColor="?attr/colorSurfaceContainerHighest"
        app:trackThickness="4dp" />

    <TextView
        android:id="@+id/update_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_s"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <dev.proflyder.home.core.designsystem.ButtonRow
        android:id="@+id/update_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ds_space_xl">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_later"
            style="@style/Widget.Home.Button.Outlined.M"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_update_action_later" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/update_action"
            style="@style/Widget.Home.Button.Filled.M"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_update_action_update" />
    </dev.proflyder.home.core.designsystem.ButtonRow>
</LinearLayout>
