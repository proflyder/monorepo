<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vpn_route_banner"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSecondaryContainer"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/ds_space_l"
    android:paddingTop="@dimen/ds_space_s"
    android:paddingEnd="@dimen/ds_space_l"
    android:paddingBottom="@dimen/ds_space_s"
    android:visibility="gone">

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        app:indicatorColor="?attr/colorOnSecondaryContainer"
        app:indicatorSize="@dimen/vpn_banner_progress" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_space_m"
        android:layout_weight="1"
        android:text="@string/vpn_route_connecting"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="?attr/colorOnSecondaryContainer" />
</LinearLayout>
