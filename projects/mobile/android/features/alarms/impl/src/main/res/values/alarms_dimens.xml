<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="alarms_screen_margin">16dp</dimen>
    <!-- Fallback before the bottom bar is measured; matches its real height:
         a 64dp icon+label action plus the 6dp bar padding on both sides. -->
    <dimen name="alarms_action_bar_height">76dp</dimen>
    <!-- Space reserved under the scrolling content for the sticky Save bar. -->
    <dimen name="alarms_editor_scroll_bottom">88dp</dimen>
    <dimen name="alarms_editor_section_gap">20dp</dimen>
    <integer name="alarms_columns">1</integer>

    <!-- Dense alarm card: one time/text line, at most one extra actions line. -->
    <dimen name="alarms_card_min_height">88dp</dimen>
    <dimen name="alarms_card_padding_start">14dp</dimen>
    <!-- The delete ripple is the 48dp icon button itself, so the card keeps a
         12dp gap to the circle: the round state layer stays inside the card
         and clear of the 24dp rounded corners. -->
    <dimen name="alarms_card_padding_end">12dp</dimen>
    <dimen name="alarms_card_padding_vertical">10dp</dimen>
    <!-- Trailing controls: a 48dp touch target with a 24dp glyph, separated
         from the switch by 4dp. -->
    <dimen name="alarms_card_icon_button_size">48dp</dimen>
    <dimen name="alarms_card_icon_size">24dp</dimen>
    <dimen name="alarms_card_trailing_gap">4dp</dimen>
    <!-- Minimum clearance between the delete ripple circle and the card edge. -->
    <dimen name="alarms_card_ripple_gap">8dp</dimen>
    <dimen name="alarms_card_time_gap">8dp</dimen>
    <dimen name="alarms_card_text_gap">4dp</dimen>
    <dimen name="alarms_card_actions_gap">8dp</dimen>
</resources>
