<?xml version="1.0" encoding="utf-8"?>
<!-- Display-only text; making every label selectable would change the UI. -->
<com.google.android.material.card.MaterialCardView
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SelectableText"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Home.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:checkedIcon="@null">

    <!-- Selection tint: behind the content, crossfaded when the row is picked. -->
    <View
        android:id="@+id/alarm_selection_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="?attr/colorSecondaryContainer"
        android:clickable="false"
        android:focusable="false" />

    <!-- Dense card: the time stays the anchor, the name and one summary line
         sit next to it, and the trailing switch/delete pair keeps the row at a
         single glance. The 88dp minimum keeps idle rows airy without the old
         stacked title/repeat/next block. The switch and the 48dp delete button
         are vertically centred together, 4dp apart; the card end padding
         (12dp) keeps the round delete ripple off the rounded outline. -->
    <LinearLayout
        android:id="@+id/alarm_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/alarms_card_min_height"
        android:orientation="vertical"
        android:paddingStart="@dimen/alarms_card_padding_start"
        android:paddingTop="@dimen/alarms_card_padding_vertical"
        android:paddingEnd="@dimen/alarms_card_padding_end"
        android:paddingBottom="@dimen/alarms_card_padding_vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/alarm_main_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/alarm_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Alarms.CardTime"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/alarm_texts"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/alarms_card_time_gap"
                android:layout_marginEnd="@dimen/alarms_card_text_gap"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/alarm_trailing"
                app:layout_constraintStart_toEndOf="@id/alarm_time"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/alarm_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/alarm_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Idle: switch plus delete. Selection mode: both are gone and the
                 circular check indicator takes their place, inset by the card
                 padding so it never touches the rounded corner. -->
            <LinearLayout
                android:id="@+id/alarm_trailing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/alarm_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/alarms_enabled" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/alarm_delete"
                    style="@style/Widget.Alarms.CardIconButton"
                    android:layout_width="@dimen/alarms_card_icon_button_size"
                    android:layout_height="@dimen/alarms_card_icon_button_size"
                    android:layout_marginStart="@dimen/alarms_card_trailing_gap"
                    android:contentDescription="@string/alarms_delete"
                    app:icon="@drawable/alarms_ic_delete" />

                <FrameLayout
                    android:id="@+id/alarm_selection_indicator"
                    android:layout_width="@dimen/alarms_card_icon_button_size"
                    android:layout_height="@dimen/alarms_card_icon_button_size"
                    android:importantForAccessibility="no"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/alarm_selection_check"
                        android:layout_width="@dimen/alarms_card_icon_size"
                        android:layout_height="@dimen/alarms_card_icon_size"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/alarms_ic_selection_off" />
                </FrameLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Snooze/stop exist only while the server reports a live occurrence:
             an idle alarm row is just time, name, summary and the switch. -->
        <LinearLayout
            android:id="@+id/alarm_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/alarms_card_actions_gap"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_snooze"
                style="@style/Widget.Alarms.SnoozeButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/alarms_snooze" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarm_stop"
                style="@style/Widget.Alarms.StopButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:text="@string/alarms_stop" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
