<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Card clock: still the strongest element, sized for one dense row. -->
    <style name="TextAppearance.Alarms.CardTime" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Compact card actions: the snooze label ("Отложить на 9 мин") is long,
         so the default 24dp horizontal padding would push the row past one
         line at 360dp with a 1.15 font scale. -->
    <style name="Widget.Alarms.SnoozeButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="Widget.Alarms.StopButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <!-- The editor's time display is the primary control: large, quiet and
         tappable, not a filled button competing with Save. -->
    <style name="Widget.Alarms.TimeButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">96dp</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="Widget.Alarms.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Seven round day toggles on one row at 360dp. -->
    <style name="Widget.Alarms.DayChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:minWidth">38dp</item>
        <item name="android:minHeight">38dp</item>
        <item name="chipMinHeight">38dp</item>
        <item name="chipStartPadding">0dp</item>
        <item name="chipEndPadding">0dp</item>
        <item name="textStartPadding">0dp</item>
        <item name="textEndPadding">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.Alarms.Circle</item>
    </style>

    <style name="ShapeAppearanceOverlay.Alarms.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
</resources>
