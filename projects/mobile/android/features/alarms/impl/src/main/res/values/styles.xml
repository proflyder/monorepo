<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.Alarms.CardTime" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFeatureSettings">"tnum"</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Widget.Alarms.SnoozeButton" parent="Widget.Material3.Button.TonalButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="Widget.Alarms.CardIconButton" parent="Widget.Material3.Button.IconButton">
        <item name="android:minWidth">@dimen/alarms_card_icon_button_size</item>
        <item name="android:minHeight">@dimen/alarms_card_icon_button_size</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="iconSize">@dimen/alarms_card_icon_size</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">?attr/colorError</item>
        <item name="cornerRadius">24dp</item>
        <item name="rippleColor">@color/alarms_delete_ripple</item>
    </style>

    <style name="Widget.Alarms.StopButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">0dp</item>
    </style>
    <style name="Widget.Alarms.TimeButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:minHeight">96dp</item>
        <item name="android:textSize">48sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:gravity">center</item>
    </style>


    <style name="Widget.Alarms.DayToggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:checkable">true</item>
        <item name="android:textColor">@color/alarms_day_toggle_text</item>
        <item name="backgroundTint">@color/alarms_day_toggle_background</item>
        <item name="strokeColor">@color/alarms_day_toggle_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">22dp</item>
    </style>

    <style name="Widget.Alarms.SelectionAction" parent="Widget.Material3.Button.TextButton">
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:paddingRight">4dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:gravity">center</item>
        <item name="iconGravity">textTop</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">24dp</item>
    </style>
</resources>
