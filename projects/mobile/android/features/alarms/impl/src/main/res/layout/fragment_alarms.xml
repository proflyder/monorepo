<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="SelectableText"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/alarms_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/alarms_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="@dimen/alarms_screen_margin"
                android:paddingTop="12dp"
                android:paddingEnd="@dimen/alarms_screen_margin"
                android:paddingBottom="@dimen/ds_space_xl" />

            <ProgressBar
                android:id="@+id/alarms_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/alarms_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/alarms_empty"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/alarms_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/alarms_error_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <dev.proflyder.home.core.designsystem.ButtonRow
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ds_space_m"
                    app:autoEmphasis="true"
                    app:centered="true"
                    app:equalWidth="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/alarms_retry"
                        style="@style/Widget.Home.Button.Tonal.M"
                        android:layout_width="wrap_content"
                        android:text="@string/ds_action_retry" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/alarms_open_connection"
                        style="@style/Widget.Home.Button.Filled.M"
                        android:layout_width="wrap_content"
                        android:text="@string/ds_action_open_connection"
                        android:visibility="gone" />
                </dev.proflyder.home.core.designsystem.ButtonRow>
            </LinearLayout>

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/alarms_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/alarms_screen_margin"
                android:contentDescription="@string/alarms_add"
                android:text="@string/alarms_add"
                app:icon="@drawable/alarms_ic_add" />
        </FrameLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:id="@+id/alarms_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="?attr/colorSecondaryContainer"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/alarms_screen_margin"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarms_selection_close"
            style="@style/Widget.Home.IconButton.Standard.M"
            android:contentDescription="@string/alarms_selection_close"
            app:icon="@drawable/alarms_ic_close"
            app:iconTint="?attr/colorOnSecondaryContainer" />

        <TextView
            android:id="@+id/alarms_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSecondaryContainer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarms_selection_all"
            style="@style/Widget.Home.Button.Text.M"
            android:layout_width="wrap_content"
            android:text="@string/alarms_select_all"
            android:textColor="?attr/colorOnSecondaryContainer" />
    </LinearLayout>

    <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Home.Card"
        android:id="@+id/alarms_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarms_selection_enable"
                style="@style/Widget.Home.Button.BarAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/alarms_selection_enable"
                android:tooltipText="@string/alarms_selection_enable"
                app:icon="@drawable/alarms_ic_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarms_selection_disable"
                style="@style/Widget.Home.Button.BarAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/alarms_selection_disable"
                android:tooltipText="@string/alarms_selection_disable"
                app:icon="@drawable/alarms_ic_close" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarms_selection_delete"
                style="@style/Widget.Home.Button.BarAction"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="@string/ds_action_delete"
                android:textColor="?attr/colorError"
                android:tooltipText="@string/ds_action_delete"
                app:icon="@drawable/alarms_ic_delete"
                app:iconTint="?attr/colorError" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
