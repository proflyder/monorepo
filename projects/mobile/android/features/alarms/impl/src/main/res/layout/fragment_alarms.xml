<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Multi-select header: visible only while alarms are selected. -->
    <LinearLayout
        android:id="@+id/alarms_selection_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSecondaryContainer"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="@dimen/alarms_screen_margin"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarms_selection_close"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/alarms_selection_close"
            app:icon="@drawable/alarms_ic_close"
            app:iconTint="?attr/colorOnSecondaryContainer" />

        <TextView
            android:id="@+id/alarms_selection_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSecondaryContainer" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/alarms_selection_all"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/alarms_select_all"
            android:textColor="?attr/colorOnSecondaryContainer" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/alarms_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/alarms_screen_margin"
            android:paddingTop="12dp"
            android:paddingEnd="@dimen/alarms_screen_margin"
            android:paddingBottom="96dp" />

        <ProgressBar
            android:id="@+id/alarms_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/alarms_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/alarms_empty"
                android:textAppearance="?attr/textAppearanceBodyLarge" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/alarms_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/alarms_error_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarms_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/ui_retry" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarms_open_connection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:text="@string/alarms_open_connection"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/alarms_add"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="@dimen/alarms_screen_margin"
            android:contentDescription="@string/alarms_add"
            android:text="@string/alarms_add"
            app:icon="@drawable/alarms_ic_add" />
    </FrameLayout>

    <!-- Bulk actions: replace the FAB while alarms are selected. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/alarms_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="0dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/alarms_screen_margin"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/alarms_screen_margin"
            android:paddingBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarms_selection_enable"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/alarms_selection_enable"
                app:icon="@drawable/alarms_ic_check" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarms_selection_disable"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/alarms_selection_disable"
                app:icon="@drawable/alarms_ic_close" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alarms_selection_delete"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:text="@string/alarms_selection_delete"
                app:backgroundTint="?attr/colorError"
                app:icon="@drawable/alarms_ic_delete" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
