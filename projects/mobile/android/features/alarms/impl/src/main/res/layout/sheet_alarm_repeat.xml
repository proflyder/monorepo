<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheet_repeat"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/alarms_sheet_background"
    android:orientation="vertical"
    android:paddingStart="@dimen/alarms_sheet_padding"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/alarms_sheet_padding"
    android:paddingBottom="16dp">

    <View
        android:id="@+id/sheet_handle"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/alarms_sheet_handle" />

    <TextView
        android:id="@+id/sheet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/alarms_editor_repeat"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="?attr/colorOnSurface" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioGroup
                android:id="@+id/repeat_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/repeat_option_once"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/alarms_repeat_option_height"
                    android:text="@string/alarms_repeat_once"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/repeat_option_daily"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/alarms_repeat_option_height"
                    android:text="@string/alarms_repeat_daily"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/repeat_option_weekdays"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/alarms_repeat_option_height"
                    android:text="@string/alarms_repeat_weekdays"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/repeat_option_weekends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/alarms_repeat_option_height"
                    android:text="@string/alarms_repeat_weekends"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/repeat_option_custom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="@dimen/alarms_repeat_option_height"
                    android:text="@string/alarms_repeat_custom"
                    android:textAppearance="?attr/textAppearanceBodyLarge" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/repeat_days_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/alarms_editor_days"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alarms_day_toggle_size"
                        android:layout_weight="1">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/repeat_day_1"
                            style="@style/Widget.Alarms.DayToggle"
                            android:layout_width="@dimen/alarms_day_toggle_size"
                            android:layout_height="@dimen/alarms_day_toggle_size"
                            android:layout_gravity="center"
                            android:text="@string/alarms_day_mon" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alarms_day_toggle_size"
                        android:layout_weight="1">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/repeat_day_2"
                            style="@style/Widget.Alarms.DayToggle"
                            android:layout_width="@dimen/alarms_day_toggle_size"
                            android:layout_height="@dimen/alarms_day_toggle_size"
                            android:layout_gravity="center"
                            android:text="@string/alarms_day_tue" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alarms_day_toggle_size"
                        android:layout_weight="1">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/repeat_day_3"
                            style="@style/Widget.Alarms.DayToggle"
                            android:layout_width="@dimen/alarms_day_toggle_size"
                            android:layout_height="@dimen/alarms_day_toggle_size"
                            android:layout_gravity="center"
                            android:text="@string/alarms_day_wed" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alarms_day_toggle_size"
                        android:layout_weight="1">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/repeat_day_4"
                            style="@style/Widget.Alarms.DayToggle"
                            android:layout_width="@dimen/alarms_day_toggle_size"
                            android:layout_height="@dimen/alarms_day_toggle_size"
                            android:layout_gravity="center"
                            android:text="@string/alarms_day_thu" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alarms_day_toggle_size"
                        android:layout_weight="1">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/repeat_day_5"
                            style="@style/Widget.Alarms.DayToggle"
                            android:layout_width="@dimen/alarms_day_toggle_size"
                            android:layout_height="@dimen/alarms_day_toggle_size"
                            android:layout_gravity="center"
                            android:text="@string/alarms_day_fri" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alarms_day_toggle_size"
                        android:layout_weight="1">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/repeat_day_6"
                            style="@style/Widget.Alarms.DayToggle"
                            android:layout_width="@dimen/alarms_day_toggle_size"
                            android:layout_height="@dimen/alarms_day_toggle_size"
                            android:layout_gravity="center"
                            android:text="@string/alarms_day_sat" />
                    </FrameLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/alarms_day_toggle_size"
                        android:layout_weight="1">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/repeat_day_7"
                            style="@style/Widget.Alarms.DayToggle"
                            android:layout_width="@dimen/alarms_day_toggle_size"
                            android:layout_height="@dimen/alarms_day_toggle_size"
                            android:layout_gravity="center"
                            android:text="@string/alarms_day_sun" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/alarms_cancel"
            android:textAllCaps="false" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_done"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:text="@string/alarms_repeat_done"
            android:textAllCaps="false" />
    </LinearLayout>
</LinearLayout>
