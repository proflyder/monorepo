<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_session_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/chat_session_row_padding_horizontal"
    android:paddingTop="@dimen/chat_session_row_padding_vertical"
    android:paddingEnd="@dimen/chat_session_row_padding_horizontal"
    android:paddingBottom="@dimen/chat_session_row_padding_vertical"
    tools:ignore="SelectableText">

    <TextView
        android:id="@+id/chat_session_avatar"
        android:layout_width="@dimen/chat_session_avatar"
        android:layout_height="@dimen/chat_session_avatar"
        android:background="@drawable/ds_bg_tile_icon"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnPrimaryContainer"
        tools:text="Д" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chat_session_row_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chat_session_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Главный чат" />

            <TextView
                android:id="@+id/chat_session_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_s"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="12:40" />
        </LinearLayout>

        <TextView
            android:id="@+id/chat_session_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/ds_space_s"
            android:drawableTint="?attr/colorOnSurfaceVariant"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="Свет в гостиной включён." />
    </LinearLayout>
</LinearLayout>
