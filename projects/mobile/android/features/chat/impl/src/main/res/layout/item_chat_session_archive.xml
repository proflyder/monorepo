<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chat_archive_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/chat_session_row_padding"
    tools:ignore="SelectableText">

    <ImageView
        android:layout_width="@dimen/chat_session_avatar"
        android:layout_height="@dimen/chat_session_avatar"
        android:background="@drawable/ds_bg_tile_icon"
        android:importantForAccessibility="no"
        android:padding="@dimen/ds_space_m"
        android:src="@drawable/chat_ic_archive"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/chat_session_row_gap"
        android:layout_weight="1"
        android:text="@string/chat_session_archive_row"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/chat_archive_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <ImageView
        android:layout_width="@dimen/chat_session_meta_icon"
        android:layout_height="@dimen/chat_session_meta_icon"
        android:layout_marginStart="@dimen/ds_space_s"
        android:importantForAccessibility="no"
        android:src="@drawable/ds_ic_chevron"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
