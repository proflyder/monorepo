<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="SelectableText">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/chat_sessions_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chat_sessions_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/ds_space_l"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_chat_session" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/chat_sessions_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/chat_sessions_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/ds_space_xl"
        android:visibility="gone">

        <TextView
            android:id="@+id/chat_sessions_error_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/chat_sessions_retry"
            style="@style/Widget.Home.Button.Filled.M"
            android:layout_width="wrap_content"
            android:layout_marginTop="@dimen/ds_space_m"
            android:text="@string/ds_action_retry" />
    </LinearLayout>

    <TextView
        android:id="@+id/chat_sessions_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="@dimen/ds_space_xl"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/chat_sessions_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="@dimen/chat_session_search_margin">

        <dev.proflyder.home.core.designsystem.search.PullRevealSearch
            android:id="@+id/chat_sessions_search_reveal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/chat_sessions_search_layout"
                style="@style/Widget.Home.TextInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ds_space_l"
                android:layout_marginEnd="@dimen/ds_space_l"
                android:layout_marginBottom="@dimen/chat_session_search_margin"
                android:hint="@string/chat_session_search"
                app:startIconDrawable="@drawable/chat_ic_search">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/chat_sessions_search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </dev.proflyder.home.core.designsystem.search.PullRevealSearch>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/chat_sessions_new"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/ds_space_l"
        android:contentDescription="@string/chat_session_new"
        android:text="@string/chat_session_new"
        app:icon="@drawable/chat_ic_new" />
</FrameLayout>
