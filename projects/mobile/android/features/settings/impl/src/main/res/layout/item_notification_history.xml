<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        tools:ignore="SelectableText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/settings_row_padding"
        android:paddingTop="@dimen/settings_row_padding_vertical"
        android:paddingEnd="@dimen/settings_row_padding_chevron"
        android:paddingBottom="@dimen/settings_row_padding_vertical">

        <ImageView
            android:id="@+id/history_item_icon"
            android:layout_width="@dimen/settings_row_icon"
            android:layout_height="@dimen/settings_row_icon"
            android:src="@drawable/settings_ic_notify"
            android:importantForAccessibility="no"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/settings_row_icon_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/history_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Front door" />

            <TextView
                android:id="@+id/history_item_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="Someone is at the door" />

            <TextView
                android:id="@+id/history_item_time"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?attr/colorPrimary"
                tools:text="5 min ago" />
        </LinearLayout>

        <View
            android:id="@+id/history_item_unread"
            android:layout_width="@dimen/settings_history_unread_dot"
            android:layout_height="@dimen/settings_history_unread_dot"
            android:layout_marginStart="@dimen/ds_space_s"
            android:background="@drawable/settings_unread_dot"
            android:visibility="gone"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/history_item_chevron"
            android:layout_width="@dimen/settings_row_chevron"
            android:layout_height="@dimen/settings_row_chevron"
            android:layout_marginStart="@dimen/ds_space_s"
            android:importantForAccessibility="no"
            android:src="@drawable/settings_ic_chevron"
            android:visibility="gone"
            tools:visibility="visible" />
</LinearLayout>
