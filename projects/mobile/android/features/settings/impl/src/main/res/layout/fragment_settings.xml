<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ds_space_l"
        android:paddingTop="@dimen/ds_space_l"
        android:paddingEnd="@dimen/ds_space_l"
        android:paddingBottom="@dimen/ds_space_xl">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_intro"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_connection"
            style="@style/Widget.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_l"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/settings_row_padding"
                android:paddingTop="@dimen/settings_row_padding_vertical"
                android:paddingEnd="@dimen/settings_row_padding_chevron"
                android:paddingBottom="@dimen/settings_row_padding_vertical">

                <ImageView
                    android:layout_width="@dimen/settings_row_icon"
                    android:layout_height="@dimen/settings_row_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/settings_ic_connection" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_row_icon_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_connection_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_xs"
                        android:text="@string/settings_connection_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/settings_row_chevron"
                    android:layout_height="@dimen/settings_row_chevron"
                    android:importantForAccessibility="no"
                    android:src="@drawable/settings_ic_chevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_notifications"
            style="@style/Widget.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_s"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/settings_row_padding"
                android:paddingTop="@dimen/settings_row_padding_vertical"
                android:paddingEnd="@dimen/settings_row_padding_chevron"
                android:paddingBottom="@dimen/settings_row_padding_vertical">

                <ImageView
                    android:layout_width="@dimen/settings_row_icon"
                    android:layout_height="@dimen/settings_row_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/settings_ic_notifications" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_row_icon_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_notifications_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_xs"
                        android:text="@string/settings_notifications_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/settings_row_chevron"
                    android:layout_height="@dimen/settings_row_chevron"
                    android:importantForAccessibility="no"
                    android:src="@drawable/settings_ic_chevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_history"
            style="@style/Widget.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_s"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/settings_row_padding"
                android:paddingTop="@dimen/settings_row_padding_vertical"
                android:paddingEnd="@dimen/settings_row_padding_chevron"
                android:paddingBottom="@dimen/settings_row_padding_vertical">

                <ImageView
                    android:layout_width="@dimen/settings_row_icon"
                    android:layout_height="@dimen/settings_row_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/settings_ic_history" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_row_icon_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_history_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_xs"
                        android:text="@string/settings_history_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/settings_row_chevron"
                    android:layout_height="@dimen/settings_row_chevron"
                    android:importantForAccessibility="no"
                    android:src="@drawable/settings_ic_chevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_appearance"
            style="@style/Widget.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_s"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/settings_row_padding"
                android:paddingTop="@dimen/settings_row_padding_vertical"
                android:paddingEnd="@dimen/settings_row_padding_chevron"
                android:paddingBottom="@dimen/settings_row_padding_vertical">

                <ImageView
                    android:layout_width="@dimen/settings_row_icon"
                    android:layout_height="@dimen/settings_row_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/settings_ic_palette" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_row_icon_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_appearance_title"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_xs"
                        android:text="@string/settings_appearance_subtitle"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/settings_row_chevron"
                    android:layout_height="@dimen/settings_row_chevron"
                    android:importantForAccessibility="no"
                    android:src="@drawable/settings_ic_chevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/settings_design_system"
            style="@style/Widget.Home.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ds_space_s"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/settings_row_min_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/settings_row_padding"
                android:paddingTop="@dimen/settings_row_padding_vertical"
                android:paddingEnd="@dimen/settings_row_padding_chevron"
                android:paddingBottom="@dimen/settings_row_padding_vertical">

                <ImageView
                    android:layout_width="@dimen/settings_row_icon"
                    android:layout_height="@dimen/settings_row_icon"
                    android:importantForAccessibility="no"
                    android:src="@drawable/settings_ic_palette" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/settings_row_icon_gap"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ds_catalog_entry"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ds_space_xs"
                        android:text="@string/ds_catalog_entry_summary"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/settings_row_chevron"
                    android:layout_height="@dimen/settings_row_chevron"
                    android:importantForAccessibility="no"
                    android:src="@drawable/settings_ic_chevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
