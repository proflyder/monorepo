<?xml version="1.0" encoding="utf-8"?>
<!-- The local received-message log. The header row holds the count and the
     clear action; the body is either the list or the empty state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="SelectableText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/ui_screen_padding"
        android:paddingTop="@dimen/ui_tile_gap"
        android:paddingEnd="@dimen/ui_tile_gap"
        android:paddingBottom="@dimen/ui_tile_gap">

        <TextView
            android:id="@+id/history_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="12 saved" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/history_clear"
            style="@style/Widget.Home.DangerTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/history_clear" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/ui_screen_padding"
            android:paddingTop="@dimen/ui_tile_gap_half"
            android:paddingEnd="@dimen/ui_screen_padding"
            android:paddingBottom="@dimen/ui_section_gap" />

        <LinearLayout
            android:id="@+id/history_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/settings_empty_padding"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/settings_empty_icon"
                android:layout_height="@dimen/settings_empty_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/settings_ic_history_muted" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_screen_padding"
                android:gravity="center"
                android:text="@string/history_empty"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ui_tile_gap"
                android:gravity="center"
                android:text="@string/history_empty_hint"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
