<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Home.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ds_space_s"
    android:clickable="true"
    android:focusable="true"
    tools:ignore="SelectableText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="@dimen/settings_row_min_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/settings_row_padding_chevron"
        android:paddingTop="@dimen/settings_row_padding_vertical"
        android:paddingEnd="@dimen/settings_row_padding"
        android:paddingBottom="@dimen/settings_row_padding_vertical">

        <com.google.android.material.radiobutton.MaterialRadioButton
            android:id="@+id/appearance_theme_radio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:minWidth="0dp"
            android:minHeight="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/settings_row_icon_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/appearance_theme_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/appearance_theme_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ds_space_xs"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/settings_appearance_swatch_gap"
                android:orientation="horizontal">

                <View
                    android:id="@+id/appearance_swatch_1"
                    android:layout_width="@dimen/settings_appearance_swatch"
                    android:layout_height="@dimen/settings_appearance_swatch"
                    android:background="@drawable/settings_appearance_swatch" />

                <View
                    android:id="@+id/appearance_swatch_2"
                    android:layout_width="@dimen/settings_appearance_swatch"
                    android:layout_height="@dimen/settings_appearance_swatch"
                    android:layout_marginStart="@dimen/settings_appearance_swatch_gap"
                    android:background="@drawable/settings_appearance_swatch" />

                <View
                    android:id="@+id/appearance_swatch_3"
                    android:layout_width="@dimen/settings_appearance_swatch"
                    android:layout_height="@dimen/settings_appearance_swatch"
                    android:layout_marginStart="@dimen/settings_appearance_swatch_gap"
                    android:background="@drawable/settings_appearance_swatch" />

                <View
                    android:id="@+id/appearance_swatch_4"
                    android:layout_width="@dimen/settings_appearance_swatch"
                    android:layout_height="@dimen/settings_appearance_swatch"
                    android:layout_marginStart="@dimen/settings_appearance_swatch_gap"
                    android:background="@drawable/settings_appearance_swatch" />

                <View
                    android:id="@+id/appearance_swatch_5"
                    android:layout_width="@dimen/settings_appearance_swatch"
                    android:layout_height="@dimen/settings_appearance_swatch"
                    android:layout_marginStart="@dimen/settings_appearance_swatch_gap"
                    android:background="@drawable/settings_appearance_swatch" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
