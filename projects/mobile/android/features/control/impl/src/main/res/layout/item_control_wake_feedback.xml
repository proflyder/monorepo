<?xml version="1.0" encoding="utf-8"?>
<!-- Compact "Voice activator" section: two one-tap marks of a live wake event. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/ui_section_gap">

    <TextView
        android:id="@+id/control_wake_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/ui_tile_gap"
        android:text="@string/control_wake_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurface" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/control_wake_false_alarm"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ui_tile_gap_half"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:maxLines="2"
            android:gravity="center"
            tools:ignore="SelectableText"
            android:text="@string/control_wake_false_alarm" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/control_wake_missed"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ui_tile_gap_half"
            android:layout_weight="1"
            android:minHeight="64dp"
            android:maxLines="2"
            android:gravity="center"
            tools:ignore="SelectableText"
            android:text="@string/control_wake_missed" />
    </LinearLayout>
</LinearLayout>
