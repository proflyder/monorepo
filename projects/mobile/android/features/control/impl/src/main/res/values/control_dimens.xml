<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="control_screen_margin">@dimen/ui_screen_padding</dimen>
    <integer name="control_columns">2</integer>
    <integer name="control_device_columns">1</integer>
    <!-- Voice card: a compact row, not a second screen. -->
    <dimen name="control_voice_icon">40dp</dimen>
    <dimen name="control_voice_icon_padding">10dp</dimen>
    <dimen name="control_voice_row_min_height">48dp</dimen>
    <dimen name="control_voice_chip_height">32dp</dimen>
    <dimen name="control_voice_chip_padding">10dp</dimen>
    <dimen name="control_voice_chip_icon">18dp</dimen>
    <dimen name="control_voice_chip_icon_gap">6dp</dimen>
    <dimen name="control_voice_chip_gap">@dimen/ui_tile_gap</dimen>
    <!-- Quick action tile: icon + two-line label in a row, two per row. -->
    <dimen name="control_quick_tile_height">64dp</dimen>
    <!-- Rounded press area of a device-card row. The card pads its content by
         control_card_inset and each row adds control_row_bleed, so the content
         stays 16dp from the edge while the ripple reaches 8dp from it. -->
    <dimen name="control_row_corner">12dp</dimen>
    <dimen name="control_row_bleed">8dp</dimen>
    <dimen name="control_card_inset">8dp</dimen>
    <!-- Station volume sheet: icon button and the gap between its slider groups. -->
    <dimen name="control_volume_icon">40dp</dimen>
    <dimen name="control_volume_icon_padding">8dp</dimen>
    <dimen name="control_volume_group_gap">20dp</dimen>
    <!-- Compact binary toggles inside a device card: round icon and short label. -->
    <dimen name="control_tile_icon">48dp</dimen>
    <dimen name="control_tile_icon_padding">12dp</dimen>
    <dimen name="control_tile_progress">28dp</dimen>
    <dimen name="control_tile_label_gap">6dp</dimen>
    <dimen name="control_tile_row_gap">8dp</dimen>
    <integer name="control_tile_label_lines">2</integer>
    <integer name="control_tile_columns">4</integer>
    <integer name="control_speed_dial_scrim_ms">180</integer>
    <integer name="control_speed_dial_item_ms">220</integer>
    <integer name="control_speed_dial_stagger_ms">30</integer>
    <!-- Quick-actions FAB and its speed-dial column: the column sits above the
         FAB, its items are the same FAB component, labels are plain text. -->
    <dimen name="control_speed_dial_fab_margin">16dp</dimen>
    <dimen name="control_speed_dial_offset">88dp</dimen>
    <dimen name="control_speed_dial_item_gap">12dp</dimen>
    <dimen name="control_speed_dial_row_gap">8dp</dimen>
</resources>
