<?xml version="1.0" encoding="utf-8"?>
<!-- One quick action in the speed dial: icon and label, optional live state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/control_speed_dial_item_height"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="@dimen/control_speed_dial_item_padding"
    tools:ignore="SelectableText">

    <ImageView
        android:id="@+id/control_dial_icon"
        android:layout_width="@dimen/control_speed_dial_icon"
        android:layout_height="@dimen/control_speed_dial_icon"
        android:background="@drawable/control_bg_icon"
        android:importantForAccessibility="no"
        android:padding="@dimen/control_speed_dial_icon_padding" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/control_speed_dial_item_gap"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/control_dial_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/control_dial_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</LinearLayout>
