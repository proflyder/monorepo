<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Home.Card"
    tools:ignore="SelectableText"
    android:layout_width="0dp"
    android:layout_height="112dp"
    android:layout_margin="@dimen/ui_tile_gap_half"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="112dp">

    <!-- The icon keeps a fixed top area so every tile lines up; only the
         label is centred inside its own two-line box. -->
    <LinearLayout
        tools:ignore="UseCompoundDrawables"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/ui_tile_gap">

        <!-- The same active icon container as a smart-home device row. -->
        <FrameLayout
            android:id="@+id/quick_tile_icon_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/control_bg_icon">

            <ImageView
                android:id="@+id/quick_tile_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:tint="?attr/colorOnPrimaryContainer" />
        </FrameLayout>

        <TextView
            android:id="@+id/quick_tile_label"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/ui_tile_gap"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
