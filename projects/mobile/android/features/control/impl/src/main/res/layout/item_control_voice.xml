<?xml version="1.0" encoding="utf-8"?>
<!-- One compact voice card: the profile switch and the two wake marks. Rows
     are hidden independently; the whole card exists only when one of them is. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.Home.Card"
    tools:ignore="SelectableText"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="@dimen/ui_tile_gap"
        android:paddingEnd="16dp"
        android:paddingBottom="@dimen/ui_tile_gap">

        <!-- Profile row: icon + label, pills on the right. -->
        <LinearLayout
            android:id="@+id/control_voice_profile_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="@dimen/control_voice_row_min_height"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="@dimen/control_voice_icon"
                android:layout_height="@dimen/control_voice_icon">

                <ImageView
                    android:id="@+id/control_voice_profile_icon"
                    android:layout_width="@dimen/control_voice_icon"
                    android:layout_height="@dimen/control_voice_icon"
                    android:background="@drawable/control_bg_icon"
                    android:importantForAccessibility="no"
                    android:padding="@dimen/control_voice_icon_padding"
                    android:src="@drawable/control_ic_work"
                    app:tint="?attr/colorOnPrimaryContainer" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/control_voice_profile_progress"
                    android:layout_width="@dimen/control_voice_icon"
                    android:layout_height="@dimen/control_voice_icon"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorSize="@dimen/control_voice_chip_height" />
            </FrameLayout>

            <TextView
                android:id="@+id/control_voice_profile_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/control_voice_profile"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <!-- The same pill switch style as the Time sections. -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/control_voice_profile_tabs"
                style="@style/Widget.Home.PillTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ui_tile_gap" />
        </LinearLayout>

        <!-- Wake marks: two one-line chips, same height, same width. -->
        <LinearLayout
            android:id="@+id/control_voice_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="@dimen/ui_tile_gap">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/control_wake_false_alarm"
                style="@style/Widget.Control.VoiceChip"
                android:layout_width="0dp"
                android:layout_height="@dimen/control_voice_chip_height"
                android:layout_marginEnd="@dimen/control_voice_chip_gap"
                android:layout_weight="1"
                android:ellipsize="end"
                android:text="@string/control_wake_false_alarm"
                app:icon="@drawable/control_ic_ear_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/control_wake_missed"
                style="@style/Widget.Control.VoiceChip"
                android:layout_width="0dp"
                android:layout_height="@dimen/control_voice_chip_height"
                android:layout_weight="1"
                android:ellipsize="end"
                android:text="@string/control_wake_missed"
                app:icon="@drawable/control_ic_ear" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
