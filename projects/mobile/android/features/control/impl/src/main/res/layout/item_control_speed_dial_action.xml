<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingTop="@dimen/control_speed_dial_row_gap"
    android:paddingBottom="@dimen/control_speed_dial_row_gap"
    tools:ignore="SelectableText">

    <TextView
        android:id="@+id/control_dial_label"
        style="@style/Widget.Home.FabLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/control_speed_dial_item_gap"
        android:ellipsize="end"
        android:maxLines="1" />

    <dev.proflyder.home.core.ui.OutlinedFloatingActionButton
        android:id="@+id/control_dial_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:ensureMinTouchTargetSize="true"
        app:fabSize="normal"
        tools:ignore="ContentDescription" />
</LinearLayout>
