<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="dev.proflyder.home.feature.call.impl">

    <!-- Microphone is a runtime permission; the call screen asks for it before dialing. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Self-managed ConnectionService: normal permission, granted at install. -->
    <uses-permission android:name="android.permission.MANAGE_OWN_CALLS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />
    <!-- Bluetooth routes are hidden when this runtime permission is denied (API 31+). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- The ongoing-call notification is a runtime permission on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name="dev.proflyder.home.feature.call.telecom.HomeConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>

        <service
            android:name="dev.proflyder.home.feature.call.CallForegroundService"
            android:exported="false"
            android:foregroundServiceType="phoneCall" />

        <activity
            android:name="dev.proflyder.home.feature.call.presentation.CallActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            tools:targetApi="27" />
    </application>
</manifest>
