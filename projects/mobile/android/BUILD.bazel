load("//platform/android:defs.bzl", "home_android_lint", "home_detekt")

package(default_visibility = ["//visibility:public"])

# Targets whose sources are scanned by detekt. They mirror the
# projects/mobile/android entries of `android_tests`: main sources arrive via
# the app library's `deps`, test sources from these test targets.
DETEKT_TEST_TARGETS = [
    "//projects/mobile/android/app:main_activity_smoke_test",
    "//projects/mobile/android/core/config:config_test",
    "//projects/mobile/android/core/config:remote_connection_source_test",
    "//projects/mobile/android/core/model:model_test",
    "//projects/mobile/android/core/navigation:navigation_test",
    "//projects/mobile/android/core/network:network_test",
    "//projects/mobile/android/core/ui:motion_test",
    "//projects/mobile/android/features/alarms/api:api_test",
    "//projects/mobile/android/features/alarms/impl:editor_screenshot_test",
    "//projects/mobile/android/features/alarms/impl:selection_animation_test",
    "//projects/mobile/android/features/call/api:audio_routes_test",
    "//projects/mobile/android/features/call/api:call_state_test",
    "//projects/mobile/android/features/control/api:api_test",
    "//projects/mobile/android/features/control/impl:control_payload_test",
    "//projects/mobile/android/features/control/impl:profile_row_test",
    "//projects/mobile/android/features/control/impl:wake_feedback_row_test",
    "//projects/mobile/android/features/control/impl:speak_use_case_test",
    "//projects/mobile/android/features/reminders/api:api_test",
    "//projects/mobile/android/features/scenarios/api:api_test",
    "//projects/mobile/android/features/scenarios/impl:scenario_use_cases_test",
]

# Convenience entry points for the Android client.
alias(
    name = "app",
    actual = "//projects/mobile/android/app:app",
)

# Android Lint over every module reachable from the application library: the
# app module plus all core/feature API and implementation modules. Runs as its
# own CI unit (`android / android-lint`), with -Werror, so a finding fails that
# job without aborting the app's tests.
home_android_lint(
    name = "android_lint",
    app_module = "//projects/mobile/android/app:app_lib",
    config = "//projects/mobile/android:lint.xml",
    deps = ["//projects/mobile/android/app:app_lib"],
)

# detekt over the same graph: app main sources plus test sources. It runs as
# its own CI unit (`android / android-detekt`) next to Android Lint, so a style
# finding fails only that job.
home_detekt(
    name = "detekt",
    config = "//projects/mobile/android:detekt.yml",
    deps = ["//projects/mobile/android/app:app_lib"] + DETEKT_TEST_TARGETS,
    # Shared `packages/kotlin` code has its own gate; this unit owns the
    # Android client sources and tests only.
    source_prefix = "projects/mobile/android/",
)

# Unit tests only. `//projects/mobile/android:android_lint` is intentionally
# absent: it is a separate CI unit so its findings do not hide test results.
test_suite(
    name = "android_tests",
    tests = [
        "//packages/kotlin/core:core_test",
        "//packages/kotlin/core:operation_test",
        "//projects/mobile/android/app:apk_abi_test",
        "//projects/mobile/android/app:apk_manifest_test",
        "//projects/mobile/android/app:apk_runtime_closure_test",
        "//projects/mobile/android/core/config:config_test",
        "//projects/mobile/android/core/config:remote_connection_source_test",
        "//projects/mobile/android/core/model:model_test",
        "//projects/mobile/android/core/network:network_test",
        "//projects/mobile/android/core/ui:motion_test",
        "//projects/mobile/android/features/alarms/api:api_test",
        "//projects/mobile/android/features/alarms/impl:editor_screenshot_test",
        "//projects/mobile/android/features/alarms/impl:selection_animation_test",
        "//projects/mobile/android/features/call/api:audio_routes_test",
        "//projects/mobile/android/features/call/api:call_state_test",
        "//projects/mobile/android/features/control/api:api_test",
        "//projects/mobile/android/features/control/impl:control_payload_test",
        "//projects/mobile/android/features/control/impl:profile_row_test",
        "//projects/mobile/android/features/control/impl:wake_feedback_row_test",
        "//projects/mobile/android/features/control/impl:speak_use_case_test",
        "//projects/mobile/android/features/reminders/api:api_test",
        "//projects/mobile/android/features/scenarios/api:api_test",
        "//projects/mobile/android/features/scenarios/impl:scenario_use_cases_test",
        "//projects/mobile/android/app:main_activity_smoke_test",
        "//projects/mobile/android/core/navigation:navigation_test",
        # Bazel build tools live under platform/android and are routed to the
        # android platform by the units map; run their unit tests here so the
        # android unit exercises the toolchain it executes.
        "//platform/android/tools/apk_runtime_closure:apk_runtime_closure_test",
        "//platform/android/detekt-rules:detekt_rules_test",
        "//platform/android/tools/gen_view_binding:gen_view_binding_test",
        "//platform/android/tools/google_services:google_services_test",
        "//platform/android/tools/lint_runner:lint_runner_test",
    ],
)

exports_files([
    "README.md",
    "detekt.yml",
    "lint.xml",
    "maven_install.json",
])
