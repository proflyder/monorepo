load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

DELIVERED = [
    "automations.yaml",
    "command_line.yaml",
    "input_boolean.yaml",
    "input_datetime.yaml",
    "input_number.yaml",
    "input_select.yaml",
    "input_text.yaml",
    "intent_scripts.yaml",
    "rest_commands.yaml",
    "schedules_dashboard.yaml",
    "scripts.yaml",
    "shell_commands.yaml",
    "templates.yaml",
] + glob(["custom_sentences/ru/*.yaml"])

filegroup(
    name = "delivered",
    srcs = DELIVERED,
)

filegroup(
    name = "sync_manifest",
    srcs = ["sync.yaml"],
)

pkg_tar(
    name = "overlay",
    srcs = DELIVERED,
    mode = "0644",
    package_dir = "/opt/ha-voice",
    strip_prefix = ".",
)

pkg_tar(
    name = "manifest",
    files = {"sync.yaml": "ha-voice-sync.yaml"},
    mode = "0644",
    package_dir = "/opt",
)
