# Copy to .env and adjust when updating versions.
TZ=Asia/Almaty

# Pin versions for reproducible deploys. Update intentionally.
HA_IMAGE=ghcr.io/home-assistant/home-assistant:2026.10.4
MA_IMAGE=ghcr.io/music-assistant/server:2.10.8
MA_LOG_LEVEL=info

# Matter controller for HA. Keep the WebSocket on loopback; HA is host-network.
MATTER_SERVER_IMAGE=ghcr.io/matter-js/matterjs-server:stable
MATTER_PRIMARY_INTERFACE=wlp4s0
MATTER_LISTEN_ADDRESS=127.0.0.1

WHISPER_IMAGE=rhasspy/wyoming-whisper:3.8.1
WHISPER_MODEL=medium-int8
WHISPER_LANGUAGE=ru

PIPER_IMAGE=rhasspy/wyoming-piper:2.5.2
# Puriso on the deployed host: install model/config first; see ../tts/puriso/README.md
# PIPER_VOICE=ru_puriso2-medium
PIPER_VOICE=ru_RU-irina-medium

# Optional: local music directory mounted read-only into MA.
# MA_MEDIA_DIR=/mnt/music

# RU prompt to bias STT toward local commands (volume/Spotify/gateway).
WHISPER_PROMPT="Громкость 1, громкость 2, громкость 3, громкость 4, громкость 5, громкость 6, громкость 7, громкость 8, громкость 9, громкость 10. Включи любимое, Spotify Connect, Music Assistant, гейтвей, блютуз, пауза, продолжи музыку. Поставь будильник на 7:30, будильник на 8:00, на завтра, по будням, по выходным, каждый день, отмени будильник, отложи будильник, останови будильник. Поставь таймер на 5 минут, таймер на 10 минут. Стоп."

# Russian-specific local STT (GigaAM v3, ONNX, CPU)
ONNX_STT_IMAGE=lmo3/wyoming-onnx-stt:latest
ONNX_STT_MODEL=gigaam-v3-ctc
ONNX_STT_LANGUAGES=ru
ONNX_STT_LANGUAGE=ru
