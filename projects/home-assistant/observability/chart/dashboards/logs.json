{
  "uid": "ricardo-logs",
  "title": "Infrastructure / safe logs",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "ricardo",
    "git-managed"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Infrastructure logs (conversations excluded)",
      "type": "logs",
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"kube-system|monitoring\"}"
        }
      ],
      "options": {
        "showTime": true
      }
    }
  ]
}
