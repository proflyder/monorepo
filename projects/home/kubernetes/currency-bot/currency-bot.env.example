# Private deploy-time values for projects/home/kubernetes/currency-bot/deploy.sh.
# Copy to secrets/home/currency-bot.env (git-ignored) and fill real values.
#
# Public Cloudflare Tunnel host that routes /telegram/webhook to
# http://currency-bot-webhook.currency-bot.svc.cluster.local:8081.
# The tunnel hostname + service must also be configured in Cloudflare Zero Trust.
WEBHOOK_URL=https://currency-bot.example.com/telegram/webhook

# LAN range and K3s node address used by the NetworkPolicy to admit Traefik
# (hostNetwork) and kubelet probes to the bot's main listener.
LAN_CIDR=192.0.2.0/24
NODE_LAN_IP=192.0.2.27
