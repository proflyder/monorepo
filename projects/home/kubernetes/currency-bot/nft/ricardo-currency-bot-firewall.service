[Unit]
Description=Restrict currency-bot NodePort to the home LAN and pod network
After=network-online.target k3s.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/ricardo-currency-bot-nodeport.nft
ExecReload=/usr/sbin/nft -f /etc/ricardo-currency-bot-nodeport.nft

[Install]
WantedBy=multi-user.target
