load("//platform/bazel/oci:service_image.bzl", "rust_service_image", "service_image")

# Container images for the home scheduler stack.
#
# The scheduler, ha-bridge and ha-control are Rust crates rebuilt for static
# musl; the remaining service is a static linux/amd64 Go binary. Each image is one binary on top of a
# digest-pinned distroless base (MODULE.bazel `distroless_static`). There are
# no RUN steps and no package manager, so the images are assembled hermetically
# on any host (macOS workstation or the GitHub runner) and never need a Docker
# daemon to build. Runtime manifests reference images by digest, never by tag.

rust_service_image(
    name = "scheduler",
    crate_binary = "//solutions/scheduler/crates/scheduler:scheduler",
    repo = "ghcr.io/proflyder/scheduler",
)

rust_service_image(
    name = "ha-bridge",
    crate_binary = "//solutions/ha-bridge/crates/ha-bridge:ha-bridge",
    repo = "ghcr.io/proflyder/ha-bridge",
)

rust_service_image(
    name = "ha-control",
    crate_binary = "//solutions/ha-bridge/crates/ha-bridge:ha-control",
    repo = "ghcr.io/proflyder/ha-control",
)

# The cutover preflight Job runs the same `home-deploy` binary as the deploy
# scripts, so the cluster never needs a Python image. It is built from the Rust
# crate and promoted by the same DECISIONS 36 digest path as the three service
# images above. The binary is /usr/local/bin/home-deploy, exactly where the
# manifests and the Hermes smoke Job expect it.
rust_service_image(
    name = "home-deploy",
    crate_binary = "//platform/deploy-rs:home-deploy",
    repo = "ghcr.io/proflyder/home-deploy",
)

# Convenience alias for CI: one `bazel build` produces all images.
filegroup(
    name = "images",
    srcs = [
        ":ha-bridge_image",
        ":ha-control_image",
        ":home-deploy_image",
        ":scheduler_image",
    ],
    visibility = ["//visibility:public"],
)

# Templates rendered by the deploy scripts and the deployment tooling tests
# (platform/deploy/internal/render golden parity).
filegroup(
    name = "deploy_templates",
    srcs = glob([
        "manifests/*.yaml",
        "nft/*.nft",
    ]),
    visibility = ["//visibility:public"],
)
