load("//platform/bazel/oci:service_image.bzl", "rust_service_image")

rust_service_image(
    name = "scheduler",
    crate_binary = "//solutions/scheduler/crates/scheduler:scheduler",
    repo = "ghcr.io/proflyder/scheduler",
)

rust_service_image(
    name = "ha-bridge",
    crate_binary = "//solutions/ha-bridge/crates/ha-bridge:ha-bridge",
    repo = "ghcr.io/proflyder/ha-bridge",
)

rust_service_image(
    name = "ha-control",
    crate_binary = "//solutions/ha-bridge/crates/ha-bridge:ha-control",
    repo = "ghcr.io/proflyder/ha-control",
)

rust_service_image(
    name = "ha-scenario",
    crate_binary = "//solutions/ha-bridge/crates/ha-bridge:ha-scenario",
    repo = "ghcr.io/proflyder/ha-scenario",
)

rust_service_image(
    name = "home-deploy",
    crate_binary = "//platform/deploy-rs:home-deploy",
    repo = "ghcr.io/proflyder/home-deploy",
)

filegroup(
    name = "images",
    srcs = [
        ":ha-bridge_image",
        ":ha-control_image",
        ":ha-scenario_image",
        ":home-deploy_image",
        ":scheduler_image",
    ],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "deploy_templates",
    srcs = glob([
        "manifests/*.yaml",
        "nft/*.nft",
    ]),
    visibility = ["//visibility:public"],
)
