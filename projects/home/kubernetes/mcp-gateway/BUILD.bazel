# Plain-file package: the templates are rendered by the projects/home/kubernetes
# deploy scripts and by //platform/deploy (golden parity tests).
# The catalog and bb allow-list are validated by the real Rust validators in
# //solutions/mcp-gateway/crates/mcp-gateway:deploy_contract_tests, which consumes
# these templates as data.

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "deploy_templates",
    srcs = glob([
        "manifests/*.yaml",
    ]),
)
