# Plain-file package: the templates are rendered by the projects/home/kubernetes
# deploy scripts and by //platform/deploy (golden parity tests).
# catalog_contract_test.go builds the gateway with `go build` from the source
# tree, so it runs under `go test` in CI, not as a Bazel target.
# gazelle:exclude catalog_contract_test.go

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "deploy_templates",
    srcs = glob([
        "manifests/*.yaml",
    ]),
)
