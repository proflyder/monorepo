# Private values for projects/home/kubernetes/wakegrant.
#
# Copy to secrets/home/wakegrant.env (git-ignored) or let CI materialise it from
# OpenBao secret/ci/deploy-home key `wakegrant_env`.
#
# The LAN NodePort Home Assistant calls. 30098/30099 are the scheduler, 30100
# is currency-bot and 30300 is Grafana, so this service takes the next free
# block. Pick any unused 30000..32767 value on a different cluster.
WAKE_GRANT_NODE_PORT=30130
