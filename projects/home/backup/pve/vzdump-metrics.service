[Unit]
Description=Export Proxmox vzdump freshness to node-exporter textfile
After=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/default/vzdump-metrics
ExecStart=/usr/bin/python3 /usr/local/lib/vzdump-metrics/backup_metrics.py
Nice=10
IOSchedulingClass=idle
UMask=0022

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ReadWritePaths=/var/lib/prometheus/node-exporter
CapabilityBoundingSet=
AmbientCapabilities=
