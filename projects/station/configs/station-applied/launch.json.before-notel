{
  "nodes": [
    {
      "name": "main",
      "root": ".",
      "tasks": [
        {
          "name": "mediad",
          "delay": 5,
          "allowedRestartIntervalSeconds": 10,
          "root": ".",
          "path": "/system/vendor/quasar/maind",
          "arg": [
            "--mediad"
          ],
          "envs": [
            "MALLOC_ARENA_MAX=2",
            "CA_CERTIFICATES=/system/vendor/quasar/ca-certificates.crt"
          ],
          "order": 3,
          "log": false
        },
        {
          "name": "telemetry",
          "delay": 5,
          "allowedRestartIntervalSeconds": 600,
          "root": ".",
          "path": "/system/vendor/quasar/maind",
          "arg": [
            "--telemetry"
          ],
          "order": 0,
          "log": false
        },
        {
          "name": "maind",
          "delay": 5,
          "allowedRestartIntervalSeconds": 600,
          "root": ".",
          "path": "/system/vendor/quasar/maind",
          "arg": [
            "--platformd"
          ],
          "order": 1,
          "log": false
        },
        {
          "name": "fluent-bitd",
          "delay": 5,
          "allowedRestartIntervalSeconds": 600,
          "root": ".",
          "path": "/system/vendor/quasar/maind",
          "arg": [
            "--fluent-bitd"
          ],
          "order": 0,
          "log": false
        },
        {
          "name": "bulbik",
          "delay": 5,
          "allowedRestartIntervalSeconds": 600,
          "root": ".",
          "path": "/system/vendor/quasar/bulbik/bulbik",
          "arg": [
            "--addr",
            "localhost:9337"
          ],
          "loggerPath": "/system/vendor/quasar/maind",
          "loggerArgs": [
            "--loggerd",
            "bulbik"
          ],
          "order": 4,
          "log": false
        }
      ]
    }
  ]
}