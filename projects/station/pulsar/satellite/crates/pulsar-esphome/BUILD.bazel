load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

LINUX = ["@platforms//os:linux"]

DEPS = [
    "//projects/station/pulsar/satellite/crates/esphome-proto:esphome_proto",
    "//packages/rust/home-actor:home_actor",
    "//packages/rust/home-linux:home_linux",
    "@crates//:getrandom",
    "@crates//:libc",
    "@crates//:prost",
    "@crates//:thiserror",
    "@crates//:tracing",
    "@crates//:socket2",
    "@crates//:tokio",
    "//projects/station/pulsar/satellite/crates/pulsar-core:pulsar_core",
]

rust_library(
    name = "pulsar_esphome",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    compile_data = glob(["tests/golden/**"], allow_empty = True),
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS,
)


rust_test(
    name = "log_stream_test",
    srcs = ["tests/log_stream.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS + [":pulsar_esphome"],
)

rust_test(
    name = "pulsar_esphome_unit_tests",
    crate = ":pulsar_esphome",
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = ["@crates//:snow", "@crates//:tokio"],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
