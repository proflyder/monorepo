load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

LINUX = ["@platforms//os:linux"]

cc_library(
    name = "static_link_group",
    linkopts = ["-Wl,-Bstatic"],
)

DEPS = [
    "//packages/rust/home-actor:home_actor",
    "//packages/rust/home-proto:home_proto",
    "//packages/rust/home-secret:home_secret",
    "@crates//:connectrpc",
    "@crates//:futures-util",
    "@crates//:http",
    "@crates//:libc",
    "@crates//:reqwest",
    "@crates//:str0m",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tracing",
    "//projects/station/pulsar/satellite/crates/pulsar-core:pulsar_core",
    "//projects/station/pulsar/satellite/crates/pulsar-metrics:pulsar_metrics",
]

LINK_DEPS = [
    ":static_link_group",
    "@opus//:opus",
]

rust_library(
    name = "pulsar_call",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    link_deps = LINK_DEPS,
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS,
)

rust_test(
    name = "pulsar_call_unit_tests",
    crate = ":pulsar_call",
    edition = "2024",
    link_deps = LINK_DEPS,
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS,
)

extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
