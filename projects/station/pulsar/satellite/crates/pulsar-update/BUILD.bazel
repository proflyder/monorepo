load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

LINUX = ["@platforms//os:linux"]

DEPS = [
    "//packages/rust/ricardo-actor:ricardo_actor",
    "//packages/rust/ricardo-linux:ricardo_linux",
    "@crates//:libc",
    "@crates//:reqwest",
    "@crates//:ring",
    "@crates//:rustls",
    "@crates//:rustls-pki-types",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-rustls",
    "@crates//:tokio-util",
    "//projects/station/pulsar/satellite/crates/pulsar-core:pulsar_core",
]

# tests/data вшит в тестовый бинарь через include_str! (сертификаты локального сервера).
TEST_DATA = glob(["tests/data/**"])

rust_library(
    name = "pulsar_update",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    compile_data = glob(["tests/golden/**"], allow_empty = True) + TEST_DATA,
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS,
)

rust_binary(
    name = "update_probe",
    srcs = ["src/bin/update_probe.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS + [
        ":pulsar_update",
        "@crates//:clap",
    ],
)

# The integration test runs the update_probe binary at runtime. Cargo exports
# CARGO_BIN_EXE_<bin>; Bazel does not, so it is passed through `env` and the
# binary is a runfile.
rust_test(
    name = "update_probe_test",
    srcs = ["tests/update_probe.rs"],
    compile_data = glob(["tests/golden/**"], allow_empty = True),
    data = [":update_probe"],
    edition = "2024",
    lint_config = ":workspace_lints",
    env = {
        "CARGO_BIN_EXE_update_probe": "$(rootpath :update_probe)",
    },
    target_compatible_with = LINUX,
    deps = DEPS + [":pulsar_update"],
)

rust_test(
    name = "pulsar_update_unit_tests",
    crate = ":pulsar_update",
    compile_data = glob(["tests/golden/**"], allow_empty = True) + TEST_DATA,
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = ["@crates//:tokio"],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
