load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

LINUX = ["@platforms//os:linux"]

DEPS = [
    "//packages/rust/home-linux:home_linux",
    "//projects/station/pulsar/satellite/crates/pulsar-zbhci:pulsar_zbhci",
    "@crates//:libc",
    "@crates//:socket2",
    "@crates//:tokio",
    "@crates//:tokio-util",
    "@crates//:tracing",
]

rust_library(
    name = "pulsar_deconz",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    compile_data = glob(["tests/golden/**"], allow_empty = True),
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS,
)

rust_test(
    name = "pulsar_deconz_unit_tests",
    crate = ":pulsar_deconz",
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS,
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_test(
    name = "server_test",
    srcs = ["tests/server.rs"],
    compile_data = glob(["tests/golden/**"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS + [
        ":pulsar_deconz",
        "//projects/station/pulsar/satellite/crates/pulsar-zigbee:pulsar_zigbee",
    ],
)
