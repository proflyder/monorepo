load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Linux-only: the crate uses Linux syscalls/libc ABI. macOS `bazel build //...`
# skips it through target_compatible_with instead of failing.
LINUX = ["@platforms//os:linux"]

rust_library(
    name = "pulsar_core",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    compile_data = glob(["tests/golden/**"], allow_empty = True),
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = [
        "@crates//:libc",
        "@crates//:log",
        "@crates//:tokio",
    ],
)

# Unit tests: `crate` compiles the library sources with --test and inherits its
# deps/compile_data. Only dev-dependencies are added here.
rust_test(
    name = "pulsar_core_unit_tests",
    crate = ":pulsar_core",
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = ["@crates//:tokio"],
)

rust_test(
    name = "log_sink_test",
    srcs = ["tests/log_sink.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = [
        ":pulsar_core",
        "@crates//:libc",
        "@crates//:log",
        "@crates//:tokio",
    ],
)

rust_test(
    name = "own_target_test",
    srcs = ["tests/own_target.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = [
        ":pulsar_core",
        "@crates//:libc",
        "@crates//:log",
        "@crates//:tokio",
    ],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
