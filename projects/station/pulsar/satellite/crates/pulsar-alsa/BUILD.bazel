load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

LINUX = ["@platforms//os:linux"]

DEPS = [
    "//packages/rust/home-linux:home_linux",
    "@crates//:libc",
    "@crates//:libloading",
    "@crates//:tracing",
    "//projects/station/pulsar/satellite/crates/pulsar-core:pulsar_core",
    "//projects/station/pulsar/satellite/crates/pulsar-model:pulsar_model",
]

rust_library(
    name = "pulsar_alsa",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS,
)

rust_binary(
    name = "alsa_abi_probe",
    srcs = ["src/bin/alsa_abi_probe.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS + [":pulsar_alsa"],
)

rust_test(
    name = "pulsar_alsa_unit_tests",
    crate = ":pulsar_alsa",
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
