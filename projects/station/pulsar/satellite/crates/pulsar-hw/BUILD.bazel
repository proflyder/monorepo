load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

LINUX = ["@platforms//os:linux"]

DEPS = [
    "@pulsar_crates//:libc",
    "@pulsar_crates//:log",
    "@pulsar_crates//:tokio",
    "//projects/station/pulsar/satellite/crates/pulsar-clock:pulsar_clock",
    "//projects/station/pulsar/satellite/crates/pulsar-core:pulsar_core",
]

rust_library(
    name = "pulsar_hw",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    compile_data = glob(["tests/golden/**"], allow_empty = True),
    edition = "2024",
    target_compatible_with = LINUX,
    deps = DEPS,
)

rust_binary(
    name = "hw_probe",
    srcs = ["src/bin/hw_probe.rs"],
    edition = "2024",
    target_compatible_with = LINUX,
    deps = DEPS + [":pulsar_hw"],
)

rust_test(
    name = "pulsar_hw_unit_tests",
    crate = ":pulsar_hw",
    data = glob(["tests/golden/**"]),
    edition = "2024",
    env = {
        "PULSAR_MANIFEST_DIR": "projects/station/pulsar/satellite/crates/pulsar-hw",
    },
    target_compatible_with = LINUX,
    deps = ["@pulsar_crates//:tokio"],
)
