load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

LINUX = ["@platforms//os:linux"]

STATION = ["@zig_0_14_1//:station"]

DEPS = [
    "//packages/rust/home-linux:home_linux",
    "@crates//:libc",
    "@crates//:thiserror",
    "@crates//:tracing",
    "@crates//:tokio",
    "//projects/station/pulsar/satellite/crates/pulsar-alsa:pulsar_alsa",
    "//projects/station/pulsar/satellite/crates/pulsar-core:pulsar_core",
    "//projects/station/pulsar/satellite/crates/pulsar-model:pulsar_model",
    "//projects/station/pulsar/satellite/crates/pulsar-playback:pulsar_playback",
]

cargo_build_script(
    name = "pulsar_sendspin_build_script",
    srcs = ["build.rs"],
    data = glob(["shim/**"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = ["@crates//:cc"],
)

cc_library(
    name = "static_link_group",
    linkopts = ["-Wl,-Bstatic"],
)

cc_library(
    name = "sendspin_shim",
    srcs = ["shim/sendspin_shim.cpp"],
    hdrs = ["shim/sendspin_shim.h"],
    copts = ["-std=c++20"],
    linkopts = ["-lc++"],
    target_compatible_with = LINUX + STATION,
    deps = ["@sendspin_cpp//:sendspin_cpp"],
)

rust_library(
    name = "pulsar_sendspin",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    compile_data = glob(["tests/golden/**"], allow_empty = True),
    edition = "2024",
    lint_config = ":workspace_lints",
    rustc_flags = ["--check-cfg=cfg(test)", "--check-cfg=cfg(sendspin_ffi)"] + select({
        "@zig_0_14_1//:station": [
            "--cfg",
            "sendspin_ffi",
            "--check-cfg=cfg(sendspin_ffi)",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = LINUX,
    link_deps = select({
        "@zig_0_14_1//:station": [
            ":static_link_group",
            ":sendspin_shim",
        ],
        "//conditions:default": [],
    }),
    deps = DEPS + select({
        "@zig_0_14_1//:station": [],
        "//conditions:default": [":pulsar_sendspin_build_script"],
    }),
)


rust_test(
    name = "pulsar_sendspin_unit_tests",
    crate = ":pulsar_sendspin",
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = ["@crates//:tokio"],
)

extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
