load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

LINUX = ["@platforms//os:linux"]

DEPS = [
    "//packages/rust/home-actor:home_actor",
    "//packages/rust/home-linux:home_linux",
    "@crates//:socket2",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tracing",
    "//projects/station/pulsar/satellite/crates/pulsar-core:pulsar_core",
]

PROBE_DEPS = DEPS + [
    "@crates//:tracing-subscriber",
    "//projects/station/pulsar/satellite/crates/pulsar-mdns:pulsar_mdns",
]

rust_library(
    name = "pulsar_arbiter",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/bin/**"],
    ),
    compile_data = glob(["tests/golden/**"], allow_empty = True),
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = DEPS,
)

rust_binary(
    name = "lan_probe",
    srcs = ["src/bin/lan_probe.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = PROBE_DEPS + [":pulsar_arbiter"],
)

rust_test(
    name = "pulsar_arbiter_unit_tests",
    crate = ":pulsar_arbiter",
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = LINUX,
    deps = ["@crates//:tokio"],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
