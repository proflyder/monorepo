load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# Opus config.h is generated by micro-opus's CMake configure_file; the Bazel
# build keeps the generated file checked in (see opus/config.h) and exposes its
# directory on the include path.
cc_library(
    name = "opus_config",
    hdrs = ["opus/config.h"],
    includes = ["opus"],
)

# BUILD overlays consumed by http_archive's `build_file` in MODULE.bazel, and
# the micro-opus patch applied to the pinned Opus archive.
exports_files([
    "arduino_json.BUILD.bazel",
    "ixwebsocket.BUILD.bazel",
    "micro_flac.BUILD.bazel",
    "micro_ogg_demuxer.BUILD.bazel",
    "micro_opus.BUILD.bazel",
    "noise_c.BUILD.bazel",
    "opus.BUILD.bazel",
    "sendspin_cpp.BUILD.bazel",
    "opus/config.h",
    "patches/celt_stack_alloc.patch",
])
