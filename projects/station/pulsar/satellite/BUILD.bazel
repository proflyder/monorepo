load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")
load(":station_binary.bzl", "station_binary")

package(default_visibility = ["//visibility:public"])

# Cargo workspace manifest and lock are the source of truth for crate_universe
# (see MODULE.bazel). crate-universe.lock is the generated Bazel lock.
exports_files([
    "Cargo.lock",
    "Cargo.toml",
    "crate-universe.lock",
    "rust-toolchain.toml",
])

LINUX = ["@platforms//os:linux"]

# Every local Rust target: fmt/clippy run once for the whole workspace, like
# `cargo fmt --all` and `cargo clippy --workspace --all-targets`. External
# crates are not linted (transitive = False), matching cargo.
_CRATES = [
    "//projects/station/pulsar/satellite/crates/pulsar:pulsar",
    "//projects/station/pulsar/satellite/crates/pulsar:pulsar_unit_tests",
    "//projects/station/pulsar/satellite/crates/pulsar-alsa:pulsar_alsa",
    "//projects/station/pulsar/satellite/crates/pulsar-alsa:alsa_abi_probe",
    "//projects/station/pulsar/satellite/crates/pulsar-alsa:pulsar_alsa_unit_tests",
    "//projects/station/pulsar/satellite/crates/pulsar-audio:pulsar_audio",
    "//projects/station/pulsar/satellite/crates/pulsar-audio:frontend_probe",
    "//projects/station/pulsar/satellite/crates/pulsar-audio:ww_offline",
    "//projects/station/pulsar/satellite/crates/pulsar-audio:spectrum_golden_test",
    "//projects/station/pulsar/satellite/crates/pulsar-audio:pulsar_audio_unit_tests",
    "//projects/station/pulsar/satellite/crates/pulsar-clock:pulsar_clock",
    "//projects/station/pulsar/satellite/crates/pulsar-clock:pulsar_clock_unit_tests",
    "//projects/station/pulsar/satellite/crates/pulsar-core:pulsar_core",
    "//projects/station/pulsar/satellite/crates/pulsar-core:log_sink_test",
    "//projects/station/pulsar/satellite/crates/pulsar-core:own_target_test",
    "//projects/station/pulsar/satellite/crates/pulsar-core:pulsar_core_unit_tests",
    "//projects/station/pulsar/satellite/crates/pulsar-esphome:pulsar_esphome",
    "//projects/station/pulsar/satellite/crates/pulsar-esphome:api_selftest",
    "//projects/station/pulsar/satellite/crates/pulsar-esphome:log_stream_test",
    "//projects/station/pulsar/satellite/crates/pulsar-esphome:pulsar_esphome_unit_tests",
    "//projects/station/pulsar/satellite/crates/pulsar-hw:pulsar_hw",
    "//projects/station/pulsar/satellite/crates/pulsar-hw:hw_probe",
    "//projects/station/pulsar/satellite/crates/pulsar-hw:pulsar_hw_unit_tests",
    "//projects/station/pulsar/satellite/crates/pulsar-lan:pulsar_lan",
    "//projects/station/pulsar/satellite/crates/pulsar-lan:lan_probe",
