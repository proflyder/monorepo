rustfmt_test(
    name = "rustfmt",
    target_compatible_with = LINUX,
    targets = _CRATES,
)

# clippy fails on warnings by default (rules_rust turns every warning into an
# error unless capture_clippy_output is set), which is the `-D warnings` of
# `make check`.
rust_clippy_test(
    name = "clippy",
    target_compatible_with = LINUX,
    targets = _CRATES,
)

# Deployable station binary for the selected zig platform
# (`--platforms=//platform/bazel/zig:aarch64_linux` or `:armhf_linux`).
#
# The former Makefile kept a full unstripped copy as pulsar.debug and stripped the
# deployed binary; here pulsar.debug keeps only debug information and the
# stripped binary carries a .gnu_debuglink, so `addr2line -f -e pulsar.debug`
# still resolves the absolute (non-PIE) crash-report addresses.
station_binary(
    name = "station_binary",
    binary = "//projects/station/pulsar/satellite/crates/pulsar:pulsar",
    target_compatible_with = LINUX + ["@zig_0_14_1//:station"],
)
