load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "@crates//:hex",
    "@crates//:http",
    "@crates//:sha1",
    "@crates//:sha2",
    "@crates//:socket2",
    "@crates//:tempfile",
    "@crates//:thiserror",
    "@crates//:time",
    "@crates//:ureq",
    "@crates//:zip",
]

# Pure modules (scripts, detection, deploy plan) plus the adb/discover/console ports.
rust_library(
    name = "pulsar_installer",
    crate_name = "pulsar_installer",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    compile_data = ["testdata/usage.txt"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

# The binary keeps the installer's name; `crate_name` is the valid Rust identifier.
rust_binary(
    name = "pulsar-install",
    srcs = ["src/main.rs"],
    crate_name = "pulsar_install",
    edition = "2024",
    lint_config = ":workspace_lints",
    # The station triples add debuginfo to every aarch64 build; the installer is a
    # user-facing tool and does not need symbols or line tables.
    rustc_flags = [
        "-C",
        "debuginfo=0",
        "-C",
        "strip=symbols",
    ],
    deps = DEPS + [":pulsar_installer"],
)

# Golden fixtures generated from the Go installer before it was removed; the tests read
# them through include_str!/include_bytes!, so they are compile_data of this target.
rust_test(
    name = "unit_tests",
    crate = ":pulsar_installer",
    compile_data = glob(["testdata/**"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS + ["@crates//:serde_json"],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":pulsar_installer",
        ":pulsar-install",
    ],
)

rust_clippy_test(
    name = "clippy",
    targets = [
        ":pulsar_installer",
        ":pulsar-install",
    ],
)
