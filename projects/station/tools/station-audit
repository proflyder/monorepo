#!/usr/bin/env python3
"""Read-only reconciliation of the station against projects/station/manifest.yaml.

The station (Yandex Station Midi) runs more than the OTA-managed Pulsar binary:
BLE gateway, dropbear, egress guard, yandex-block, OTA fortress, rootkeeper and
a few config files were installed by hand. This tool answers "what is actually
installed and does it still match the repository?" without changing anything on
the device.

It opens one SSH connection and runs only read operations: `sha256sum`,
`ls`, and the `--version` of a few binaries. It never writes to the station,
never prints file contents and never prints secrets.

Usage:
    python3 projects/station/tools/station-audit
    mise run station:audit -- --ip 192.0.2.13
    python3 projects/station/tools/station-audit --json

Statuses:
    OK      installed state matches the repository
    DRIFT   present, but content/version differs
    MISSING expected path is absent on the device
    EXTRA   stale backup/candidate sibling (.bak/.prev/.new/...) next to a
            managed directory
"""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import json
import os
import pathlib
import re
import shlex
import subprocess
import sys
from dataclasses import dataclass, field

try:
    import yaml
except ImportError:  # pragma: no cover - reported as a clear usage error
    yaml = None

ROOT = pathlib.Path(__file__).resolve().parents[3]
DEFAULT_MANIFEST = ROOT / "projects" / "station" / "manifest.yaml"

COMPARE_MODES = {"sha256", "version", "presence"}
UPDATE_MODES = {"ota", "manual-rootfs", "firmware"}
NORMALIZERS = {"ipv4"}
_STATUS_ORDER = {"MISSING": 0, "DRIFT": 1, "EXTRA": 2, "OK": 3}
_IPV4_RE = re.compile(r"(?:[0-9]{1,3}\.){3}[0-9]{1,3}")
_IPV4_SED = "s/([0-9]{1,3}\\.){3}[0-9]{1,3}/<ip>/g"


class ManifestError(Exception):
    """The manifest is malformed or refers to a missing repository file."""


@dataclass
class Row:
    status: str
    component: str
    path: str
    detail: str


@dataclass
class Remote:
    """Parsed output of the single read-only SSH probe."""

    files: dict[str, tuple[str, str | None]] = field(default_factory=dict)
    versions: dict[int, str] = field(default_factory=dict)
    listings: dict[str, list[str]] = field(default_factory=dict)


# --------------------------------------------------------------------------
# Manifest


def load_manifest(path: pathlib.Path, repo_root: pathlib.Path = ROOT) -> dict:
    if yaml is None:
        raise ManifestError("PyYAML is required (python3 -m pip install -r requirements-test.txt)")
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        raise ManifestError(f"manifest not found: {path}") from None
    except yaml.YAMLError as error:
        raise ManifestError(f"manifest is not valid YAML: {error}") from None
    if not isinstance(data, dict):
        raise ManifestError("manifest root must be a mapping")
    validate_manifest(data, repo_root=repo_root)
    return data


def validate_manifest(data: dict, repo_root: pathlib.Path = ROOT) -> None:
    errors: list[str] = []
    if data.get("version") != 1:
        errors.append("version must be 1")
    audit = data.get("audit")
    if not isinstance(audit, dict):
        errors.append("audit must be a mapping")
        audit = {}
    for key in ("extra_dirs", "extra_patterns"):
        if not isinstance(audit.get(key, []), list):
            errors.append(f"audit.{key} must be a list")
    address = audit.get("address", {})
    if not isinstance(address, dict):
        errors.append("audit.address must be a mapping")
    components = data.get("components")
    if not isinstance(components, list) or not components:
        errors.append("components must be a non-empty list")
        components = []
    seen_ids: set[str] = set()
    for index, component in enumerate(components):
        where = f"components[{index}]"
        if not isinstance(component, dict):
            errors.append(f"{where} must be a mapping")
            continue
        cid = component.get("id")
        if not isinstance(cid, str) or not cid:
            errors.append(f"{where}.id must be a non-empty string")
        elif cid in seen_ids:
            errors.append(f"duplicate component id: {cid}")
        else:
            seen_ids.add(cid)
        for key in ("title", "purpose", "startup", "owner"):
            if not isinstance(component.get(key), str) or not component.get(key, "").strip():
                errors.append(f"{where}.{key} must be a non-empty string")
        if component.get("update") not in UPDATE_MODES:
            errors.append(f"{where}.update must be one of {sorted(UPDATE_MODES)}")
        if not isinstance(component.get("recovery"), bool):
            errors.append(f"{where}.recovery must be true or false")
        source = component.get("source")
        if not isinstance(source, dict) or not isinstance(source.get("path"), str):
            errors.append(f"{where}.source.path must be a string")
        elif not (repo_root / source["path"]).exists():
            errors.append(f"{where}.source.path does not exist: {source['path']}")
        files = component.get("files")
        if not isinstance(files, list) or not files:
            errors.append(f"{where}.files must be a non-empty list")
            continue
        for file_index, spec in enumerate(files):
            fwhere = f"{where}.files[{file_index}]"
            if not isinstance(spec, dict):
                errors.append(f"{fwhere} must be a mapping")
                continue
            device = spec.get("device")
            if not isinstance(device, str) or not device.startswith("/"):
                errors.append(f"{fwhere}.device must be an absolute path")
            if "\t" in str(device) or "\n" in str(device):
                errors.append(f"{fwhere}.device must not contain tabs or newlines")
            compare = spec.get("compare")
            if compare not in COMPARE_MODES:
                errors.append(f"{fwhere}.compare must be one of {sorted(COMPARE_MODES)}")
            if spec.get("normalize") is not None and spec.get("normalize") not in NORMALIZERS:
                errors.append(f"{fwhere}.normalize must be one of {sorted(NORMALIZERS)}")
            if spec.get("normalize") is not None and compare != "sha256":
                errors.append(f"{fwhere}.normalize is only valid with compare: sha256")
            if compare == "sha256":
                repo = spec.get("repo")
                if not isinstance(repo, str) or not repo:
                    errors.append(f"{fwhere}.repo is required for compare: sha256")
                elif not _safe_repo_file(repo_root, repo):
                    errors.append(f"{fwhere}.repo does not exist inside the repository: {repo}")
            if compare == "version":
                command = spec.get("version_command")
                if not isinstance(command, str) or not command.strip():
                    errors.append(f"{fwhere}.version_command is required for compare: version")
                expected = spec.get("expected")
                if not isinstance(expected, dict) or not isinstance(expected.get("repo"), str):
                    errors.append(f"{fwhere}.expected.repo is required for compare: version")
                elif not _safe_repo_file(repo_root, expected["repo"]):
                    errors.append(
                        f"{fwhere}.expected.repo does not exist inside the repository: "
                        f"{expected['repo']}"
                    )
                if isinstance(expected, dict) and expected.get("regex") is not None:
                    try:
                        re.compile(expected["regex"])
                    except re.error as error:
                        errors.append(f"{fwhere}.expected.regex is invalid: {error}")
    if errors:
        raise ManifestError("\n".join(errors))


def _safe_repo_file(repo_root: pathlib.Path, relative: str) -> bool:
    candidate = (repo_root / relative).resolve()
    try:
        candidate.relative_to(repo_root.resolve())
    except ValueError:
        return False
    return candidate.is_file()


# --------------------------------------------------------------------------
# Comparison helpers


def normalize_ipv4(text: str) -> str:
    """Mask IPv4 addresses so environment-specific LAN values do not drift."""
    return _IPV4_RE.sub("<ip>", text)


def repo_hash(repo_root: pathlib.Path, relative: str, normalize: str | None = None) -> str:
    data = (repo_root / relative).read_bytes()
    if normalize == "ipv4":
        data = normalize_ipv4(data.decode("utf-8", "surrogateescape")).encode(
            "utf-8", "surrogateescape"
        )
    return hashlib.sha256(data).hexdigest()


def expected_version(spec: dict, repo_root: pathlib.Path) -> str:
    expected = spec["expected"]
    text = (repo_root / expected["repo"]).read_text(encoding="utf-8")
    pattern = expected.get("regex")
    if pattern:
        match = re.search(pattern, text, re.MULTILINE)
        if not match:
            raise ManifestError(
                f"expected.regex did not match {expected['repo']}: {pattern}"
            )
        value = match.group(1)
    else:
        value = next((line.strip() for line in text.splitlines() if line.strip()), "")
    return str(expected.get("prefix", "")) + value


# --------------------------------------------------------------------------
# Remote probe


def _device_files(manifest: dict) -> list[tuple[str, str]]:
    """Unique (device path, normalizer) pairs in manifest order."""
    seen: set[str] = set()
    result: list[tuple[str, str]] = []
    for component in manifest["components"]:
        for spec in component["files"]:
            path = spec["device"]
            if path in seen:
                continue
            seen.add(path)
            result.append((path, str(spec.get("normalize") or "")))
    return result


def _version_commands(manifest: dict) -> list[str]:
    seen: set[str] = set()
    result: list[str] = []
    for component in manifest["components"]:
        for spec in component["files"]:
            if spec["compare"] != "version":
                continue
            command = spec["version_command"]
            if command in seen:
                continue
            seen.add(command)
            result.append(command)
    return result


def build_remote_script(manifest: dict) -> str:
    """One POSIX shell script: hashes, versions and directory listings."""
    lines = [
        "# station-audit: generated read-only probe",
        "set -u",
        "if ! command -v sha256sum >/dev/null 2>&1; then",
        "  echo 'X\tno-sha256sum'",
        "  exit 0",
        "fi",
    ]
    normal = [(path, norm) for path, norm in _device_files(manifest) if norm != "ipv4"]
    normalized = [(path, norm) for path, norm in _device_files(manifest) if norm == "ipv4"]
    if normal:
        joined = " ".join(shlex.quote(path) for path, _ in normal)
        lines += [
            f"for p in {joined}; do",
            '  if [ -f "$p" ]; then',
            "    h=$(sha256sum \"$p\" | cut -d' ' -f1)",
            "    printf 'F\\t%s\\t%s\\n' \"$p\" \"$h\"",
            '  elif [ -e "$p" ]; then',
            "    printf 'D\\t%s\\n' \"$p\"",
            "  else",
            "    printf 'M\\t%s\\n' \"$p\"",
            "  fi",
            "done",
        ]
    if normalized:
        joined = " ".join(shlex.quote(path) for path, _ in normalized)
        lines += [
            f"for p in {joined}; do",
            '  if [ -f "$p" ]; then',
            f"    h=$(sed -E {shlex.quote(_IPV4_SED)} \"$p\" | sha256sum | cut -d' ' -f1)",
            "    printf 'F\\t%s\\t%s\\n' \"$p\" \"$h\"",
            '  elif [ -e "$p" ]; then',
            "    printf 'D\\t%s\\n' \"$p\"",
            "  else",
            "    printf 'M\\t%s\\n' \"$p\"",
            "  fi",
            "done",
        ]
    for index, command in enumerate(_version_commands(manifest)):
        lines += [
            f"out=$(sh -c {shlex.quote(command)} 2>&1 | head -n 1 | tr '\\t' ' ')",
            f"printf 'V\\t{index}\\t%s\\n' \"$out\"",
        ]
    for directory in manifest.get("audit", {}).get("extra_dirs", []):
        lines += [
            f"printf 'L\\t%s\\n' {shlex.quote(directory)}",
            f"if [ -d {shlex.quote(directory)} ]; then",
            f"  ls -1A {shlex.quote(directory)} 2>/dev/null | while IFS= read -r n; do",
            "    printf 'E\\t%s\\n' \"$n\"",
            "  done",
            "fi",
        ]
    return "\n".join(lines) + "\n"


def parse_remote(text: str) -> Remote:
    remote = Remote()
    current_dir: str | None = None
    for line in text.splitlines():
        parts = line.split("\t")
        tag = parts[0]
        if tag == "F" and len(parts) >= 3:
            remote.files[parts[1]] = ("file", parts[2])
            current_dir = None
        elif tag == "D" and len(parts) >= 2:
            remote.files[parts[1]] = ("dir", None)
            current_dir = None
        elif tag == "M" and len(parts) >= 2:
            remote.files[parts[1]] = ("missing", None)
            current_dir = None
        elif tag == "V" and len(parts) >= 3:
            remote.versions[int(parts[1])] = parts[2]
            current_dir = None
        elif tag == "L" and len(parts) >= 2:
            current_dir = parts[1]
            remote.listings.setdefault(current_dir, [])
        elif tag == "E" and len(parts) >= 2 and current_dir is not None:
            remote.listings[current_dir].append(parts[1])
        elif tag == "X":
            raise ManifestError("station has no sha256sum")
    return remote


def run_ssh(ip: str, script: str, manifest: dict, ssh_key: str | None, timeout: int) -> str:
    audit = manifest.get("audit", {})
    key = ssh_key or os.path.expanduser(str(audit.get("ssh_key", "")))
    user = audit.get("ssh_user", "root")
    connect_timeout = int(audit.get("connect_timeout_s", 10))
    command = [
        "ssh",
        "-o",
        "BatchMode=yes",
        "-o",
        "StrictHostKeyChecking=accept-new",
        "-o",
        f"ConnectTimeout={connect_timeout}",
    ]
    if key:
        command += ["-i", key]
    command += [f"{user}@{ip}", "sh", "-s"]
    result = subprocess.run(
        command,
        input=script,
        text=True,
        capture_output=True,
        timeout=timeout,
    )
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip().splitlines()
        message = detail[-1] if detail else f"ssh exited {result.returncode}"
        raise ManifestError(f"ssh probe failed: {message}")
    return result.stdout


# --------------------------------------------------------------------------
# Evaluation and report


def resolve_address(
    explicit: str | None, manifest: dict, repo_root: pathlib.Path, env: dict | None = None
) -> str:
    env = os.environ if env is None else env
    if explicit:
        return explicit
    address = manifest.get("audit", {}).get("address", {})
    env_name = address.get("env", "STATION_IP")
    if env.get(env_name):
        return env[env_name]
    relative = address.get("file")
    if not relative:
        raise ManifestError("no --ip, no STATION_IP and no audit.address.file configured")
    path = repo_root / relative
    if not path.is_file():
        raise ManifestError(
            f"no station address: pass --ip, set {env_name} or restore {relative}"
        )
    hint = address.get("line_hint")
    for line in path.read_text(encoding="utf-8").splitlines():
        if hint and hint not in line:
            continue
        found = _IPV4_RE.search(line)
        if found:
            return found.group(0)
    raise ManifestError(f"no IPv4 address found for '{hint}' in {relative}; pass --ip")


def evaluate(manifest: dict, remote: Remote, repo_root: pathlib.Path = ROOT) -> list[Row]:
    rows: list[Row] = []
    version_index = {command: index for index, command in enumerate(_version_commands(manifest))}
    for component in manifest["components"]:
        cid = component["id"]
        for spec in component["files"]:
            device = spec["device"]
            state = remote.files.get(device, ("missing", None))
            if state[0] == "missing":
                rows.append(Row("MISSING", cid, device, "файла нет на устройстве"))
                continue
            if state[0] == "dir":
                rows.append(Row("DRIFT", cid, device, "ожидался файл, на устройстве каталог"))
                continue
            compare = spec["compare"]
            if compare == "presence":
                rows.append(Row("OK", cid, device, "присутствует"))
                continue
            if compare == "sha256":
                expected = repo_hash(repo_root, spec["repo"], spec.get("normalize"))
                actual = state[1] or ""
                if expected == actual:
                    rows.append(Row("OK", cid, device, "sha256 совпадает"))
                else:
                    rows.append(
                        Row(
                            "DRIFT",
                            cid,
                            device,
                            f"sha256 отличается: repo {expected[:12]}…, device {actual[:12]}…",
                        )
                    )
                continue
            want = expected_version(spec, repo_root)
            actual_version = remote.versions.get(version_index[spec["version_command"]], "")
            if want == actual_version:
                rows.append(Row("OK", cid, device, f"build artifact, версия {actual_version}"))
            else:
                rows.append(
                    Row(
                        "DRIFT",
                        cid,
                        device,
                        f"версия: ожидается {want}, на устройстве "
                        f"{actual_version or '<нет вывода>'}",
                    )
                )
    rows.extend(_extras(manifest, remote))
    rows.sort(key=lambda row: (_STATUS_ORDER[row.status], row.component, row.path))
    return rows


def _extras(manifest: dict, remote: Remote) -> list[Row]:
    audit = manifest.get("audit", {})
    patterns = audit.get("extra_patterns", [])
    if not patterns:
        return []
    roots = [
        (component["id"], component.get("device_root", ""))
        for component in manifest["components"]
    ]
    rows: list[Row] = []
    for directory in audit.get("extra_dirs", []):
        owner = ""
        best = -1
        for cid, root in roots:
            if root and (directory == root or directory.startswith(root.rstrip("/") + "/")):
                if len(root) > best:
                    best = len(root)
                    owner = cid
        for name in remote.listings.get(directory, []):
            if not any(fnmatch.fnmatch(name, pattern) for pattern in patterns):
                continue
            rows.append(
                Row(
                    "EXTRA",
                    owner or "-",
                    f"{directory.rstrip('/')}/{name}",
                    "лишний backup/кандидат рядом с управляемыми файлами",
                )
            )
    return rows


def summarize(rows: list[Row]) -> dict[str, int]:
    counts = {status: 0 for status in ("OK", "DRIFT", "MISSING", "EXTRA")}
    for row in rows:
        counts[row.status] += 1
    return counts


def format_report(rows: list[Row], counts: dict[str, int], components: int) -> str:
    header = ("STATUS", "COMPONENT", "PATH", "DETAIL")
    table = [header]
    for row in rows:
        table.append((row.status, row.component, row.path, row.detail))
    widths = [max(len(line[column]) for line in table) for column in range(3)]
    lines = []
    for index, line in enumerate(table):
        cells = [
            line[column].ljust(widths[column]) for column in range(3)
        ]
        lines.append("  ".join(cells + [line[3]]).rstrip())
        if index == 0:
            lines.append("  ".join("-" * width for width in widths) + "  " + "-" * 4)
    lines.append("")
    lines.append(
        "Итого: {OK} OK, {DRIFT} DRIFT, {MISSING} MISSING, {EXTRA} EXTRA "
        "({components} компонентов, {files} файлов)".format(
            components=components,
            files=len(rows) - counts["EXTRA"],
            **counts,
        )
    )
    return "\n".join(lines)


def to_json(rows: list[Row], counts: dict[str, int], components: int) -> str:
    return json.dumps(
        {
            "components": components,
            "summary": counts,
            "rows": [row.__dict__ for row in rows],
        },
        ensure_ascii=False,
        indent=2,
    )


def failing_statuses(mode: str) -> set[str]:
    if mode == "none":
        return set()
    if mode == "missing":
        return {"MISSING"}
    if mode == "drift":
        return {"DRIFT", "MISSING"}
    return {"DRIFT", "MISSING", "EXTRA"}


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Сверка состава ПО колонки с projects/station/manifest.yaml (только чтение)"
    )
    parser.add_argument("--ip", help="адрес станции; иначе STATION_IP или secrets/NETWORK.md")
    parser.add_argument("--manifest", type=pathlib.Path, default=DEFAULT_MANIFEST)
    parser.add_argument("--repo-root", type=pathlib.Path, default=ROOT)
    parser.add_argument("--ssh-key", help="путь к ключу (по умолчанию из манифеста)")
    parser.add_argument("--timeout", type=int, default=120, help="таймаут SSH, секунды")
    parser.add_argument("--json", action="store_true", help="машинный вывод")
    parser.add_argument(
        "--fail-on",
        choices=("none", "missing", "drift", "any"),
        default="missing",
        help="код возврата 1 при найденном статусе (по умолчанию: только MISSING)",
    )
    args = parser.parse_args(argv)
    try:
        manifest = load_manifest(args.manifest, repo_root=args.repo_root)
        ip = resolve_address(args.ip, manifest, args.repo_root)
        script = build_remote_script(manifest)
        remote = parse_remote(run_ssh(ip, script, manifest, args.ssh_key, args.timeout))
        rows = evaluate(manifest, remote, repo_root=args.repo_root)
        counts = summarize(rows)
    except (ManifestError, subprocess.TimeoutExpired) as error:
        print(f"station-audit: {error}", file=sys.stderr)
        return 2
    if args.json:
        print(to_json(rows, counts, len(manifest["components"])))
    else:
        print(format_report(rows, counts, len(manifest["components"])))
    failed = any(counts[status] for status in failing_statuses(args.fail_on))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
