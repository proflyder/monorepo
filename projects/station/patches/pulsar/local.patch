+  int32_t (*num_dims)(P) = nullptr;
+  int32_t (*dim)(P, int32_t) = nullptr;
+  int (*type)(P) = nullptr;
+  size_t (*bytes)(P) = nullptr;
+  Quantization (*quant)(P) = nullptr;
+  int (*copy_in)(P, const void *, size_t) = nullptr;
+  int (*copy_out)(P, void *, size_t) = nullptr;
+  int (*invoke)(P) = nullptr;
+  FrontendState fe{};
+  bool fe_ready = false, ready = false;
+  std::array<int8_t, 120> features{};
+  std::array<float, kWindow> probs{};
+  size_t filled = 0, count = 0, pos = 0;
+  int warmup = 100;
+  Quantization iq{}, oq{};
+
+  template<class F> bool bind(F &f, const char *name) {
+    f = reinterpret_cast<F>(dlsym(lib, name));
+    if (!f) LOGE("microWakeWord: missing %s", name);
+    return f != nullptr;
+  }
+  bool open(const std::string &path) {
+    lib = dlopen("/system/vendor/quasar/libs/libtflite.so", RTLD_NOW | RTLD_GLOBAL);
+    if (!lib) { LOGE("microWakeWord: %s", dlerror()); return false; }
+#define B(member, symbol) if (!bind(member, symbol)) return false
+    B(model_create, "TfLiteModelCreateFromFile");
+    B(model_delete, "TfLiteModelDelete");
+    B(options_create, "TfLiteInterpreterOptionsCreate");
+    B(options_threads, "TfLiteInterpreterOptionsSetNumThreads");
+    B(options_delete, "TfLiteInterpreterOptionsDelete");
+    B(resolver_create, "TfLiteCustomOpResolverCreate");
+    B(interpreter_create, "TfLiteInterpreterCreateWithCustomResolver");
+    B(interpreter_delete, "TfLiteInterpreterDelete");
+    B(allocate, "TfLiteInterpreterAllocateTensors");
+    B(input, "TfLiteInterpreterGetInputTensor");
+    B(output, "TfLiteInterpreterGetOutputTensor");
+    B(num_dims, "TfLiteTensorNumDims"); B(dim, "TfLiteTensorDim");
+    B(type, "TfLiteTensorType"); B(bytes, "TfLiteTensorByteSize");
+    B(quant, "TfLiteTensorQuantizationParams");
+    B(copy_in, "TfLiteTensorCopyFromBuffer"); B(copy_out, "TfLiteTensorCopyToBuffer");
+    B(invoke, "TfLiteInterpreterInvoke");
+#undef B
+    model = model_create(path.c_str());
+    // Yandex's default interpreter resolver crashes; its named FULL resolver is required.
+    static P full_resolver = nullptr;
+    if (!full_resolver) full_resolver = resolver_create("FULL");
+    resolver = full_resolver;
+    if (!model || !resolver) { LOGE("microWakeWord: model or FULL resolver unavailable"); return false; }
+    FrontendConfig cfg{};
+    FrontendFillConfigWithDefaults(&cfg);
+    cfg.window.size_ms = 30; cfg.window.step_size_ms = 10;
+    cfg.filterbank.num_channels = 40;
+    cfg.filterbank.lower_band_limit = 125; cfg.filterbank.upper_band_limit = 7500;
+    cfg.noise_reduction.smoothing_bits = 10;
+    cfg.noise_reduction.even_smoothing = 0.025f;
+    cfg.noise_reduction.odd_smoothing = 0.06f;
+    cfg.noise_reduction.min_signal_remaining = 0.05f;
+    cfg.pcan_gain_control.enable_pcan = 1;
+    cfg.pcan_gain_control.strength = 0.95f;
+    cfg.pcan_gain_control.offset = 80; cfg.pcan_gain_control.gain_bits = 21;
+    cfg.log_scale.enable_log = 1; cfg.log_scale.scale_shift = 6;
+    if (!FrontendPopulateState(&cfg, &fe, 16000)) return false;
+    fe_ready = true;
+    if (!reset()) return false;
+    LOGI("microWakeWord: loaded %s (int8 [1,3,40], cutoff=%.2f, window=%zu)",
+         path.c_str(), kCutoff, kWindow);
+    return true;
+  }
+  bool reset() {
+    ready = false;
+    if (interpreter) interpreter_delete(interpreter);
+    interpreter = nullptr;
+    P options = options_create();
+    if (!options) return false;
+    options_threads(options, 1);
+    interpreter = interpreter_create(model, resolver, options);
+    options_delete(options);
+    if (!interpreter || allocate(interpreter) != 0) {
+      LOGE("microWakeWord: interpreter creation/allocation failed"); return false;
+    }
+    P in = input(interpreter, 0), out = output(interpreter, 0);
+    if (!in || !out || num_dims(in) != 3 || dim(in, 0) != 1 || dim(in, 1) != 3 || dim(in, 2) != 40 ||
+        type(in) != 9 || type(out) != 3 || bytes(in) != features.size() || bytes(out) != 1) {
+      LOGE("microWakeWord: expected int8 [1,3,40] -> uint8 [1,1]"); return false;
+    }
+    iq = quant(in); oq = quant(out);
+    if (!(iq.scale > 0) || !(oq.scale > 0)) return false;
+    FrontendReset(&fe);
+    filled = count = pos = 0; warmup = 100;
+    probs.fill(0);
+    ready = true;
+    return true;
+  }
+  ~Impl() {
+    if (interpreter && interpreter_delete) interpreter_delete(interpreter);
+    if (model && model_delete) model_delete(model);
+    if (fe_ready) FrontendFreeStateContents(&fe);
+    // Keep the named resolver and library loaded for the firmware's other users.
+  }
+};
+
+MicroWakeWord::MicroWakeWord() = default;
+MicroWakeWord::~MicroWakeWord() = default;
+bool MicroWakeWord::load(const std::string &path) {
+  impl_ = std::make_unique<Impl>();
+  return impl_->open(path);
+}
+bool MicroWakeWord::ok() const { return impl_ && impl_->ready; }
+bool MicroWakeWord::reset() { return impl_ && impl_->reset(); }
+
+bool MicroWakeWord::feed(const int16_t *pcm, size_t samples, float &score) {
+  score = -1;
+  if (!ok()) return false;
+  auto &e = *impl_;
+  bool hit = false;
+  while (samples) {
+    size_t consumed = 0;
+    auto frame = FrontendProcessSamples(&e.fe, pcm, samples, &consumed);
+    pcm += consumed; samples -= consumed;
+    if (frame.size == 40) {
+      for (size_t i = 0; i < 40; ++i) {
+        // pymicro_features uses the microfrontend's fixed-point output * 0.0390625.
+        long q = std::lrint(frame.values[i] * 0.0390625f / e.iq.scale) + e.iq.zero;
+        e.features[e.filled * 40 + i] = int8_t(std::clamp(q, -128L, 127L));
+      }
+      if (++e.filled == 3) {
+        e.filled = 0;
+        uint8_t result = 0;
+        if (e.copy_in(e.input(e.interpreter, 0), e.features.data(), e.features.size()) != 0 ||
+            e.invoke(e.interpreter) != 0 || e.copy_out(e.output(e.interpreter, 0), &result, 1) != 0) {
+          LOGE("microWakeWord: inference failed"); e.ready = false; return false;
+        }
+        e.probs[e.pos++ % kWindow] = (int(result) - e.oq.zero) * e.oq.scale;
+        e.count = std::min(e.count + 1, kWindow);
+        if (e.warmup > 0) { e.warmup -= 3; continue; }
+        if (e.count == kWindow) {
+          float mean = 0;
+          for (float p : e.probs) mean += p / kWindow;
+          score = std::max(score, mean);
+          hit = hit || mean >= kCutoff;
+        }
+      }
+    }
+    if (!consumed) break;
+  }
+  if (hit) e.reset();  // fresh streaming variables, gain estimates and a 1 s warm-up
+  return hit;
+}
+}  // namespace cs
