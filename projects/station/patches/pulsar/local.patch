diff --git a/satellite/tools/mww_probe.cpp b/satellite/tools/mww_probe.cpp
new file mode 100644
index 0000000..8744ef2
--- /dev/null
+++ b/satellite/tools/mww_probe.cpp
@@ -0,0 +1,52 @@
+// Offline runtime/frontend check. Does not open microphones or the ESPHome API.
+#include "audio/microwakeword.h"
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <vector>
+
+static unsigned u16(const unsigned char *p) { return p[0] | unsigned(p[1]) << 8; }
+static unsigned u32(const unsigned char *p) { return u16(p) | u16(p+2) << 16; }
+int main(int argc, char **argv) {
+  if (argc < 2) { std::fprintf(stderr, "usage: mww_probe model.tflite [16k-mono.wav]\n"); return 2; }
+  cs::MicroWakeWord wake;
+  if (!wake.load(argv[1])) return 1;
+  std::vector<int16_t> audio(32000, 0);  // warm up with 2 s of silence
+  float best = -1, score;
+  unsigned hits = 0;
+  auto feed = [&](const std::vector<int16_t> &pcm) {
+    for (size_t i = 0; i < pcm.size(); i += 512) {
+      if (wake.feed(pcm.data()+i, std::min<size_t>(512, pcm.size()-i), score)) ++hits;
+      best = std::max(best, score);
+      if (!wake.ok()) return false;
+    }
+    return true;
+  };
+  if (!feed(audio)) return 1;
+  if (argc > 2) {
+    std::ifstream in(argv[2], std::ios::binary);
+    std::vector<unsigned char> wav{std::istreambuf_iterator<char>(in), {}};
+    if (wav.size() < 12 || std::memcmp(wav.data(), "RIFF", 4) || std::memcmp(wav.data()+8, "WAVE", 4)) return 2;
+    bool format = false, data = false;
+    for (size_t i = 12; i+8 <= wav.size();) {
+      size_t n = u32(wav.data()+i+4);
+      if (n > wav.size()-i-8) return 2;
+      if (!std::memcmp(wav.data()+i, "fmt ", 4) && n >= 16)
+        format = u16(wav.data()+i+8)==1 && u16(wav.data()+i+10)==1 &&
+                 u32(wav.data()+i+12)==16000 && u16(wav.data()+i+22)==16;
+      if (!std::memcmp(wav.data()+i, "data", 4)) {
+        audio.resize(n/2);
+        for (size_t j=0; j<audio.size(); ++j) audio[j]=int16_t(u16(wav.data()+i+8+j*2));
+        data = true;
+      }
+      i += 8+n+(n&1);
+    }
+    if (!format || !data || !feed(audio)) return 2;
+    audio.assign(16000, 0);
+    if (!feed(audio)) return 1;
+  }
+  std::printf("mww_probe OK hits=%u max_probability=%.6f\n", hits, best);
+  return 0;
+}
