new file mode 100644
index 0000000..7475723
--- /dev/null
+++ b/satellite/src/audio/microwakeword.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace cs {
+// Owns the model's streaming state. Use only from the audio processing thread.
+class MicroWakeWord {
+ public:
+  MicroWakeWord();
+  ~MicroWakeWord();
+  bool load(const std::string &path);
+  bool reset();
+  // Returns a detection; score is the highest smoothed probability in this block.
+  bool feed(const int16_t *pcm, size_t samples, float &score);
+  bool ok() const;
+ private:
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+}  // namespace cs
