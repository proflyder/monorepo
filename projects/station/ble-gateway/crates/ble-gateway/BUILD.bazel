load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_library", "rust_test")
load("//projects/station/ble-gateway:version.bzl", "ble_gateway_version_env")

package(default_visibility = ["//visibility:public"])

# Kept in sync with [package].version in Cargo.toml. Bazel does not read the
# Cargo manifest; the `version` attribute injects env!("CARGO_PKG_VERSION").
# Without it `ble-gateway --version` prints 0.0.0 (see docs/STATION-SOFTWARE.md).
PACKAGE_VERSION = "0.2.0"

# Optional `--define=ble_gateway_git_rev=<rev>`; the binary logs it at startup.
ble_gateway_version_env(name = "version_env")

DEPS = [
    "@crates//:anyhow",
    "@crates//:axum",
    "@crates//:clap",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-util",
    "@crates//:tracing",
    "@crates//:zbus",
    "//packages/rust/home-http:home_http",
    "//packages/rust/home-runtime:home_runtime",
    "//packages/rust/home-secret:home_secret",
]

rust_library(
    name = "ble_gateway",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/bin/**",
            "src/main.rs",
        ],
    ),
    edition = "2024",
    lint_config = ":workspace_lints",
    # `src/cli.rs` asserts the injected CARGO_PKG_VERSION against this file.
    compile_data = ["Cargo.toml"],
    version = PACKAGE_VERSION,
    deps = DEPS,
)

# The deployed armhf binary is size-optimised (fat LTO, one codegen unit,
# abort on panic) and stripped; host builds stay unoptimised with debug info.
rust_binary(
    name = "ble-gateway",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    rustc_env_files = [":version_env"],
    version = PACKAGE_VERSION,
    rustc_flags = select({
        "@zig_0_14_1//:station": [
            "-C",
            "opt-level=s",
            "-C",
            "lto=fat",
            "-C",
            "codegen-units=1",
            "-C",
            "panic=abort",
            "-C",
            "strip=symbols",
        ],
        "//conditions:default": [],
    }),
    deps = DEPS + [
        ":ble_gateway",
        "//packages/rust/home-telemetry:home_telemetry",
    ],
)

rust_binary(
    name = "bletest",
    srcs = ["src/bin/bletest.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    version = PACKAGE_VERSION,
    deps = [
        ":ble_gateway",
        "@crates//:anyhow",
        "@crates//:clap",
    "@crates//:serde",
    "@crates//:serde_json",
        "@crates//:tokio",
        "@crates//:zbus",
    ],
)

rust_test(
    name = "ble_gateway_unit_tests",
    size = "small",
    crate = ":ble_gateway",
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
