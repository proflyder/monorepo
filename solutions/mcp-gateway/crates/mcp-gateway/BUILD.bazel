load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

# Kept in sync with [package].version in Cargo.toml. Bazel does not derive
# env!("CARGO_PKG_VERSION"); without this the deployed binary reports 0.0.0.
PACKAGE_VERSION = "0.1.0"

DEPS = [
    "//packages/rust/forced-ssh:forced_ssh",
    "//packages/rust/home-clients:home_clients",
    "//packages/rust/home-config:home_config",
    "//packages/rust/home-http:home_http",
    "//packages/rust/home-runtime:home_runtime",
    "//packages/rust/home-secret:home_secret",
    "//packages/rust/home-telegram:home_telegram",
    "//packages/rust/home-telemetry:home_telemetry",
    "//packages/rust/home-tls:home_tls",
    "@crates//:anyhow",
    "@crates//:axum",
    "@crates//:base64",
    "@crates//:futures",
    "@crates//:http",
    "@crates//:http-body-util",
    "@crates//:jiff",
    "@crates//:prometheus-client",
    "@crates//:rand",
    "@crates//:regex",
    "@crates//:reqwest",
    "@crates//:rmcp",
    "@crates//:russh",
    "@crates//:rustls",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:serde-saphyr",
    "@crates//:thiserror",
    "@crates//:time",
    "@crates//:tokio",
    "@crates//:tokio-util",
    "@crates//:tower",
    "@crates//:tracing",
    "//packages/rust/voice-contract:voice_contract",
]

rust_library(
    name = "mcp_gateway",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    crate_name = "mcp_gateway",
    edition = "2024",
    lint_config = ":workspace_lints",
    version = PACKAGE_VERSION,
    deps = DEPS,
)

rust_binary(
    name = "mcp-gateway",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    version = PACKAGE_VERSION,
    deps = DEPS + [":mcp_gateway"],
)

# The domain vectors are the port contract and are read from disk (from the
# runfiles tree under Bazel, from the repository under cargo test).
rust_test(
    name = "unit_tests",
    size = "small",
    crate = ":mcp_gateway",
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS + [
        "@crates//:tempfile",
    ],
    data = ["//solutions/mcp-gateway/testdata:vectors"],
)

rust_test(
    name = "contract_tests",
    size = "small",
    srcs = ["tests/contract.rs"],
    data = [
        "//solutions/mcp-gateway/testdata:contract_server",
        "//solutions/mcp-gateway/testdata:contract_tools",
        "//solutions/mcp-gateway/testdata:vectors",
    ],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS + [
        ":mcp_gateway",
        "//packages/rust/home-contracttest:home_contracttest",
    ],
)

# Deploy data contract: the tracked catalog and bb allow-list must pass the
# real validators. Replaces the former Go `catalog_contract_test.go`.
rust_test(
    name = "deploy_contract_tests",
    size = "small",
    srcs = ["tests/deploy_contract.rs"],
    data = ["//projects/home/kubernetes/mcp-gateway:deploy_templates"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS + [":mcp_gateway"],
)

rust_test(
    name = "voice_tests",
    size = "small",
    srcs = ["tests/voice.rs"],
    data = ["//solutions/mcp-gateway/testdata:contract_voice"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS + [
        ":mcp_gateway",
        "//packages/rust/home-contracttest:home_contracttest",
        "//solutions/voice-proxy/crates/voice-proxy:voice_proxy_lib",
    ],
)

# Per-session `notifications/tools/list_changed`: the notification must reach
# the standalone GET stream whether it opens before or after
# `notifications/initialized`, exactly once.
rust_test(
    name = "tool_list_changed_tests",
    size = "small",
    srcs = ["tests/tool_list_changed.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS + [":mcp_gateway"],
)

extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rustfmt_test(
    name = "rustfmt",
    size = "small",
    targets = [
        ":mcp_gateway",
        ":mcp-gateway",
        ":unit_tests",
        ":contract_tests",
        ":deploy_contract_tests",
        ":voice_tests",
        ":tool_list_changed_tests",
    ],
)

# rules_rust turns every clippy warning into an error, the `-D warnings` gate.
rust_clippy_test(
    name = "clippy",
    size = "small",
    targets = [
        ":mcp_gateway",
        ":mcp-gateway",
        ":unit_tests",
        ":contract_tests",
        ":deploy_contract_tests",
        ":tool_list_changed_tests",
    ],
)
