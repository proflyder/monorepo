load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Pure domain (catalog, speech, redaction, alerts, status/report, state) plus
# the Kubernetes REST and bb SSH bridge clients. The binary side of the gateway
# (MCP transport, tool groups) is added in a later PR; this crate is a library
# so the domain can be tested on its own against the shared golden vectors.
DEPS = [
    "@crates//:base64",
    "@crates//:hmac",
    "@crates//:jiff",
    "@crates//:regex",
    "@crates//:reqwest",
    "@crates//:russh",
    "@crates//:rustls",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:serde_yaml",
    "@crates//:sha1",
    "@crates//:thiserror",
    "@crates//:time",
    "@crates//:tokio",
]

rust_library(
    name = "mcp_gateway",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

rust_test(
    name = "unit_tests",
    crate = ":mcp_gateway",
    edition = "2024",
    lint_config = ":workspace_lints",
    # The domain vectors are the port contract and are read from disk (from the
    # runfiles tree under Bazel, from the repository under cargo test).
    data = ["//solutions/mcp-gateway/testdata:vectors"],
    deps = DEPS + [
        "@crates//:axum",
        "@crates//:rand",
        "@crates//:tempfile",
    ],
)

extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
