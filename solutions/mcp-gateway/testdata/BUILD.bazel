package(default_visibility = ["//visibility:public"])

exports_files([
    "catalog.example.yaml",
    "report_ok.txt",
    "report_problems.txt",
    "reference/mcp_tools_list_go_snapshot.json",
])

filegroup(
    name = "vectors",
    srcs = glob(["vectors/*.json"]),
)

# Frozen HTTP contract fixtures captured from the former Go implementation.
# The Rust contract runner replays them; they are data, not Go tests. The
# directory split mirrors the former Go test packages.
filegroup(
    name = "contract_server",
    srcs = glob(["contract/server/*.json"]),
)

filegroup(
    name = "contract_tools",
    srcs = glob(["contract/tools/*.json"]),
)

filegroup(
    name = "contract_voice",
    srcs = glob(["contract/voice/*.json"]),
)
