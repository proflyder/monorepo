{
  "name": "mcp_tools_list_bb_read",
  "description": "MCP tools/list with only bb.read: a single read-only bb_status tool.",
  "compare": "semantic",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Authorization": "Bearer mcp-contract-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": 1,
          "jsonrpc": "2.0",
          "method": "initialize",
          "params": {
            "capabilities": {},
            "clientInfo": {
              "name": "contract-client",
              "version": "1.0.0"
            },
            "protocolVersion": "2025-06-18"
          }
        }
      },
      "response": {
        "status": 200,
        "format": "sse",
        "headers": {
          "Content-Type": "text/event-stream"
        },
        "body": {
          "id": 1,
          "jsonrpc": "2.0",
          "result": {
            "capabilities": {
              "logging": {},
              "tools": {
                "listChanged": true
              }
            },
            "protocolVersion": "2025-06-18",
            "serverInfo": {
              "name": "mcp-gateway",
              "title": "Infra gateway",
              "version": "contract"
            }
          }
        }
      },
      "captureHeaders": {
        "session": "Mcp-Session-Id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Authorization": "Bearer mcp-contract-token",
          "Content-Type": "application/json",
          "Mcp-Session-Id": "{{session}}"
        },
        "body": {
          "jsonrpc": "2.0",
          "method": "notifications/initialized"
        }
      },
      "response": {
        "status": 202
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Authorization": "Bearer mcp-contract-token",
          "Content-Type": "application/json",
          "Mcp-Session-Id": "{{session}}"
        },
        "body": {
          "id": 2,
          "jsonrpc": "2.0",
          "method": "tools/list",
          "params": {}
        }
      },
      "response": {
        "status": 200,
        "format": "sse",
        "headers": {
          "Content-Type": "text/event-stream"
        },
        "body": {
          "id": 2,
          "jsonrpc": "2.0",
          "result": {
            "tools": [
              {
                "annotations": {
                  "openWorldHint": false,
                  "readOnlyHint": true
                },
                "description": "Short summary of running agent threads in the personal profile. Work-profile threads and projects are never listed. Returns a short Russian speech line plus structured thread details.",
                "inputSchema": {
                  "additionalProperties": false,
                  "type": "object"
                },
                "name": "bb_status"
              }
            ]
          }
        }
      }
    }
  ]
}
