load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "tools",
    srcs = [
        "bb.go",
        "fix.go",
        "fullreport.go",
        "read.go",
        "report.go",
        "tools.go",
    ],
    importpath = "github.com/proflyder/monorepo/solutions/mcp-gateway/internal/tools",
    visibility = ["//solutions/mcp-gateway:__subpackages__"],
    deps = [
        "//solutions/mcp-gateway/internal/agentmode",
        "//solutions/mcp-gateway/internal/alertmanager",
        "//solutions/mcp-gateway/internal/bb",
        "//solutions/mcp-gateway/internal/catalog",
        "//solutions/mcp-gateway/internal/checks",
        "//solutions/mcp-gateway/internal/kubernetes",
        "//solutions/mcp-gateway/internal/loki",
        "//solutions/mcp-gateway/internal/metrics",
        "//solutions/mcp-gateway/internal/pending",
        "//solutions/mcp-gateway/internal/prometheus",
        "//solutions/mcp-gateway/internal/redact",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)

go_test(
    name = "tools_test",
    srcs = [
        "bb_test.go",
        "contract_test.go",
        "fakes_test.go",
        "fix_test.go",
        "fullreport_test.go",
        "read_test.go",
        "report_test.go",
        "vectors_test.go",
    ],
    data = [
        "//solutions/mcp-gateway/testdata:report_ok.txt",
        "//solutions/mcp-gateway/testdata:report_problems.txt",
        "//solutions/mcp-gateway/testdata:vectors",
    ] + glob(["testdata/contract/*.json"]),
    embed = [":tools"],
    deps = [
        "//packages/go/contracttest",
        "//solutions/mcp-gateway/internal/agentmode",
        "//solutions/mcp-gateway/internal/alertmanager",
        "//solutions/mcp-gateway/internal/bb",
        "//solutions/mcp-gateway/internal/catalog",
        "//solutions/mcp-gateway/internal/checks",
        "//solutions/mcp-gateway/internal/golden",
        "//solutions/mcp-gateway/internal/group",
        "//solutions/mcp-gateway/internal/kubernetes",
        "//solutions/mcp-gateway/internal/loki",
        "//solutions/mcp-gateway/internal/metrics",
        "//solutions/mcp-gateway/internal/pending",
        "//solutions/mcp-gateway/internal/prometheus",
        "//solutions/mcp-gateway/internal/server",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)

filegroup(
    name = "contract_fixtures",
    srcs = glob(["testdata/contract/*.json"]),
    visibility = ["//visibility:public"],
)
