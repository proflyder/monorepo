{
  "name": "mcp_resources_list",
  "description": "MCP resources/list: the single infra://catalog markdown resource.",
  "compare": "semantic",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Authorization": "Bearer mcp-contract-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": 1,
          "jsonrpc": "2.0",
          "method": "initialize",
          "params": {
            "capabilities": {},
            "clientInfo": {
              "name": "contract-client",
              "version": "1.0.0"
            },
            "protocolVersion": "2025-06-18"
          }
        }
      },
      "response": {
        "status": 200,
        "format": "sse",
        "headers": {
          "Content-Type": "text/event-stream"
        },
        "body": {
          "id": 1,
          "jsonrpc": "2.0",
          "result": {
            "capabilities": {
              "logging": {},
              "resources": {
                "listChanged": true
              },
              "tools": {
                "listChanged": true
              }
            },
            "protocolVersion": "2025-06-18",
            "serverInfo": {
              "name": "mcp-gateway",
              "title": "Infra gateway",
              "version": "contract"
            }
          }
        }
      },
      "captureHeaders": {
        "session": "Mcp-Session-Id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Authorization": "Bearer mcp-contract-token",
          "Content-Type": "application/json",
          "Mcp-Session-Id": "{{session}}"
        },
        "body": {
          "jsonrpc": "2.0",
          "method": "notifications/initialized"
        }
      },
      "response": {
        "status": 202
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Authorization": "Bearer mcp-contract-token",
          "Content-Type": "application/json",
          "Mcp-Session-Id": "{{session}}"
        },
        "body": {
          "id": 2,
          "jsonrpc": "2.0",
          "method": "resources/list",
          "params": {}
        }
      },
      "response": {
        "status": 200,
        "format": "sse",
        "headers": {
          "Content-Type": "text/event-stream"
        },
        "body": {
          "id": 2,
          "jsonrpc": "2.0",
          "result": {
            "resources": [
              {
                "description": "Sanitized topology overview plus the full service catalog.",
                "mimeType": "text/markdown",
                "name": "infra catalog",
                "title": "Infra catalog",
                "uri": "infra://catalog"
              }
            ]
          }
        }
      }
    }
  ]
}
