load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "voice",
    srcs = ["voice.go"],
    importpath = "github.com/proflyder/monorepo/solutions/mcp-gateway/internal/voice",
    visibility = ["//solutions/mcp-gateway:__subpackages__"],
    deps = [
        "//solutions/mcp-gateway/internal/agentmode",
        "//solutions/mcp-gateway/internal/bb",
        "//solutions/mcp-gateway/internal/metrics",
        "@org_golang_x_time//rate",
    ],
)

go_test(
    name = "voice_test",
    srcs = [
        "contract_test.go",
        "voice_test.go",
    ],
    data = glob(["testdata/contract/*.json"]),
    embed = [":voice"],
    deps = [
        "//packages/go/contracttest",
        "//solutions/mcp-gateway/internal/agentmode",
        "//solutions/mcp-gateway/internal/bb",
        "//solutions/mcp-gateway/internal/server",
        "@org_golang_x_time//rate",
    ],
)
