          "method": "notifications/initialized"
        }
      },
      "response": {
        "status": 202
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Authorization": "Bearer mcp-contract-token",
          "Content-Type": "application/json",
          "Mcp-Session-Id": "{{session}}"
        },
        "body": {
          "id": 3,
          "jsonrpc": "2.0",
          "method": "tools/call",
          "params": {
            "arguments": {},
            "name": "infra_overview"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/event-stream"
