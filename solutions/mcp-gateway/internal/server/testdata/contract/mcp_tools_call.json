{
  "name": "mcp_tools_call",
  "description": "MCP tools/call for the read-only infra_overview tool against a fake catalog: the result shape is a single text block with speech and structured details.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
          "Accept": "application/json, text/event-stream",
          "Authorization": "Bearer mcp-contract-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": 1,
          "jsonrpc": "2.0",
          "method": "initialize",
          "params": {
            "capabilities": {},
            "clientInfo": {
              "name": "contract-client",
              "version": "1.0.0"
            },
            "protocolVersion": "2025-06-18"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/event-stream"
        },
        "body": "event: message\ndata: {\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{\"logging\":{},\"resources\":{\"listChanged\":true},\"tools\":{\"listChanged\":true}},\"protocolVersion\":\"2025-06-18\",\"serverInfo\":{\"name\":\"mcp-gateway\",\"title\":\"Infra gateway\",\"version\":\"contract\"}}}\n\n"
      },
      "captureHeaders": {
        "session": "Mcp-Session-Id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/mcp",
        "headers": {
