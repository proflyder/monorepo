load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "server",
    srcs = ["server.go"],
    importpath = "ricardo.local/monorepo/solutions/mcp-gateway/internal/server",
    visibility = ["//solutions/mcp-gateway:__subpackages__"],
    deps = ["//solutions/mcp-gateway/internal/metrics"],
)

go_test(
    name = "server_test",
    srcs = [
        "contract_test.go",
        "server_test.go",
    ],
    data = glob(["testdata/contract/*.json"]),
    embed = [":server"],
    deps = [
        "//packages/go/contracttest",
        "//solutions/mcp-gateway/internal/catalog",
        "//solutions/mcp-gateway/internal/group",
        "//solutions/mcp-gateway/internal/tools",
        "@com_github_modelcontextprotocol_go_sdk//mcp",
    ],
)
