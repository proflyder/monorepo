load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "bb",
    srcs = [
        "client.go",
        "hostkey.go",
        "ssh.go",
        "targets.go",
    ],
    importpath = "github.com/proflyder/monorepo/solutions/mcp-gateway/internal/bb",
    visibility = ["//solutions/mcp-gateway:__subpackages__"],
    deps = [
        "@in_yaml_go_yaml_v2//:yaml",
        "@org_golang_x_crypto//ssh",
        "@org_golang_x_crypto//ssh/knownhosts",
    ],
)

go_test(
    name = "bb_test",
    srcs = [
        "client_test.go",
        "contract_test.go",
        "ssh_test.go",
        "targets_test.go",
    ],
    # The gateway must serialize only the params the bb home-dispatcher plugin
    # schema accepts; the fixture is shared with the plugin's JS test.
    data = ["//solutions/bb-home-dispatcher:contract_params"],
    embed = [":bb"],
    deps = [
        "@org_golang_x_crypto//ssh",
        "@org_golang_x_crypto//ssh/knownhosts",
    ],
)
