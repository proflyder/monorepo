{
  "name": "schedule_reminder_lifecycle",
  "description": "Reminder schedules are one-shot only (REPEAT_KIND_ONCE with onceDate); payloadJson defaults to {}; Get/List/Update(revision)/Delete keep the same id and Delete is idempotent (second call returns deleted=false).",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/CreateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "at": {
            "hour": 9,
            "minute": 0
          },
          "enabled": true,
          "kind": "SCHEDULE_KIND_REMINDER",
          "label": "call mom",
          "onceDate": "2026-02-01",
          "repeat": "REPEAT_KIND_ONCE",
          "timezone": "UTC"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 9
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_REMINDER",
            "label": "call mom",
            "nextDueUnix": "1769936400",
            "onceDate": "2026-02-01",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_ONCE",
            "revision": "1",
            "timezone": "UTC",
            "updatedUnix": "1767268800"
          }
        }
      },
      "capture": {
        "scheduleId": "schedule.id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/GetSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{scheduleId}}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 9
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_REMINDER",
            "label": "call mom",
            "nextDueUnix": "1769936400",
            "onceDate": "2026-02-01",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_ONCE",
            "revision": "1",
            "timezone": "UTC",
            "updatedUnix": "1767268800"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/ListSchedules",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "includeDisabled": true
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedules": [
            {
              "at": {
                "hour": 9
              },
              "createdUnix": "1767268800",
              "enabled": true,
              "id": "{{scheduleId}}",
              "kind": "SCHEDULE_KIND_REMINDER",
              "label": "call mom",
              "nextDueUnix": "1769936400",
              "onceDate": "2026-02-01",
              "payloadJson": "{}",
              "repeat": "REPEAT_KIND_ONCE",
              "revision": "1",
              "timezone": "UTC",
              "updatedUnix": "1767268800"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/UpdateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "expectedRevision": 1,
          "schedule": {
            "at": {
              "hour": 9,
              "minute": 15
            },
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_REMINDER",
            "label": "call dad",
            "onceDate": "2026-02-01",
            "repeat": "REPEAT_KIND_ONCE",
            "timezone": "UTC"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 9,
              "minute": 15
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_REMINDER",
            "label": "call dad",
            "nextDueUnix": "1769937300",
            "onceDate": "2026-02-01",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_ONCE",
            "revision": "2",
            "timezone": "UTC",
            "updatedUnix": "1767268800"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/DeleteSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{scheduleId}}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "deleted": true
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/DeleteSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{scheduleId}}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {}
      }
    }
  ]
}
