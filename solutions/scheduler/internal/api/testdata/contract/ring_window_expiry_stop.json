{
  "name": "ring_window_expiry_stop",
  "description": "After a FIRE, a tick past the 900 s ring window cancels that occurrence's pending FIRE and emits exactly one durable STOP (detail ring_window_expired, task_type alarm.stop, queue home). A repeated tick does not duplicate it and the STOP can be acked.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/CreateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "at": {
            "hour": 7,
            "minute": 30
          },
          "enabled": true,
          "kind": "SCHEDULE_KIND_ALARM",
          "label": "wake",
          "repeat": "REPEAT_KIND_DAILY",
          "timezone": "UTC"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 30
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "wake",
            "nextDueUnix": "1767339000",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_DAILY",
            "revision": "1",
            "timezone": "UTC",
            "updatedUnix": "1767268800"
          }
        }
      },
      "capture": {
        "scheduleId": "schedule.id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/ListDueEvents",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "consumerId": "home-1",
          "queue": "home"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "events": [
            {
              "action": "EVENT_ACTION_FIRE",
              "attempts": 1,
              "createdUnix": "1767339000",
              "dueUnix": "1767339000",
              "id": "{{fireEventId}}",
              "label": "wake",
              "leaseUntilUnix": "1767339060",
              "occurrenceUnix": "1767339000",
              "payloadJson": "{}",
              "queue": "home",
              "sourceId": "{{scheduleId}}",
              "sourceKind": "SOURCE_KIND_ALARM",
              "state": "EVENT_STATE_LEASED",
              "taskType": "alarm.fire"
            }
          ]
        }
      },
      "capture": {
        "fireEventId": "events[0].id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/ListDueEvents",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "consumerId": "home-1",
          "queue": "home"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "events": [
            {
              "action": "EVENT_ACTION_STOP",
              "attempts": 1,
              "createdUnix": "1767339901",
              "detail": "ring_window_expired",
              "dueUnix": "1767339901",
              "id": "{{stopEventId}}",
              "label": "wake",
              "leaseUntilUnix": "1767339961",
              "occurrenceUnix": "1767339000",
              "payloadJson": "{}",
              "queue": "home",
              "sourceId": "{{scheduleId}}",
              "sourceKind": "SOURCE_KIND_ALARM",
              "state": "EVENT_STATE_LEASED",
              "taskType": "alarm.stop"
            }
          ]
        }
      },
      "capture": {
        "stopEventId": "events[0].id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/ListDueEvents",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "consumerId": "home-1",
          "queue": "home"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {}
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/AckEvent",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
