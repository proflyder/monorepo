        },
        "body": {
          "event": {
            "ackOutcome": "ACK_OUTCOME_DELIVERED",
            "ackedUnix": "1767339901",
            "action": "EVENT_ACTION_STOP",
            "attempts": 1,
            "createdUnix": "1767339901",
            "detail": "ring_window_expired",
            "dueUnix": "1767339901",
            "id": "{{stopEventId}}",
            "label": "wake",
            "occurrenceUnix": "1767339000",
            "payloadJson": "{}",
            "queue": "home",
            "sourceId": "{{scheduleId}}",
            "sourceKind": "SOURCE_KIND_ALARM",
            "state": "EVENT_STATE_DELIVERED",
            "taskType": "alarm.stop"
          }
        }
      }
    }
  ]
