        },
        "body": {
          "events": [
            {
              "action": "EVENT_ACTION_FIRE",
              "attempts": 1,
              "createdUnix": "1767339000",
              "dueUnix": "1767425400",
              "id": "{{snoozeEventId}}",
              "label": "wake",
              "leaseUntilUnix": "1767425460",
              "occurrenceUnix": "1767339000",
              "payloadJson": "{}",
              "queue": "home",
              "snoozeSeq": 1,
              "sourceId": "{{scheduleId}}",
              "sourceKind": "SOURCE_KIND_ALARM",
              "state": "EVENT_STATE_LEASED",
