{
  "name": "create_schedule_idempotency",
  "description": "CreateSchedule with an idempotency key returns the original resource on replay; the same key with a different request is ALREADY_EXISTS. Fixed clock keeps nextDueUnix deterministic; schedule.id is captured and normalised to {{scheduleId}}.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/CreateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "at": {
            "hour": 7,
            "minute": 30
          },
          "enabled": true,
          "idempotencyKey": "wake-key",
          "kind": "SCHEDULE_KIND_ALARM",
          "label": "wake",
          "repeat": "REPEAT_KIND_DAILY",
          "timezone": "UTC"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 30
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "wake",
            "nextDueUnix": "1767339000",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_DAILY",
            "revision": "1",
            "timezone": "UTC",
            "updatedUnix": "1767268800"
          }
        }
      },
      "capture": {
        "scheduleId": "schedule.id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/CreateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "at": {
            "hour": 7,
            "minute": 30
          },
          "enabled": true,
          "idempotencyKey": "wake-key",
          "kind": "SCHEDULE_KIND_ALARM",
          "label": "wake",
          "repeat": "REPEAT_KIND_DAILY",
          "timezone": "UTC"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 30
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "wake",
            "nextDueUnix": "1767339000",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_DAILY",
            "revision": "1",
            "timezone": "UTC",
            "updatedUnix": "1767268800"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/CreateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "at": {
            "hour": 8,
            "minute": 0
          },
          "enabled": true,
          "idempotencyKey": "wake-key",
          "kind": "SCHEDULE_KIND_ALARM",
          "label": "gym",
          "repeat": "REPEAT_KIND_DAILY",
          "timezone": "UTC"
        }
      },
      "response": {
        "status": 409,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "code": "already_exists",
          "message": "idempotency key conflict: idempotency key reused with a different request"
        }
      }
    }
  ]
}
