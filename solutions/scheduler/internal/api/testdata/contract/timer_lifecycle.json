{
  "name": "timer_lifecycle",
  "description": "StartTimer is RUNNING with an authoritative dueUnix; PauseTimer stores remaining seconds and clears dueUnix; ResumeTimer recomputes dueUnix from the remaining duration and the current clock; CancelTimer is idempotent; pausing a cancelled timer is FAILED_PRECONDITION; duration 0 and duration beyond the 7-day limit are INVALID_ARGUMENT.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/StartTimer",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "durationSeconds": "300",
          "label": "tea"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "timer": {
            "createdUnix": "1767268800",
            "dueUnix": "1767269100",
            "durationSeconds": "300",
            "id": "{{timerId}}",
            "label": "tea",
            "revision": "1",
            "state": "TIMER_STATE_RUNNING",
            "updatedUnix": "1767268800"
          }
        }
      },
      "capture": {
        "timerId": "timer.id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/GetTimer",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{timerId}}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "timer": {
            "createdUnix": "1767268800",
            "dueUnix": "1767269100",
            "durationSeconds": "300",
            "id": "{{timerId}}",
            "label": "tea",
            "revision": "1",
            "state": "TIMER_STATE_RUNNING",
            "updatedUnix": "1767268800"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/ListTimers",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {}
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "timers": [
            {
              "createdUnix": "1767268800",
              "dueUnix": "1767269100",
              "durationSeconds": "300",
              "id": "{{timerId}}",
              "label": "tea",
              "revision": "1",
              "state": "TIMER_STATE_RUNNING",
              "updatedUnix": "1767268800"
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/PauseTimer",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{timerId}}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "timer": {
            "createdUnix": "1767268800",
            "durationSeconds": "300",
            "id": "{{timerId}}",
            "label": "tea",
            "remainingSeconds": "200",
            "revision": "2",
            "state": "TIMER_STATE_PAUSED",
            "updatedUnix": "1767268900"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/ResumeTimer",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{timerId}}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "timer": {
            "createdUnix": "1767268800",
            "dueUnix": "1767269150",
            "durationSeconds": "300",
            "id": "{{timerId}}",
            "label": "tea",
            "revision": "3",
            "state": "TIMER_STATE_RUNNING",
            "updatedUnix": "1767268950"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/CancelTimer",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{timerId}}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "timer": {
            "createdUnix": "1767268800",
            "durationSeconds": "300",
            "id": "{{timerId}}",
            "label": "tea",
            "revision": "4",
            "state": "TIMER_STATE_CANCELLED",
            "updatedUnix": "1767268950"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/CancelTimer",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{timerId}}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "timer": {
            "createdUnix": "1767268800",
            "durationSeconds": "300",
            "id": "{{timerId}}",
            "label": "tea",
            "revision": "4",
            "state": "TIMER_STATE_CANCELLED",
            "updatedUnix": "1767268950"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/PauseTimer",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{timerId}}"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "code": "failed_precondition",
          "message": "precondition failed: timer is timer_state_cancelled"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/StartTimer",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "durationSeconds": "0",
          "label": "zero"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "code": "invalid_argument",
          "message": "invalid argument: duration_seconds must be positive"
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/StartTimer",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "durationSeconds": "604801",
          "label": "too long"
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "code": "invalid_argument",
          "message": "invalid argument: duration exceeds 168h0m0s"
        }
      }
    }
  ]
}
