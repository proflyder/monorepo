{
  "name": "update_schedule_revision",
  "description": "UpdateSchedule honours expected_revision: a matching revision succeeds and bumps the revision, a stale one is ABORTED. schedule.id comes from the first step via {{scheduleId}}.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/CreateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "at": {
            "hour": 7,
            "minute": 30
          },
          "enabled": true,
          "kind": "SCHEDULE_KIND_ALARM",
          "label": "wake",
          "repeat": "REPEAT_KIND_DAILY",
          "timezone": "UTC"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 30
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "wake",
            "nextDueUnix": "1767339000",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_DAILY",
            "revision": "1",
            "timezone": "UTC",
            "updatedUnix": "1767268800"
          }
        }
      },
      "capture": {
        "scheduleId": "schedule.id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/UpdateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "expectedRevision": 1,
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 45
            },
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "wake up",
            "repeat": "REPEAT_KIND_DAILY",
            "timezone": "UTC"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 45
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "wake up",
            "nextDueUnix": "1767339900",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_DAILY",
            "revision": "2",
            "timezone": "UTC",
            "updatedUnix": "1767268800"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/ricardo.v1.SchedulerService/UpdateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "expectedRevision": 1,
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 50
            },
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "stale write",
            "repeat": "REPEAT_KIND_DAILY",
            "timezone": "UTC"
          }
        }
      },
      "response": {
        "status": 409,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "code": "aborted",
          "message": "revision conflict: current revision 2, expected 1"
        }
      }
    }
  ]
}
