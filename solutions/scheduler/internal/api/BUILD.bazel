load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

# Golden HTTP fixtures stay owned by the Go tests; the Rust contract runner
# reads them in place.
filegroup(
    name = "contract_fixtures",
    srcs = glob(["testdata/contract/*.json"]),
)

go_library(
    name = "api",
    srcs = [
        "alarm.go",
        "auth.go",
        "service.go",
    ],
    importpath = "github.com/proflyder/monorepo/solutions/scheduler/internal/api",
    deps = [
        "//packages/proto/ricardo/v1:ricardo",
        "//packages/proto/ricardo/v1/ricardov1connect",
        "//solutions/scheduler/internal/engine",
        "//solutions/scheduler/internal/store",
        "@com_connectrpc_connect//:connect",
        "@org_golang_x_net//http2",
        "@org_golang_x_net//http2/h2c",
    ],
)

go_test(
    name = "api_test",
    srcs = [
        "api_test.go",
        "contract_test.go",
    ],
    data = glob(["testdata/contract/*.json"]),
    embed = [":api"],
    deps = [
        "//packages/go/contracttest",
        "//packages/proto/ricardo/v1:ricardo",
        "//packages/proto/ricardo/v1/ricardov1connect",
        "//solutions/scheduler/internal/engine",
        "//solutions/scheduler/internal/store",
        "@com_connectrpc_connect//:connect",
        "@org_golang_google_protobuf//proto",
        "@org_golang_x_net//http2",
    ],
)
