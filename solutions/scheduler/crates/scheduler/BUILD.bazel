load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

# Kept in sync with [package].version in Cargo.toml. Bazel does not derive
# env!("CARGO_PKG_VERSION"); without this the deployed binary reports 0.0.0.
PACKAGE_VERSION = "0.1.0"

LIB_DEPS = [
    "//packages/rust/home-config:home_config",
    "//packages/rust/home-http:home_http",
    "//packages/rust/home-proto:home_proto",
    "//packages/rust/home-runtime:home_runtime",
    "//packages/rust/home-secret:home_secret",
    "//packages/rust/home-sqlite:home_sqlite",
    "//packages/rust/home-telemetry:home_telemetry",
    "@crates//:anyhow",
    "@crates//:axum",
    "@crates//:connectrpc",
    "@crates//:http",
    "@crates//:jiff",
    "@crates//:reqwest",
    "@crates//:rusqlite",
    "@crates//:rustls",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:sha1_smol",
    "@crates//:sha2",
    "@crates//:subtle",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-util",
    "@crates//:tower",
    "@crates//:tracing",
    "@crates//:uuid",
]

rust_library(
    name = "scheduler_lib",
    crate_name = "scheduler",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    edition = "2024",
    lint_config = ":workspace_lints",
    version = PACKAGE_VERSION,
    deps = LIB_DEPS,
)

# The deployed binary. The image rebuilds it for static musl; this target is
# also what host tests and `cargo run -p scheduler` use.
rust_binary(
    name = "scheduler",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    version = PACKAGE_VERSION,
    deps = LIB_DEPS + [":scheduler_lib"],
)

# The frozen golden tables stay in solutions/scheduler; the test reads them at
# runtime instead of embedding a second copy.
rust_test(
    name = "unit_tests",
    crate = ":scheduler_lib",
    compile_data = [
        "//solutions/scheduler:ids_vectors",
        "//solutions/scheduler:planner_vectors",
    ],
    data = [
        "//solutions/scheduler:ids_vectors",
        "//solutions/scheduler:planner_vectors",
    ],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = LIB_DEPS,
)

rust_test(
    name = "contract_tests",
    srcs = ["tests/contract.rs"],
    data = ["//solutions/scheduler:contract_fixtures"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = LIB_DEPS + [
        ":scheduler_lib",
        "//packages/rust/home-contracttest:home_contracttest",
    ],
)

rust_test(
    name = "go_database_test",
    srcs = ["tests/go_database.rs"],
    data = ["//solutions/scheduler:go_database_dump"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = LIB_DEPS + [
        ":scheduler_lib",
        "@crates//:tempfile",
    ],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":scheduler_lib",
        ":scheduler",
        ":contract_tests",
        ":go_database_test",
    ],
)

# rules_rust turns every clippy warning into an error, the `-D warnings` gate.
rust_clippy_test(
    name = "clippy",
    targets = [
        ":scheduler_lib",
        ":scheduler",
        ":contract_tests",
        ":go_database_test",
    ],
)
