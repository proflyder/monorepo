package(default_visibility = ["//visibility:public"])

# The deployed scheduler is the Rust crate's binary. The Go binary below stays
# buildable as the digest rollback reference and for its golden tests.
alias(
    name = "scheduler",
    actual = "//solutions/scheduler/crates/scheduler:scheduler",
)

alias(
    name = "scheduler_go",
    actual = "//solutions/scheduler/cmd/scheduler",
)

filegroup(
    name = "planner_vectors",
    srcs = glob(["testdata/planner/*.json"]),
)

filegroup(
    name = "ids_vectors",
    srcs = ["testdata/ids.json"],
)

# Textual v1 SQL dump produced by the Go store test (-update-export).
filegroup(
    name = "go_database_dump",
    srcs = ["testdata/go_v1.sql"],
)
