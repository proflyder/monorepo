{
  "name": "stop_after_delivered",
  "description": "Snooze stays available after a DELIVERED ack while the ring window is open; StopSchedule then clears the window and is idempotent on replay; snoozing after the stop is FAILED_PRECONDITION (400).",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/home.v1.SchedulerService/CreateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "at": {
            "hour": 7,
            "minute": 30
          },
          "enabled": true,
          "kind": "SCHEDULE_KIND_ALARM",
          "label": "wake",
          "repeat": "REPEAT_KIND_DAILY",
          "timezone": "UTC"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 30
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "wake",
            "nextDueUnix": "1767339000",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_DAILY",
            "revision": "1",
            "timezone": "UTC",
            "updatedUnix": "1767268800"
          }
        }
      },
      "capture": {
        "scheduleId": "schedule.id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/home.v1.SchedulerService/ListDueEvents",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "consumerId": "home-1",
          "queue": "home"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "events": [
            {
              "action": "EVENT_ACTION_FIRE",
              "attempts": 1,
              "createdUnix": "1767339000",
              "dueUnix": "1767339000",
              "id": "{{fireEventId}}",
              "label": "wake",
              "leaseUntilUnix": "1767339060",
              "occurrenceUnix": "1767339000",
              "payloadJson": "{}",
              "queue": "home",
              "sourceId": "{{scheduleId}}",
              "sourceKind": "SOURCE_KIND_ALARM",
              "state": "EVENT_STATE_LEASED",
              "taskType": "alarm.fire"
            }
          ]
        }
      },
      "capture": {
        "fireEventId": "events[0].id"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/home.v1.SchedulerService/AckEvent",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "consumerId": "home-1",
          "eventId": "{{fireEventId}}",
          "outcome": "ACK_OUTCOME_DELIVERED"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "event": {
            "ackOutcome": "ACK_OUTCOME_DELIVERED",
            "ackedUnix": "1767339000",
            "action": "EVENT_ACTION_FIRE",
            "attempts": 1,
            "createdUnix": "1767339000",
            "dueUnix": "1767339000",
            "id": "{{fireEventId}}",
            "label": "wake",
            "occurrenceUnix": "1767339000",
            "payloadJson": "{}",
            "queue": "home",
            "sourceId": "{{scheduleId}}",
            "sourceKind": "SOURCE_KIND_ALARM",
            "state": "EVENT_STATE_DELIVERED",
            "taskType": "alarm.fire"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/home.v1.SchedulerService/StopSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{scheduleId}}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 30
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "wake",
            "lastFiredUnix": "1767339000",
            "nextDueUnix": "1767425400",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_DAILY",
            "revision": "3",
            "timezone": "UTC",
            "updatedUnix": "1767339000"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/home.v1.SchedulerService/SnoozeSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{scheduleId}}",
          "minutes": 5
        }
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "code": "failed_precondition",
          "message": "precondition failed: schedule is not ringing",
          "details": [
            {
              "type": "home.v1.LocalizedText",
              "debug": {
                "key": "scheduler.error.schedule_not_ringing"
              }
            }
          ]
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/home.v1.SchedulerService/StopSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "id": "{{scheduleId}}"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 30
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "{{scheduleId}}",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "wake",
            "lastFiredUnix": "1767339000",
            "nextDueUnix": "1767425400",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_DAILY",
            "revision": "3",
            "timezone": "UTC",
            "updatedUnix": "1767339000"
          }
        }
      }
    }
  ]
}
