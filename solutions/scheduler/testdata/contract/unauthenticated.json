{
  "name": "unauthenticated",
  "description": "Every RPC requires Authorization: Bearer <token>; a request without it returns the Connect error envelope with code unauthenticated and HTTP 401.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/home.v1.SchedulerService/GetStatus",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {}
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "code": "unauthenticated",
          "message": "unauthenticated"
        }
      }
    }
  ]
}
