        "path": "/home.v1.SchedulerService/CreateSchedule",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "at": {
            "hour": 7,
            "minute": 30
          },
          "enabled": true,
          "kind": "SCHEDULE_KIND_ALARM",
          "label": "wake",
          "repeat": "REPEAT_KIND_DAILY",
          "timezone": "UTC"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "schedule": {
            "at": {
              "hour": 7,
              "minute": 30
            },
            "createdUnix": "1767268800",
            "enabled": true,
            "id": "<uuid>",
            "kind": "SCHEDULE_KIND_ALARM",
            "label": "wake",
            "nextDueUnix": "1767339000",
            "payloadJson": "{}",
            "repeat": "REPEAT_KIND_DAILY",
            "revision": "1",
            "timezone": "UTC",
            "updatedUnix": "1767268800"
          }
        }
      }
    },
    {
