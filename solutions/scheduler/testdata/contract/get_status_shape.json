        "method": "POST",
        "path": "/home.v1.SchedulerService/StartTimer",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "durationSeconds": "300",
          "label": "tea"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
