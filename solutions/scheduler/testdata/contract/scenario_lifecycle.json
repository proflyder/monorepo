        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "expectedRevision": "99",
          "scenario": {
            "id": "{{scenarioId}}",
            "label": "evening",
            "enabled": true,
            "triggers": [{"manual": {}}],
            "steps": [{"speak": {"text": "Done"}}]
          }
        }
      },
      "response": {
        "status": 409,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "code": "aborted",
          "message": "revision conflict: current revision 1, expected 99"
        }
      }
    },
    {
