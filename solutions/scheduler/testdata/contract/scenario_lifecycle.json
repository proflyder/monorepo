{
  "name": "scenario_lifecycle",
  "description": "Scenario definitions, materialized time triggers, manual runs and idempotency. The fake clock is fixed at 2026-01-01T12:00:00Z; ids and next_due_unix are deterministic.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/home.v1.ScenarioService/CreateScenario",
        "headers": {
          "Authorization": "Bearer contract-test-token",
          "Content-Type": "application/json"
        },
        "body": {
          "label": "evening",
          "description": "warm light",
          "enabled": true,
          "continueOnError": true,
          "triggers": [
            {"manual": {}},
            {
              "time": {
                "timezone": "UTC",
                "at": {"hour": 7, "minute": 30},
                "repeat": "REPEAT_KIND_DAILY"
              }
            }
          ],
          "conditions": [
            {"entityState": {"entityId": "light.kitchen", "state": "off"}}
          ],
          "steps": [
            {
              "catalog": {
                "entryId": "light.kitchen",
                "action": "turn_on",
                "paramsJson": "{\"brightness\":40}"
              }
            },
            {"delay": {"seconds": 5}},
            {"speak": {"text": "Done"}}
          ]
        }
      },
      "capture": {"scenarioId": "scenario.id"},
      "response": {
        "status": 200,
        "headers": {"Content-Type": "application/json"},
        "body": {
          "scenario": {
            "id": "{{scenarioId}}",
            "label": "evening",
            "description": "warm light",
            "enabled": true,
            "revision": "1",
            "createdUnix": "1767268800",
            "updatedUnix": "1767268800",
            "triggers": [
              {"manual": {}},
              {
                "time": {
                  "timezone": "UTC",
                  "at": {"hour": 7, "minute": 30},
                  "repeat": "REPEAT_KIND_DAILY"
                }
              }
            ],
            "conditions": [
              {"entityState": {"entityId": "light.kitchen", "state": "off"}}
            ],
            "steps": [
              {
                "catalog": {
                  "entryId": "light.kitchen",
                  "action": "turn_on",
                  "paramsJson": "{\"brightness\":40}"
                }
              },
              {"delay": {"seconds": 5}},
              {"speak": {"text": "Done"}}
            ],
            "continueOnError": true,
            "nextDueUnix": "1767339000"
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/home.v1.ScenarioService/GetScenario",
