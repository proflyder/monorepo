load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

# Kept in sync with [package].version in Cargo.toml. Bazel does not read the
# Cargo manifest; the `version` attribute injects env!("CARGO_PKG_VERSION").
PACKAGE_VERSION = "0.1.0"

LIB_DEPS = [
    "//packages/rust/home-config:home_config",
    "//packages/rust/home-http:home_http",
    "//packages/rust/home-runtime:home_runtime",
    "//packages/rust/home-secret:home_secret",
    "//packages/rust/home-sqlite:home_sqlite",
    "//packages/rust/home-telegram:home_telegram",
    "//packages/rust/home-tls:home_tls",
    "//packages/rust/home-telemetry:home_telemetry",
    "@crates//:anyhow",
    "@crates//:axum",
    "@crates//:http",
    "@crates//:jiff",
    "@crates//:prometheus-client",
    "@crates//:regex",
    "@crates//:reqwest",
    "@crates//:rusqlite",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-util",
    "@crates//:tracing",
]

TEST_DEPS = LIB_DEPS + [
    "//packages/rust/home-contracttest:home_contracttest",
    "@crates//:http-body-util",
    "@crates//:tempfile",
    "@crates//:tower",
]

rust_library(
    name = "currency_bot_lib",
    crate_name = "currency_bot",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = ["src/main.rs"],
    ),
    edition = "2024",
    lint_config = ":workspace_lints",
    version = PACKAGE_VERSION,
    deps = LIB_DEPS,
)

# The static musl image target (PR 4 wires it into rust_service_image). This
# PR only proves it builds; the Go image still deploys.
rust_binary(
    name = "currency-bot",
    srcs = ["src/main.rs"],
    rustc_flags = ["-C", "strip=symbols"],
    edition = "2024",
    lint_config = ":workspace_lints",
    version = PACKAGE_VERSION,
    deps = LIB_DEPS + [":currency_bot_lib"],
)

# Domain/store/client unit tests plus the frozen Go vectors and contract
# fixtures. The files are read at runtime from the repository or runfiles.
rust_test(
    name = "unit_tests",
    crate = ":currency_bot_lib",
    data = [
        "//solutions/currency-bot/testdata:contract",
        "//solutions/currency-bot/testdata:rates_html",
        "//solutions/currency-bot/testdata:store_schema",
        "//solutions/currency-bot/testdata:vectors",
    ],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = TEST_DEPS,
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":currency_bot_lib",
        ":currency-bot",
        ":unit_tests",
    ],
)

# rules_rust turns every clippy warning into an error, the `-D warnings` gate.
rust_clippy_test(
    name = "clippy",
    targets = [
        ":currency_bot_lib",
        ":currency-bot",
        ":unit_tests",
    ],
)
