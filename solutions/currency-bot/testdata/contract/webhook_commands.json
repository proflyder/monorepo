{
  "name": "webhook_commands",
  "description": "Command dispatch is prefix-based (/helpme is /help); foreign chats, edited messages, channel posts and non-message updates are acknowledged with 200 \"OK\". update_id is omitted so the dedup guard does not hide steps.",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/telegram/webhook",
        "headers": {
          "Content-Type": "application/json",
          "X-Telegram-Bot-Api-Secret-Token": "test-secret"
        },
        "body": {
          "message": {
            "chat": {
              "id": 123
            },
            "text": "/start"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "OK"
      }
    },
    {
      "request": {
        "method": "POST",
