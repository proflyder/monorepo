{
  "name": "webhook_secret",
  "description": "Missing and wrong X-Telegram-Bot-Api-Secret-Token return 401 with the plain-text body and nosniff; a valid secret always gets 200 \"OK\".",
  "steps": [
    {
      "request": {
        "method": "POST",
        "path": "/telegram/webhook",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "message": {
            "chat": {
              "id": 123
            },
            "text": "/start"
          },
          "update_id": 1
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "text/plain; charset=utf-8",
          "X-Content-Type-Options": "nosniff"
        },
        "body": "unauthorized\n"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/telegram/webhook",
        "headers": {
          "Content-Type": "application/json",
          "X-Telegram-Bot-Api-Secret-Token": "wrong"
        },
        "body": {
          "message": {
            "chat": {
              "id": 123
            },
            "text": "/start"
          },
          "update_id": 2
        }
      },
      "response": {
        "status": 401,
        "headers": {
          "Content-Type": "text/plain; charset=utf-8",
          "X-Content-Type-Options": "nosniff"
        },
        "body": "unauthorized\n"
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/telegram/webhook",
        "headers": {
          "Content-Type": "application/json",
          "X-Telegram-Bot-Api-Secret-Token": "test-secret"
        },
        "body": {
          "message": {
            "chat": {
              "id": 123
            },
            "text": "hello"
          }
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "OK"
      }
    }
  ]
}
