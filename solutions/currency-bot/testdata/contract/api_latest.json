{
  "name": "api_latest",
  "description": "Latest record with distinct buy/sell values: pins usdToKzt.sell/buy and rubToKzt.sell/buy so a rename cannot silently swap the rates Home Assistant speaks.",
  "steps": [
    {
      "request": {
        "method": "GET",
        "path": "/api/latest",
        "headers": {
          "Authorization": "Bearer test-api-key"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "rates": {
            "rubToKzt": {
              "buy": 6.21,
              "sell": 6.35
            },
            "usdToKzt": {
              "buy": 509.8,
              "sell": 512.4
            }
          },
          "timestamp": "2026-10-31T12:00:00Z"
        }
      }
    }
  ]
}
