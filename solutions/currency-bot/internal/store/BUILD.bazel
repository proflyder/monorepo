load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "store",
    srcs = ["store.go"],
    importpath = "github.com/proflyder/monorepo/solutions/currency-bot/internal/store",
    deps = [
        "//solutions/currency-bot/internal/model",
        "@org_modernc_sqlite//:sqlite",
    ],
)

go_test(
    name = "store_test",
    srcs = [
        "schema_test.go",
        "store_test.go",
        "vector_test.go",
    ],
    data = [
        "//solutions/currency-bot/testdata:store_schema",
        "//solutions/currency-bot/testdata:vectors",
    ],
    embed = [":store"],
    deps = [
        "//solutions/currency-bot/internal/golden",
        "//solutions/currency-bot/internal/model",
    ],
)
