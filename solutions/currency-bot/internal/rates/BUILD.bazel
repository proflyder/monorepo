load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "rates",
    srcs = ["parser.go"],
    importpath = "github.com/proflyder/monorepo/solutions/currency-bot/internal/rates",
    deps = ["//solutions/currency-bot/internal/model"],
)

go_test(
    name = "rates_test",
    srcs = [
        "parser_test.go",
        "vector_test.go",
    ],
    data = [
        "testdata/kurskz.html",
        "//solutions/currency-bot/testdata:rates_html",
        "//solutions/currency-bot/testdata:vectors",
    ],
    embed = [":rates"],
    deps = [
        "//solutions/currency-bot/internal/golden",
        "//solutions/currency-bot/internal/model",
    ],
)
