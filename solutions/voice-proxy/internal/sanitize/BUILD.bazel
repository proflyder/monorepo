load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "sanitize",
    srcs = ["sanitize.go"],
    importpath = "ricardo.local/monorepo/solutions/voice-proxy/internal/sanitize",
    deps = [
        "@org_golang_x_text//cases",
        "@org_golang_x_text//unicode/norm",
    ],
)

go_test(
    name = "sanitize_test",
    srcs = ["sanitize_test.go"],
    data = [
        "//solutions/voice-proxy/testdata/parity:sanitize.json",
        "//solutions/voice-proxy/testdata/parity:speech.json",
        "//solutions/voice-proxy/testdata/parity:streaming.json",
    ],
    embed = [":sanitize"],
)
