load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "proxy",
    srcs = [
        "completion.go",
        "handler.go",
        "json.go",
        "logger.go",
        "stream.go",
    ],
    importpath = "github.com/proflyder/monorepo/solutions/voice-proxy/internal/proxy",
    deps = [
        "//solutions/voice-proxy/internal/hermes",
        "//solutions/voice-proxy/internal/sanitize",
        "//solutions/voice-proxy/internal/sse",
    ],
)

go_test(
    name = "proxy_test",
    srcs = [
        "contract_test.go",
        "proxy_test.go",
    ],
    data = glob(["testdata/contract/*.json"]),
    embed = [":proxy"],
    deps = [
        "//packages/go/contracttest",
        "//solutions/voice-proxy/internal/hermes",
        "//solutions/voice-proxy/internal/sanitize",
        "//solutions/voice-proxy/internal/sse",
        "//solutions/voice-proxy/internal/testfake",
    ],
)
