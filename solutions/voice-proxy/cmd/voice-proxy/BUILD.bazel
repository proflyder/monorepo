load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "voice-proxy_lib",
    srcs = [
        "healthcheck.go",
        "main.go",
        "status.go",
    ],
    importpath = "ricardo.local/monorepo/solutions/voice-proxy/cmd/voice-proxy",
    visibility = ["//visibility:private"],
    deps = [
        "//solutions/voice-proxy/app",
        "//solutions/voice-proxy/internal/config",
    ],
)

go_binary(
    name = "voice-proxy",
    embed = [":voice-proxy_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "voice-proxy_test",
    srcs = ["cmd_test.go"],
    embed = [":voice-proxy_lib"],
    deps = [
        "//solutions/voice-proxy/internal/config",
        "//solutions/voice-proxy/internal/testfake",
    ],
)
