load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_binary(
    name = "ha-control",
    embed = [":ha-control_lib"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "ha-control_lib",
    srcs = [
        "config.go",
        "healthcheck.go",
        "main.go",
    ],
    importpath = "github.com/proflyder/monorepo/solutions/ha-bridge/cmd/ha-control",
    visibility = ["//visibility:private"],
    deps = [
        "//packages/go/ha",
        "//packages/go/httpapi",
        "//packages/go/scheduler",
        "//solutions/ha-bridge/internal/catalog",
        "//solutions/ha-bridge/internal/catalogapi",
        "//solutions/ha-bridge/internal/control",
        "//solutions/ha-bridge/internal/discovery",
    ],
)

go_test(
    name = "ha-control_test",
    srcs = [
        "config_test.go",
        "healthcheck_test.go",
    ],
    embed = [":ha-control_lib"],
)
