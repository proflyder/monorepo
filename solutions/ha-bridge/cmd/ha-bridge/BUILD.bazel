load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_binary(
    name = "ha-bridge",
    embed = [":ha_bridge_lib"],
    visibility = ["//visibility:public"],
)

go_library(
    name = "ha_bridge_lib",
    srcs = ["main.go"],
    importpath = "ricardo.local/monorepo/solutions/ha-bridge/cmd/ha-bridge",
    visibility = ["//visibility:private"],
    deps = [
        "//solutions/ha-bridge/internal/bridge",
        "//solutions/ha-bridge/internal/config",
        "//solutions/ha-bridge/internal/ha",
        "//solutions/ha-bridge/internal/httpapi",
        "//solutions/ha-bridge/internal/ledger",
        "//solutions/ha-bridge/internal/scheduler",
    ],
)

go_test(
    name = "ha_bridge_test",
    srcs = ["main_test.go"],
    embed = [":ha_bridge_lib"],
)
