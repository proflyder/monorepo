load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_clippy_test", "rust_library", "rust_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

# Kept in sync with [package].version in Cargo.toml.
PACKAGE_VERSION = "0.1.0"

LIB_DEPS = [
    "//packages/rust/home-config:home_config",
    "//packages/rust/home-ha:home_ha",
    "//packages/rust/home-http:home_http",
    "//packages/rust/home-proto:home_proto",
    "//packages/rust/home-runtime:home_runtime",
    "//packages/rust/home-secret:home_secret",
    "//packages/rust/home-telemetry:home_telemetry",
    "//packages/rust/home-worker:home_worker",
    "@crates//:anyhow",
    "@crates//:axum",
    "@crates//:reqwest",
    "@crates//:rustls",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tokio",
    "@crates//:tokio-util",
    "@crates//:tracing",
]

rust_library(
    name = "ha_bridge_lib",
    crate_name = "ha_bridge",
    srcs = glob(
        ["src/**/*.rs"],
        exclude = [
            "src/main.rs",
            "src/ha_control.rs",
        ],
    ),
    edition = "2024",
    lint_config = ":workspace_lints",
    version = PACKAGE_VERSION,
    deps = LIB_DEPS,
)

# The deployed binary. The image rebuilds it for static musl; this target is
# also what host tests and `cargo run -p ha-bridge` use.
rust_binary(
    name = "ha-bridge",
    srcs = ["src/main.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    version = PACKAGE_VERSION,
    deps = LIB_DEPS + [":ha_bridge_lib"],
)

# The second binary of the same crate: the catalog server and the `control`
# queue executor.
rust_binary(
    name = "ha-control",
    srcs = ["src/ha_control.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    version = PACKAGE_VERSION,
    deps = LIB_DEPS + [":ha_bridge_lib"],
)

# The frozen golden vectors live under //solutions/ha-bridge.
rust_test(
    name = "unit_tests",
    crate = ":ha_bridge_lib",
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = LIB_DEPS + [
        "@crates//:tempfile",
    ],
)

rust_test(
    name = "golden_tests",
    srcs = ["tests/golden.rs"],
    data = [
        "//solutions/ha-bridge:catalog_vectors",
        "//solutions/ha-bridge:event_vectors",
        "//solutions/ha-bridge:ledger_vectors",
    ],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = LIB_DEPS + [
        ":ha_bridge_lib",
        "@crates//:tempfile",
        "@crates//:tower",
    ],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rustfmt_test(
    name = "rustfmt",
    targets = [
        ":ha_bridge_lib",
        ":ha-bridge",
        ":ha-control",
        ":golden_tests",
    ],
)

# rules_rust turns every clippy warning into an error, the `-D warnings` gate.
rust_clippy_test(
    name = "clippy",
    targets = [
        ":ha_bridge_lib",
        ":ha-bridge",
        ":ha-control",
        ":golden_tests",
    ],
)
