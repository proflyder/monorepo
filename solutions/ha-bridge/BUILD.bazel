package(default_visibility = ["//visibility:public"])

# The deployed executors are the Rust crate's binaries.
alias(
    name = "ha-bridge",
    actual = "//solutions/ha-bridge/crates/ha-bridge:ha-bridge",
)

alias(
    name = "ha-control",
    actual = "//solutions/ha-bridge/crates/ha-bridge:ha-control",
)

filegroup(
    name = "event_vectors",
    srcs = glob(["testdata/events/*.json"]),
)

filegroup(
    name = "ledger_vectors",
    srcs = ["testdata/ledger/v1.json"],
)

filegroup(
    name = "catalog_vectors",
    srcs = glob(["testdata/catalog/**"]),
)
