load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "bridge",
    srcs = ["bridge.go"],
    importpath = "github.com/proflyder/monorepo/solutions/ha-bridge/internal/bridge",
    visibility = ["//solutions/ha-bridge:__subpackages__"],
    deps = [
        "//packages/go/httpapi",
        "//packages/go/scheduler",
        "//solutions/ha-bridge/internal/config",
        "//solutions/ha-bridge/internal/ledger",
    ],
)

go_test(
    name = "bridge_test",
    srcs = [
        "bridge_test.go",
        "golden_vectors_test.go",
    ],
    embed = [":bridge"],
    data = ["//solutions/ha-bridge:event_vectors"],
    deps = [
        "//packages/go/httpapi",
        "//packages/go/scheduler",
        "//solutions/ha-bridge/internal/config",
        "//solutions/ha-bridge/internal/ledger",
    ],
)
