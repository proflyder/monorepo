load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Credential provider COM in-proc server. `crate_name` makes rustc emit
# `RicardoKompLogon.dll`, the name the install scripts, OCI artifact and
# cp-selftest expect. Windows-only: `src/bindings.rs` is Win32.
rust_shared_library(
    name = "provider",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "RicardoKompLogon",
    edition = "2024",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "//solutions/windows-logon-provider/crates/protocol:logon_protocol",
        "@logon_crates//:windows-core",
        "@logon_crates//:windows-link",
    ],
)

# Host-portable core: log sanitising/rotation, KERB packing, retry/budget
# decisions, FailCount arithmetic and panic containment.
rust_library(
    name = "provider_host",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    # `#[cfg(windows)]` would pull the Windows bindings into a host build.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//solutions/windows-logon-provider/crates/protocol:logon_protocol",
    ],
)

rust_test(
    name = "provider_host_tests",
    crate = ":provider_host",
    edition = "2024",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
