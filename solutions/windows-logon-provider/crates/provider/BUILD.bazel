load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Credential provider COM in-proc server. `crate_name` makes rustc emit
# `RicardoKompLogon.dll`, the name the install scripts, OCI artifact and
# cp-selftest expect. Windows-only: `src/bindings.rs` is Win32.
rust_shared_library(
    name = "provider",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "RicardoKompLogon",
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "//solutions/windows-logon-provider/crates/protocol:logon_protocol",
        "@crates//:thiserror",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        "@crates//:windows-core",
        "@crates//:windows-link",
        "@crates//:zeroize",
    ],
)

# Host-portable core: log sanitising/rotation, KERB packing, retry/budget
# decisions, FailCount arithmetic and panic containment.
rust_library(
    name = "provider_host",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    # `#[cfg(windows)]` would pull the Windows bindings into a host build.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//solutions/windows-logon-provider/crates/protocol:logon_protocol",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "provider_host_tests",
    crate = ":provider_host",
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//solutions/windows-logon-provider/crates/protocol:logon_protocol",
        "@crates//:thiserror",
        "@crates//:zeroize",
    ],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
