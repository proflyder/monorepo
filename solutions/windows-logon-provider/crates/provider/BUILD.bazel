load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_shared_library(
    name = "provider",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "HomeKompLogon",
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "//packages/rust/wakegrant-protocol:wakegrant_protocol",
        "@crates//:http",
        "@crates//:thiserror",
        "@crates//:tracing",
        "@crates//:tracing-subscriber",
        "@crates//:windows-core",
        "@crates//:windows-link",
        "@crates//:zeroize",
    ],
)

rust_library(
    name = "provider_host",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//packages/rust/wakegrant-protocol:wakegrant_protocol",
        "@crates//:http",
        "@crates//:thiserror",
    ],
)

rust_test(
    name = "provider_host_tests",
    size = "small",
    crate = ":provider_host",
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "//packages/rust/wakegrant-protocol:wakegrant_protocol",
        "@crates//:http",
        "@crates//:thiserror",
        "@crates//:zeroize",
    ],
)

extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
