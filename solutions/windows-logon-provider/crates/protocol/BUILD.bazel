load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# Portable wakegrant client logic (v1 and purpose-aware logon/unlock). No
# Windows dependency: it is compiled and tested on the host without a Windows
# toolchain.
rust_library(
    name = "logon_protocol",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = [
        "@crates//:base64",
        "@crates//:hmac",
        "@crates//:http",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:subtle",
        "@crates//:thiserror",
        "@crates//:zeroize",
        "//packages/rust/home-secret:home_secret",
    ],
)

# The protocol suite, including the golden HMAC
# vectors from packages/contracts/wakegrant/PROTOCOL.md.
rust_test(
    name = "logon_protocol_tests",
    srcs = ["tests/protocol.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = [":logon_protocol"],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
