load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

# `cp-selftest.exe`: loads the provider by CLSID (or from the DLL next to the
# executable when it is not registered), prints the field/credential counts and
# stops the background thread immediately.
rust_binary(
    name = "cp-selftest",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    target_compatible_with = ["@platforms//os:windows"],
    deps = ["@logon_crates//:windows"],
)
