load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary")

package(default_visibility = ["//visibility:public"])

# `cp-selftest.exe`: loads the provider by CLSID, or from the DLL next to the
# executable when it is not registered.
rust_binary(
    name = "cp-selftest",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    target_compatible_with = ["@platforms//os:windows"],
    deps = [
        "@crates//:windows-core",
        "@crates//:windows-link",
    ],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
