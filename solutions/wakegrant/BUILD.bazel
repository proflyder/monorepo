load(":images.bzl", "service_image")

package(default_visibility = ["//visibility:public"])

# One static linux/amd64 binary on the digest-pinned distroless base, built
# hermetically without a Docker daemon.
service_image(
    name = "wakegrant",
    binary = "//solutions/wakegrant/cmd/wakegrant",
    repo = "ghcr.io/proflyder/wakegrant",
)

filegroup(
    name = "images",
    srcs = [":wakegrant_image"],
    visibility = ["//visibility:public"],
)
