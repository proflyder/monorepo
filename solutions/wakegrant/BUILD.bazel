load("//platform/bazel/oci:service_image.bzl", "rust_service_image")

package(default_visibility = ["//visibility:public"])

# Static x86_64-unknown-linux-musl binary (zig cc linker, bundled SQLite) on
# the same digest-pinned distroless static base as the Go services.
rust_service_image(
    name = "wakegrant",
    crate_binary = "//solutions/wakegrant/crates/wakegrant:wakegrant",
    repo = "ghcr.io/proflyder/wakegrant",
)

filegroup(
    name = "contract_fixtures",
    srcs = glob(["testdata/contract/*.json"]),
)

filegroup(
    name = "images",
    srcs = [":wakegrant_image"],
    visibility = ["//visibility:public"],
)
