# Hermetic zig 0.14.1 cc toolchains for the two station ABIs and the Windows
# provider. Only these target-constrained toolchains are registered, so host
# builds keep using the host compiler. See platform/bazel/zig/.
bazel_dep(name = "rules_cc", version = "0.2.17")

zig_sdk_repository = use_repo_rule("//platform/bazel/zig:repositories.bzl", "zig_sdk_repository")

zig_sdk_repository(name = "zig_0_14_1")

register_toolchains(
    "@zig_0_14_1//:aarch64_toolchain",
    "@zig_0_14_1//:armhf_toolchain",
    "@zig_0_14_1//:windows_x86_64_toolchain",
    "@zig_0_14_1//:x86_64_musl_toolchain",
)

# External crates of the single first-party Cargo workspace (/Cargo.toml).
# Cargo.lock stays the source of truth: a Cargo.toml/Cargo.lock change repins
# the generated Bazel lock `//:crate-universe.lock` (see
# projects/station/pulsar/docs/development.md, «Bazel»). Host triples keep the
# portable tests buildable on macOS/Linux; the station triples build the
# deployed daemons and the windows triple builds the credential-provider DLL.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:crate-universe.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "armv7-unknown-linux-gnueabihf",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "crates")

# ---------------------------------------------------------------------------
# Android / Kotlin (projects/mobile/android)
#
# The Android SDK is discovered from ANDROID_HOME. It is deliberately not
# committed as a machine-specific path; see projects/mobile/android/README.md.
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_android", version = "0.7.3")

# Direct dep only to load `JavaInfo` in platform/android/lint.bzl; it is the
# version rules_android already resolves.
bazel_dep(name = "rules_java", version = "9.3.0")
bazel_dep(name = "rules_kotlin", version = "2.4.20")
bazel_dep(name = "rules_jvm_external", version = "7.1")

# Packaging gate (platform/android) is a shell test; Bazel 9 no longer ships
# native sh_test.
bazel_dep(name = "rules_shell", version = "0.6.1")

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
android_sdk_repository_extension.configure(
    api_level = 36,
    build_tools_version = "36.0.0",
)
use_repo(android_sdk_repository_extension, "androidsdk")

register_toolchains(
    "@androidsdk//:sdk-toolchain",
    "@androidsdk//:all",
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "androidx.activity:activity-ktx:1.9.3",
        "androidx.appcompat:appcompat:1.7.0",
        "androidx.core:core-ktx:1.13.1",
        "androidx.datastore:datastore-preferences:1.1.1@aar",
        "androidx.emoji2:emoji2:1.5.0",
        "androidx.emoji2:emoji2-views-helper:1.5.0",
        "androidx.fragment:fragment-ktx:1.8.5",
        "androidx.lifecycle:lifecycle-common:2.8.7",
        "androidx.lifecycle:lifecycle-livedata:2.8.7",
        "androidx.lifecycle:lifecycle-livedata-core:2.8.7",
        "androidx.lifecycle:lifecycle-livedata-ktx:2.8.7",
        "androidx.lifecycle:lifecycle-process:2.8.7",
        "androidx.lifecycle:lifecycle-runtime:2.8.7",
        "androidx.lifecycle:lifecycle-runtime-ktx:2.8.7",
        "androidx.lifecycle:lifecycle-viewmodel:2.8.7",
        "androidx.lifecycle:lifecycle-viewmodel-ktx:2.8.7",
        "androidx.lifecycle:lifecycle-viewmodel-savedstate:2.8.7",
        # Referenced by Room (via Chucker); pinned so the APK runtime closure is complete.
        "androidx.paging:paging-common:2.1.2",
        "androidx.recyclerview:recyclerview:1.3.2",
        "androidx.swiperefreshlayout:swiperefreshlayout:1.1.0",
        "com.google.android.material:material:1.12.0",
        # Firebase Crashlytics, pinned from Firebase BoM 33.16.0 (Gradle BOMs
        # cannot be consumed by rules_jvm_external, so versions are explicit).
        # BoM 34+ pulls datastore-preferences 1.1.7, a Kotlin-multiplatform
        # artifact whose placeholder jar the coursier resolver cannot fetch;
        # this BoM is the latest one that keeps the pinned datastore version.
        "com.google.firebase:firebase-annotations:16.2.0",
        "com.google.firebase:firebase-common:21.0.0",
        "com.google.firebase:firebase-components:18.0.0",
        "com.google.firebase:firebase-config-interop:16.0.1",
        # Remote Config (endpoints/timeouts): firebase-config is pinned from the
        # same BoM; abt is its A/B-testing runtime dependency (from the
        # firebase-config POM) and must ship in the APK closure.
        "com.google.firebase:firebase-abt:21.1.1",
        "com.google.firebase:firebase-config:22.1.2",
        "com.google.firebase:firebase-crashlytics:19.4.4",
        "com.google.firebase:firebase-encoders:17.0.0",
        "com.google.firebase:firebase-encoders-json:18.0.1",
        "com.google.firebase:firebase-installations:18.0.0",
        "com.google.firebase:firebase-installations-interop:17.2.0",
        "com.google.firebase:firebase-measurement-connector:20.0.1",
        "com.google.firebase:firebase-sessions:2.1.2",
        # Guava is only a Robolectric (test) dependency. Without an explicit
        # pin, Maven selects Guava's empty `9999.0-empty-to-avoid-conflict-with-guava`
        # placeholder for androidx.concurrent.futures, leaving ListenableFuture
        # out of the APK while AbstractResolvableFuture ships. Pin the real
        # standalone artifact so the runtime closure is self-contained.
        "com.google.guava:listenablefuture:1.0",
        # Runtime dependencies of firebase-crashlytics not otherwise pinned.
        "com.google.android.datatransport:transport-api:3.2.0",
        "com.google.android.datatransport:transport-backend-cct:3.3.0",
        "com.google.android.datatransport:transport-runtime:3.3.0",
        "com.google.android.gms:play-services-basement:18.3.0",
        "com.google.android.gms:play-services-tasks:18.1.0",
        "com.github.chuckerteam.chucker:library:4.0.0",
        "com.squareup.okhttp3:logging-interceptor:4.12.0",
        "com.squareup.okhttp3:mockwebserver:4.12.0",
        "com.squareup.okhttp3:okhttp:4.12.0",
        "com.squareup.retrofit2:retrofit:2.11.0",
        "dev.zacsweers.metro:compiler:1.5.0",
        "dev.zacsweers.metro:runtime-jvm:1.5.0",
        "junit:junit:4.13.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-play-services:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test:1.10.2",
        "org.jetbrains.kotlinx:kotlinx-serialization-json:1.9.0",
        "org.robolectric:android-all-instrumented:15-robolectric-13954326-i7",
        "org.robolectric:robolectric:4.17",
    ],
    known_contributing_modules = ["protobuf"],
    lock_file = "//projects/mobile/android:maven_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
    version_conflict_policy = "pinned",
)
use_repo(maven, "maven")
