module(
    name = "yandex_station_lab",
    version = "0.1.0",
)

bazel_dep(name = "rules_rust", version = "0.75.0")

# rules_rust omits the *-windows-gnu triples because Bazel cannot distinguish
# them from *-windows-msvc through @platforms constraints. The credential
# provider builds only the gnu ABI, so two small patches add the triple back and
# gate the MSVC-only cdylib import library; see the patch headers.
single_version_override(
    module_name = "rules_rust",
    patch_strip = 1,
    patches = [
        "//platform/bazel/zig:rules_rust_musl_triples.patch",
        "//platform/bazel/windows:rules_rust_windows_gnu_triples.patch",
        "//platform/bazel/windows:rules_rust_windows_gnu_rustc.patch",
    ],
)

bazel_dep(name = "rules_proto", version = "7.1.0")

# Target constraints for the Linux-only Pulsar Rust targets.
bazel_dep(name = "platforms", version = "1.1.0")

# Direct dep only to name its build setting in .bazelrc (`@protobuf//...`);
# same version the graph already resolves.
bazel_dep(name = "protobuf", version = "36.2")

# Container images for the home K3s services. Images are assembled
# hermetically (no Docker daemon, no RUN steps) from the Rust service binaries
# and a digest-pinned distroless base; the same targets build on macOS and on
# the GitHub runner.
bazel_dep(name = "rules_oci", version = "2.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "distroless_static",
    # Multi-arch index digest of the tag `nonroot`; the amd64 child below is
    # what the linux/amd64 images actually build on. `bazel run
    # @distroless_static//:digest` re-prints the pinned index digest.
    digest = "sha256:afa5c872c891853ca7fcf1f12c3edb23f7eeef36189728842dd51042ff57f7ab",
    image = "gcr.io/distroless/static-debian12",
    platforms = ["linux/amd64"],
)
use_repo(oci, "distroless_static", "distroless_static_linux_amd64")

# Rust: one Cargo workspace for every first-party crate (Pulsar, BLE gateway,
# Windows logon provider, station helper; see /Cargo.toml). The toolchain
# version is the one pinned in /rust-toolchain.toml; edition per crate comes
# from Cargo.toml (workspace edition 2024).
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_rustc_flags_triples = {
        # The former Makefile/cargo-zigbuild flags: non-PIE keeps crash-report addresses
        # absolute, frame pointers feed the aarch64 fp: chain, and cortex-a53 is
        # the same core as the C++ build (hardware vfma for mul_add).
        #
        # `-c opt` defaults to strip=debuginfo/debuginfo=0; the Cargo release
        # profile keeps line tables for `addr2line -e pulsar.debug`, so the
        # station triples restore them (these flags are appended after the
        # compilation-mode ones).
        "aarch64-unknown-linux-gnu": [
            "-C",
            "relocation-model=static",
            "-C",
            "force-frame-pointers=yes",
            "-C",
            "debuginfo=1",
            "-C",
            "strip=none",
            # Bitcode for the binary's `-C lto=thin`. panic stays at the
            # default unwind: the same triple builds host tests, and tests
            # cannot use panic=abort (see the station size note in
            # docs/development.md).
            "-C",
            "embed-bitcode=yes",
        ],
        "armv7-unknown-linux-gnueabihf": [
            "-C",
            "relocation-model=static",
            "-C",
            "force-frame-pointers=yes",
            "-C",
            "target-cpu=cortex-a53",
            "-C",
            "debuginfo=1",
            "-C",
            "strip=none",
            "-C",
            "embed-bitcode=yes",
        ],
    },
    # Host tools (process_wrapper, lint runners, build-script runners) are
    # linked through the auto-configured cc toolchain. On Linux that toolchain
    # may select GNU gold, which rustc 1.97+ warns is deprecated and buggy with
    # Rust. Force binutils ld (bfd) for exec/host links only; the station
    # triples keep the hermetic zig linker from platform/bazel/zig.
    extra_exec_rustc_flags_triples = {
        "x86_64-unknown-linux-gnu": [
            "-C",
            "link-arg=-fuse-ld=bfd",
        ],
    },
    extra_target_triples = [
        "aarch64-unknown-linux-gnu",
        "armv7-unknown-linux-gnueabihf",
        # Windows credential provider (solutions/windows-logon-provider); the
        # platform that selects it is //platform/bazel/windows:x86_64_windows.
        "x86_64-pc-windows-gnu",
    ],
    versions = ["1.99.1"],
)

# Static musl service images (wakegrant and the other home services).
# rules_rust gives x86_64-unknown-linux-musl the same constraints as the glibc
# host triple (os:linux + cpu:x86_64), so on a Linux exec host the glibc
# toolchain also matched //platform/bazel/zig:x86_64_musl_linux and won by
# registration order (glibc std, undefined `gnu_get_libc_version`). These
# repository sets require the zig `musl` constraint, so host builds never see
# them, and they are registered before `@rust_toolchains//:all` so the musl
# platform always resolves to them. One set per exec host: CI (Linux x86_64)
# and the Mac (Apple silicon).
[
    rust.repository_set(
        name = "rust_musl_" + exec_name,
        edition = "2024",
        exec_triple = exec_triple,
        # The zig cc driver owns the musl crt/libc; telling rustc not to add
        # its self-contained copy avoids a duplicate `_start`.
        extra_rustc_flags = [
            "-C",
            "link-self-contained=no",
        ],
        target_compatible_with = [
            "@platforms//cpu:x86_64",
            "@platforms//os:linux",
            "@zig_0_14_1//:musl",
        ],
        target_triple = "x86_64-unknown-linux-musl",
        versions = ["1.99.1"],
    )
    for exec_name, exec_triple in [
        ("linux_x86_64", "x86_64-unknown-linux-gnu"),
        ("darwin_aarch64", "aarch64-apple-darwin"),
    ]
]

use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:rust_musl_linux_x86_64__x86_64-unknown-linux-musl__stable",
    "@rust_toolchains//:rust_musl_darwin_aarch64__x86_64-unknown-linux-musl__stable",
    "@rust_toolchains//:all",
)

