# Hermetic zig 0.14.1 cc toolchains for the two station ABIs and the Windows
# provider. Only these target-constrained toolchains are registered, so host
# builds keep using the host compiler. See platform/bazel/zig/.
bazel_dep(name = "rules_cc", version = "0.2.28")

zig_sdk_repository = use_repo_rule("//platform/bazel/zig:repositories.bzl", "zig_sdk_repository")

zig_sdk_repository(name = "zig_0_14_1")

register_toolchains(
    "@zig_0_14_1//:aarch64_toolchain",
    "@zig_0_14_1//:armhf_toolchain",
    "@zig_0_14_1//:windows_x86_64_toolchain",
    "@zig_0_14_1//:x86_64_musl_toolchain",
)

# External crates of the single first-party Cargo workspace (/Cargo.toml).
# Cargo.lock stays the source of truth: a Cargo.toml/Cargo.lock change repins
# the generated Bazel lock `//:crate-universe.lock` (see
# projects/station/pulsar/docs/development.md, «Bazel»). Host triples keep the
# portable tests buildable on macOS/Linux; the station triples build the
# deployed daemons and the windows triple builds the credential-provider DLL.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:crate-universe.lock",
    manifests = ["//:Cargo.toml"],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "armv7-unknown-linux-gnueabihf",
        "x86_64-apple-darwin",
        "x86_64-pc-windows-gnu",
        "x86_64-unknown-linux-gnu",
        "x86_64-unknown-linux-musl",
    ],
)
use_repo(crate, "crates")

# ---------------------------------------------------------------------------
# Android / Kotlin (projects/mobile/android)
#
# The Android SDK is discovered from ANDROID_HOME. It is deliberately not
# committed as a machine-specific path; see projects/mobile/android/README.md.
# ---------------------------------------------------------------------------
bazel_dep(name = "rules_android", version = "0.8.1")

# Direct dep only to load `JavaInfo` in platform/android/lint.bzl; it is the
# version rules_android already resolves.
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "rules_kotlin", version = "2.4.21")
bazel_dep(name = "rules_jvm_external", version = "7.2")

# The coursier lock file normally lists every configured repository for every
# artifact, so a cold build probes Google Maven for Central-only artifacts and
# logs a 404 WARNING per artifact. The patch records only the repository that
# actually served each artifact; see the patch header.
single_version_override(
    module_name = "rules_jvm_external",
    patch_strip = 1,
    patches = ["//platform/bazel:rules_jvm_external_primary_repository.patch"],
)

# Packaging gate (platform/android) is a shell test; Bazel 9 no longer ships
# native sh_test.
bazel_dep(name = "rules_shell", version = "0.8.0")

remote_android_extensions = use_extension(
    "@rules_android//bzlmod_extensions:android_extensions.bzl",
    "remote_android_tools_extensions",
)
use_repo(remote_android_extensions, "android_tools")

android_sdk_repository_extension = use_extension(
    "@rules_android//rules/android_sdk_repository:rule.bzl",
    "android_sdk_repository_extension",
)
android_sdk_repository_extension.configure(
    api_level = 36,
    build_tools_version = "36.0.0",
)
use_repo(android_sdk_repository_extension, "androidsdk")

register_toolchains(
    "@androidsdk//:sdk-toolchain",
    "@androidsdk//:all",
)

# C++ toolchain for the target Android platform. `android_binary` always
# resolves `@rules_cc//cc:current_cc_toolchain` for every platform in
# `--android_platforms` (rules_android links client native deps and, even
# without cc_library deps, needs the toolchain for the split config). Without an
# NDK toolchain, the `build:android
# --android_platforms=//platform/android:android_arm64` flag in
# platform/android/android.bazelrc fails analysis with "Unable to find a CC
# toolchain".
#
# The repository rule reads the NDK from the ANDROID_NDK_HOME environment
# variable; install it from the official SDK with
# `sdkmanager "ndk;28.2.13676358"` (CI installs it via sdk_packages of the
# android-app/android-lint units in `_android.yml`, and in deploy-home
# `warm-caches`). `api_level` matches the app's minSdkVersion (26); see
# projects/mobile/android/app/src/main/AndroidManifest.xml.
bazel_dep(name = "rules_android_ndk", version = "0.1.5")

android_ndk_repository_extension = use_extension(
    "@rules_android_ndk//:extension.bzl",
    "android_ndk_repository_extension",
)
android_ndk_repository_extension.configure(api_level = 26)
use_repo(android_ndk_repository_extension, "androidndk")

register_toolchains("@androidndk//:all")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    aar_import_bzl_label = "@rules_android//rules:rules.bzl",
    artifacts = [
        "androidx.activity:activity-ktx:1.13.0",
        "androidx.appcompat:appcompat:1.8.0",
        "androidx.core:core-ktx:1.19.1",
        "androidx.datastore:datastore-preferences:1.3.0@aar",
        "androidx.emoji2:emoji2:1.7.0",
        "androidx.emoji2:emoji2-views-helper:1.7.0",
        "androidx.fragment:fragment-ktx:1.9.1",
        "androidx.lifecycle:lifecycle-common:2.11.0",
        "androidx.lifecycle:lifecycle-livedata:2.11.0",
        "androidx.lifecycle:lifecycle-livedata-core:2.11.0",
        "androidx.lifecycle:lifecycle-livedata-ktx:2.11.0",
        "androidx.lifecycle:lifecycle-process:2.11.0",
        "androidx.lifecycle:lifecycle-runtime:2.11.0",
        "androidx.lifecycle:lifecycle-runtime-ktx:2.11.0",
        "androidx.lifecycle:lifecycle-viewmodel:2.11.0",
        "androidx.lifecycle:lifecycle-viewmodel-ktx:2.11.0",
        "androidx.lifecycle:lifecycle-viewmodel-savedstate:2.11.0",
        # Referenced by Room (via Chucker); pinned so the APK runtime closure is complete.
        "androidx.paging:paging-common:3.5.3",
        "androidx.recyclerview:recyclerview:1.4.0",
        # activity 1.13 wants savedstate 1.2.1 while lifecycle 2.11 resolves
        # 1.4.0; the pinned conflict policy needs an explicit pin.
        "androidx.savedstate:savedstate:1.4.0",
        "androidx.swiperefreshlayout:swiperefreshlayout:1.2.0",
        "com.google.android.material:material:1.14.0",
        # Firebase Crashlytics, pinned from Firebase BoM 35.1.0 (Gradle BOMs
        # cannot be consumed by rules_jvm_external, so versions are explicit).
        "com.google.firebase:firebase-annotations:18.0.0",
        "com.google.firebase:firebase-common:23.0.0",
        "com.google.firebase:firebase-components:20.0.0",
        "com.google.firebase:firebase-config-interop:17.0.0",
        # Remote Config (endpoints/timeouts): firebase-config is pinned from the
        # same BoM; abt is its A/B-testing runtime dependency (from the
        # firebase-config POM) and must ship in the APK closure.
        "com.google.firebase:firebase-abt:24.0.0",
        "com.google.firebase:firebase-config:24.0.1",
        "com.google.firebase:firebase-crashlytics:21.0.1",
        "com.google.firebase:firebase-encoders:18.0.0",
        "com.google.firebase:firebase-encoders-json:19.0.0",
        "com.google.firebase:firebase-installations:20.0.0",
        "com.google.firebase:firebase-installations-interop:18.0.0",
        "com.google.firebase:firebase-measurement-connector:18.0.0",
        "com.google.firebase:firebase-sessions:4.0.1",
        # Guava is only a Robolectric (test) dependency. Without an explicit
        # pin, Maven selects Guava's empty `9999.0-empty-to-avoid-conflict-with-guava`
        # placeholder for androidx.concurrent.futures, leaving ListenableFuture
        # out of the APK while AbstractResolvableFuture ships. Pin the real
        # standalone artifact so the runtime closure is self-contained.
        "com.google.guava:listenablefuture:1.0",
        # Runtime dependencies of firebase-crashlytics not otherwise pinned.
        "com.google.android.datatransport:transport-api:5.0.0",
        "com.google.android.datatransport:transport-backend-cct:5.0.0",
        "com.google.android.datatransport:transport-runtime:5.0.0",
        "com.google.android.gms:play-services-basement:18.12.0",
        "com.google.android.gms:play-services-tasks:18.4.1",
        "com.github.chuckerteam.chucker:library:4.3.1",
        "com.squareup.okhttp3:logging-interceptor:5.5.1",
        "com.squareup.okhttp3:mockwebserver:5.5.1",
        "com.squareup.okhttp3:okhttp:5.5.1",
        "com.squareup.retrofit2:retrofit:3.0.0",
        "com.squareup.retrofit2:converter-kotlinx-serialization:3.0.0",
        # Detekt static analysis for the Android client: CLI + formatting rules
        # run as //projects/mobile/android:detekt; api/test back the first-party
        # `home-rules` ruleset under platform/android/detekt-rules.
        "io.gitlab.arturbosch.detekt:detekt-api:1.23.8",
        "io.gitlab.arturbosch.detekt:detekt-cli:1.23.8",
        "io.gitlab.arturbosch.detekt:detekt-formatting:1.23.8",
        "io.gitlab.arturbosch.detekt:detekt-test:1.23.8",
        # Prebuilt libwebrtc for Android (audio-only PeerConnection, Opus,
        # hardware AEC/NS/AGC through JavaAudioDeviceModule). Apache-2.0.
        "io.getstream:stream-webrtc-android:1.3.10",
        "dev.zacsweers.metro:compiler:1.5.2",
        "dev.zacsweers.metro:runtime-jvm:1.5.2",
        "junit:junit:4.13.2",
        "org.jetbrains.kotlinx:kotlinx-coroutines-android:1.11.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core:1.11.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-play-services:1.11.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test:1.11.0",
        "org.jetbrains.kotlinx:kotlinx-serialization-core:1.12.0",
        "org.jetbrains.kotlinx:kotlinx-serialization-json:1.12.0",
        "org.jetbrains.kotlin:kotlin-serialization-compiler-plugin-embeddable:2.4.21",
        "org.robolectric:android-all-instrumented:15-robolectric-13954326-i7",
        "org.robolectric:robolectric:4.17",
    ],
    # datastore 1.3.0 is a KMP module whose root artifact is published as an
    # AAR; the root jar cannot be fetched (the Android variant
    # datastore-android is used instead), so exclude the metadata-only root.
    excluded_artifacts = ["androidx.datastore:datastore"],
    known_contributing_modules = ["protobuf"],
    lock_file = "//projects/mobile/android:maven_install.json",
    repositories = [
        "https://maven.google.com",
        "https://repo1.maven.org/maven2",
    ],
    use_starlark_android_rules = True,
    version_conflict_policy = "pinned",
)

# OkHttp 5 is a Kotlin-multiplatform module: the root `okhttp` jar only
# carries metadata, the real classes are in `okhttp-jvm`.
maven.override(
    name = "maven",
    coordinates = "com.squareup.okhttp3:okhttp",
    target = "@maven//:com_squareup_okhttp3_okhttp_jvm",
)
use_repo(maven, "maven")
