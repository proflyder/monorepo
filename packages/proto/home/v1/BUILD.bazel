load("@protobuf//bazel:proto_library.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])


proto_library(
    name = "alarms_proto",
    srcs = ["alarms.proto"],
)

proto_library(
    name = "text_proto",
    srcs = ["text.proto"],
    strip_import_prefix = "/packages/proto/home/v1",
)

proto_library(
    name = "scheduler_proto",
    srcs = ["scheduler.proto"],
    deps = [":text_proto"],
    strip_import_prefix = "/packages/proto/home/v1",
)

proto_library(
    name = "scenario_proto",
    srcs = ["scenario.proto"],
    deps = [":scheduler_proto"],
    strip_import_prefix = "/packages/proto/home/v1",
)

proto_library(
    name = "intercom_proto",
    srcs = ["intercom.proto"],
    strip_import_prefix = "/packages/proto/home/v1",
)

filegroup(
    name = "protos",
    srcs = glob(["*.proto"]),
)
