load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_library", "kt_jvm_test")

package(default_visibility = ["//visibility:public"])

kt_jvm_library(
    name = "core",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    deps = ["@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core"],
)

kt_jvm_test(
    name = "core_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    test_class = "dev.proflyder.home.core.AllCoreTests",
    deps = [
        ":core",
        "@maven//:junit_junit",
    ],
)

kt_jvm_test(
    name = "operation_test",
    srcs = [
        "src/test/kotlin/dev/proflyder/home/core/operation/EditorCompletionTest.kt",
        "src/test/kotlin/dev/proflyder/home/core/operation/IdempotentRequestKeyTest.kt",
        "src/test/kotlin/dev/proflyder/home/core/operation/OperationTestSuite.kt",
    ],
    test_class = "dev.proflyder.home.core.operation.OperationTestSuite",
    deps = [
        ":core",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_coroutines_core",
    ],
)
