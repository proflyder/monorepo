load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "@crates//:clap",
    "@crates//:thiserror",
    "//packages/rust/home-secret:home_secret",
]

rust_library(
    name = "home_config",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

rust_test(
    name = "unit_tests",
    size = "small",
    crate = ":home_config",
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
