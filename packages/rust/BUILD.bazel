load("@rules_rust//rust:defs.bzl", "rust_clippy_test", "rustfmt_test")

package(default_visibility = ["//visibility:public"])

# Host checks for the shared core layer. Consumers (ble-gateway today, Pulsar
# and the logon provider later) list these targets in their CI unit.
_ALL_TARGETS = [
    "//packages/rust/home-actor:home_actor",
    "//packages/rust/home-actor:unit_tests",
    "//packages/rust/home-config:home_config",
    "//packages/rust/home-config:unit_tests",
    "//packages/rust/home-contracttest:home_contracttest",
    "//packages/rust/home-contracttest:unit_tests",
    "//packages/rust/home-ha:home_ha",
    "//packages/rust/home-ha:unit_tests",
    "//packages/rust/home-http:home_http",
    "//packages/rust/home-http:unit_tests",
    "//packages/rust/home-linux:home_linux",
    "//packages/rust/home-linux:unit_tests",
    "//packages/rust/home-proto:home_proto",
    "//packages/rust/home-proto:unit_tests",
    "//packages/rust/home-runtime:home_runtime",
    "//packages/rust/home-runtime:unit_tests",
    "//packages/rust/home-secret:home_secret",
    "//packages/rust/home-secret:unit_tests",
    "//packages/rust/home-sqlite:home_sqlite",
    "//packages/rust/home-sqlite:unit_tests",
    "//packages/rust/home-telemetry:home_telemetry",
    "//packages/rust/home-telemetry:unit_tests",
    "//packages/rust/home-worker:home_worker",
    "//packages/rust/home-worker:unit_tests",
    "//packages/rust/voice-contract:unit_tests",
    "//packages/rust/voice-contract:voice_contract",
    "//packages/rust/wakegrant-protocol:wakegrant_protocol",
    "//packages/rust/wakegrant-protocol:protocol_tests",
]

rustfmt_test(
    name = "rustfmt",
    targets = _ALL_TARGETS,
)

# rules_rust turns every clippy warning into an error unless configured
# otherwise, which is the `-D warnings` gate.
rust_clippy_test(
    name = "clippy",
    targets = _ALL_TARGETS,
)
