load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "@crates//:buffa",
    "@crates//:connectrpc",
    "@crates//:http",
    "@crates//:reqwest",
    "@crates//:rustls",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "//packages/rust/home-secret:home_secret",
]

rust_library(
    name = "home_proto",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    tags = ["no_rustfmt"],
    deps = DEPS,
)

rust_test(
    name = "unit_tests",
    size = "small",
    crate = ":home_proto",
    compile_data = ["testdata/test-ca.pem"],
    edition = "2024",
    lint_config = ":workspace_lints",
    tags = ["no_rustfmt"],
    deps = DEPS + [
        "@crates//:axum",
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
