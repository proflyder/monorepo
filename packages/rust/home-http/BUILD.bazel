load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "@crates//:axum",
    "@crates//:http",
    "@crates//:tokio",
    "@crates//:tokio-util",
    "@crates//:tower",
    "@crates//:tower-http",
    "@crates//:serde_json",
    "@crates//:tracing",
    "//packages/rust/home-secret:home_secret",
]

rust_library(
    name = "home_http",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

rust_test(
    name = "unit_tests",
    size = "small",
    crate = ":home_http",
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
