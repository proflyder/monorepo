load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

# axum middleware/layers used by the home services: bearer auth, health,
# body-size limit, request timeout and graceful serving.
DEPS = [
    "@crates//:axum",
    "@crates//:http",
    "@crates//:tokio",
    "@crates//:tokio-util",
    "@crates//:tower",
    "@crates//:tower-http",
    "@crates//:serde_json",
    "@crates//:tracing",
    "//packages/rust/home-secret:home_secret",
]

rust_library(
    name = "home_http",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

rust_test(
    name = "unit_tests",
    crate = ":home_http",
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
