load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "wakegrant_protocol",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = [
        "@crates//:base64",
        "@crates//:hmac",
        "@crates//:serde",
        "@crates//:serde_json",
        "@crates//:sha2",
        "@crates//:subtle",
        "@crates//:thiserror",
        "@crates//:zeroize",
        "//packages/rust/home-secret:home_secret",
    ],
)

rust_test(
    name = "protocol_tests",
    size = "small",
    srcs = ["tests/protocol.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = [":wakegrant_protocol"],
)

extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
