load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "@crates//:axum",
    "@crates//:base64",
    "@crates//:http",
    "@crates//:http-body-util",
    "@crates//:serde",
    "@crates//:serde_json",
    "@crates//:thiserror",
    "@crates//:tower",
]

rust_library(
    name = "home_contracttest",
    srcs = ["src/lib.rs"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

rust_test(
    name = "unit_tests",
    crate = ":home_contracttest",
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS + [
        "@crates//:tempfile",
        "@crates//:tokio",
    ],
)

# Mirrors the root [workspace.lints] through the crate's `[lints] workspace = true`.
extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)
