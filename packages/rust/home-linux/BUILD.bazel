load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

DEPS = [
    "@crates//:libc",
    "@crates//:rustix",
    "@crates//:tokio",
]

rust_library(
    name = "home_linux",
    srcs = glob(["src/**/*.rs"]),
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

rust_test(
    name = "unit_tests",
    size = "small",
    crate = ":home_linux",
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)

extract_cargo_lints(
    name = "workspace_lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

rust_library(
    name = "home_linux_testing",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "home_linux",
    crate_features = ["testing"],
    edition = "2024",
    lint_config = ":workspace_lints",
    deps = DEPS,
)
