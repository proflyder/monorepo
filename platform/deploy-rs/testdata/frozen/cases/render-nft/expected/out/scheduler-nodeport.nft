#!/usr/bin/env bash
# Minimal exposure for the scheduler, control and intercom NodePorts.
#
# This file is a TEMPLATE: deploy.sh substitutes the real LAN CIDR from an
# ignored env file. The published file keeps TEST-NET placeholders.
#
# NodePort traffic is DNATed by kube-proxy before the input hook, so an
# `input` filter never sees the packet. The rule therefore lives in
# `prerouting` at priority dstnat - 10, i.e. before Kubernetes NAT. The
# destination scope is the node itself; the source scope is the home LAN and
# the pod network.
#
# IPv4 only: the cluster service is single-stack. Any IPv6 NodePort hit is
# dropped explicitly instead of silently bypassing the filter.
#
# Install on the K3s node:
#   nft -f /etc/home/scheduler-nodeport.nft
# Remove with:
#   nft delete table inet home_scheduler
table inet home_scheduler {
  chain prerouting {
    type filter hook prerouting priority dstnat - 10; policy accept;
    iifname "lo" accept
    meta nfproto ipv6 tcp dport { 30098, 30099, 30097 } drop
    ip daddr 192.0.2.27 tcp dport { 30098, 30099, 30097 } ip saddr != { 192.0.2.0/24, 10.42.0.0/16 } drop
  }
}
