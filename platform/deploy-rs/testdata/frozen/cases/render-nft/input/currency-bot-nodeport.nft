#!/usr/bin/env bash
# Minimal exposure for the currency-bot API NodePort used by HA Assist.
#
# This file is a TEMPLATE: apply.sh substitutes the real LAN CIDR and NodePort
# from an ignored env file. The published file keeps TEST-NET placeholders.
#
# NodePort traffic is DNATed by kube-proxy before the input hook, so an
# `input` filter never sees the packet. The rule therefore lives in
# `prerouting` at priority dstnat - 10, i.e. before Kubernetes NAT. The
# destination scope is the node itself; the source scope is the home LAN and
# the pod network. This is the same shape as the scheduler NodePort filter.
#
# IPv4 only: the cluster service is single-stack. Any IPv6 NodePort hit is
# dropped explicitly instead of silently bypassing the filter.
#
# Install on the K3s node:
#   nft -f /etc/home-currency-bot-nodeport.nft
# Remove with:
#   nft delete table inet home_currency_bot
table inet home_currency_bot {
  chain prerouting {
    type filter hook prerouting priority dstnat - 10; policy accept;
    iifname "lo" accept
    meta nfproto ipv6 tcp dport { ${CURRENCY_BOT_NODE_PORT} } drop
    ip daddr ${NODE_LAN_IP} tcp dport { ${CURRENCY_BOT_NODE_PORT} } ip saddr != { ${LAN_CIDR}, 10.42.0.0/16 } drop
  }
}
