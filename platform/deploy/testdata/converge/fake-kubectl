#!/usr/bin/env bash
# Fake kubectl for the converge parity test.
#
# It records every invocation so the Go test can compare its behaviour with the
# trace the Python converge.py produced for the same inputs:
#   $TRACE_DIR/<n>.argv      one argv element per line (`-f FILE` becomes
#                            `-f <payload>` so a random temp path never leaks
#                            into the fixture)
#   $TRACE_DIR/<n>.payload   a copy of the `-f` file, when there is one
#
# FAKE_LIVE points at a JSON file with the live Deployment; when it is unset or
# missing, `get deployment` fails like a not-found object.
set -euo pipefail

: "${TRACE_DIR:?TRACE_DIR must be set}"
mkdir -p "$TRACE_DIR"
index=$(find "$TRACE_DIR" -maxdepth 1 -name '*.argv' | wc -l | tr -d ' ')
argv_file="$TRACE_DIR/$index.argv"
payload_file="$TRACE_DIR/$index.payload"
: >"$argv_file"

previous=
for argument in "$@"; do
  if [[ "$previous" == "-f" ]]; then
    cp "$argument" "$payload_file"
    printf '%s\n' '<payload>' >>"$argv_file"
  else
    printf '%s\n' "$argument" >>"$argv_file"
  fi
  previous=$argument
done

joined=" $* "
case "$joined" in
  *" get deployment "*)
    if [[ -n "${FAKE_LIVE:-}" && -f "$FAKE_LIVE" ]]; then
      cat "$FAKE_LIVE"
      exit 0
    fi
    echo "Error from server (NotFound): deployments.apps not found" >&2
    exit 1
    ;;
  *)
    echo "ok"
    exit 0
    ;;
esac
