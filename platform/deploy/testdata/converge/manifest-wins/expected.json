[
  {
    "argv": [
      "-n",
      "home-assistant",
      "get",
      "deployment",
      "ha-bridge",
      "-o",
      "json"
    ],
    "payload": []
  },
  {
    "argv": [
      "-n",
      "home-assistant",
      "replace",
      "-f",
      "<payload>"
    ],
    "payload": [
      {
        "apiVersion": "apps/v1",
        "kind": "Deployment",
        "metadata": {
          "name": "ha-bridge",
          "namespace": "home-assistant",
          "labels": {
            "app.kubernetes.io/name": "ha-bridge"
          },
          "resourceVersion": "12345"
        },
        "spec": {
          "replicas": 0,
          "strategy": {
            "type": "Recreate"
          },
          "selector": {
            "matchLabels": {
              "app.kubernetes.io/name": "ha-bridge"
            }
          },
          "template": {
            "spec": {
              "containers": [
                {
                  "name": "ha-bridge",
                  "image": "ghcr.io/proflyder/ha-bridge@sha256:aaa",
                  "env": [
                    {
                      "name": "BRIDGE_EXECUTE",
                      "value": "false"
                    }
                  ],
                  "volumeMounts": [
                    {
                      "name": "data",
                      "mountPath": "/data"
                    }
                  ]
                }
              ],
              "volumes": [
                {
                  "name": "data",
                  "persistentVolumeClaim": {
                    "claimName": "ha-bridge-data"
                  }
                }
              ]
            }
          }
        }
      }
    ]
  }
]
