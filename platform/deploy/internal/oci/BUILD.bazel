load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "oci",
    srcs = [
        "archive.go",
        "json.go",
        "oci.go",
    ],
    importpath = "ricardo.local/monorepo/platform/deploy/internal/oci",
)

# The committed fixture and the archives the Python helper produced are the
# parity contract: the test compares the Go bytes with them.
go_test(
    name = "oci_test",
    srcs = ["oci_test.go"],
    data = ["//platform/deploy/testdata/oci"],
    embed = [":oci"],
)
