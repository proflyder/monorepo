load("@rules_go//go:def.bzl", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_library(
    name = "render",
    srcs = ["render.go"],
    importpath = "ricardo.local/monorepo/platform/deploy/internal/render",
    deps = ["//platform/deploy/internal/envfile"],
)

# Golden parity: render the real templates with the committed TEST-NET env and
# compare byte for byte with the outputs captured from the Python renderer.
go_test(
    name = "render_test",
    srcs = ["golden_test.go"],
    data = [
        "//platform/deploy/testdata/env",
        "//platform/deploy/testdata/golden",
        "//projects/home/kubernetes/currency-bot:deploy_templates",
        "//projects/home/kubernetes/ingress:deploy_templates",
        "//projects/home/kubernetes/mcp-gateway:deploy_templates",
        "//projects/home/kubernetes/scheduler:deploy_templates",
        "//projects/home/kubernetes/wakegrant:deploy_templates",
    ],
    embed = [":render"],
    deps = ["//platform/deploy/internal/envfile"],
)
