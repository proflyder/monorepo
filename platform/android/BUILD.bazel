load("@rules_kotlin//kotlin:core.bzl", "kt_compiler_plugin", "kt_kotlinc_options")

package(default_visibility = ["//visibility:public"])

kt_kotlinc_options(
    name = "jvm17_options",
    jvm_target = "17",
    # Compiler warnings are regressions: fail the build instead of letting them
    # accumulate in the log. rules_kotlin also derives javac -Werror from this.
    warn = "error",
)

# Metro is a compile-time DI framework: the generated graph implementation is
# produced by this compiler plugin. It is intentionally applied through the
# macros in //platform/android:defs.bzl so every Kotlin module in the Android
# app sees the same plugin.
kt_compiler_plugin(
    name = "metro_compiler_plugin",
    compile_phase = True,
    id = "dev.zacsweers.metro.compiler",
    deps = ["@maven//:dev_zacsweers_metro_compiler"],
)

# Stable personal debug keystore for the Home Android app.
#
# rules_android signs debug APKs with `--ks <file> --ks-pass pass:android` and
# no alias, so the file must contain exactly one entry whose password is
# `android`. A local personal key lives in the gitignored
# `platform/android/keys/home-debug.keystore` (a symlink to
# `secrets/android/home-debug.keystore`). CI and clean checkouts have no such
# file: they must still build, so the genrule falls back to the public
# rules_android debug keystore and warns on stderr. Both are source files, so
# the command stays hermetic and path-agnostic.
genrule(
    name = "home_debug_keystore",
    srcs = glob(
        ["keys/home-debug.keystore"],
        allow_empty = True,
    ) + [
        "@rules_android//tools/android:debug_keystore",
    ],
    outs = ["home_debug.keystore"],
    cmd = "\n".join([
        "set -e",
        "local_key=''",
        "for candidate in $(SRCS); do",
        "  case \"$$candidate\" in",
        "    */keys/home-debug.keystore) local_key=\"$$candidate\" ;;",
        "  esac",
        "done",
        "if [ -n \"$$local_key\" ]; then",
        "  cp \"$$local_key\" $@",
        "else",
        "  cp $(location @rules_android//tools/android:debug_keystore) $@",
        "  echo 'WARNING: platform/android/keys/home-debug.keystore is absent;' \\",
        "       'signing the APK with the public rules_android debug keystore.' \\",
        "       'Create the personal key (see projects/mobile/android/README.md)' \\",
        "       'to get an install-updatable build.' >&2",
        "fi",
    ]),
)

exports_files([
    "defs.bzl",
    "lint.bzl",
    # Reusable artifact checker wrapper; the owning project declares the sh_test
    # and runs //platform/android/tools/apk_runtime_closure inside it.
    "apk_runtime_closure.sh",
])

# The Firebase config is private and never committed. When the gitignored
# symlink is present the genrule embeds its resources; otherwise the app still
# builds and Firebase stays uninitialized.
filegroup(
    name = "google_services_json",
    srcs = glob(
        ["keys/google-services.json"],
        allow_empty = True,
    ),
)
