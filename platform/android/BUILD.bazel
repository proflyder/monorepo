load("@rules_kotlin//kotlin:core.bzl", "define_kt_toolchain", "kt_compiler_plugin", "kt_kotlinc_options")
load(":defs.bzl", "android_all_dir")

package(default_visibility = ["//visibility:public"])

define_kt_toolchain(
    name = "kotlin_toolchain",
    experimental_remove_debug_info_in_abi_jars = True,
    experimental_remove_private_classes_in_abi_jars = True,
    experimental_use_abi_jars = True,
)

kt_kotlinc_options(
    name = "jvm17_options",
    jvm_target = "17",
    warn = "error",
)

kt_compiler_plugin(
    name = "metro_compiler_plugin",
    compile_phase = True,
    id = "dev.zacsweers.metro.compiler",
    deps = ["@maven//:dev_zacsweers_metro_compiler"],
)

kt_compiler_plugin(
    name = "serialization_compiler_plugin",
    compile_phase = True,
    id = "org.jetbrains.kotlinx.serialization",
    deps = ["@maven//:org_jetbrains_kotlin_kotlin_serialization_compiler_plugin_embeddable"],
)

genrule(
    name = "home_debug_keystore",
    srcs = glob(
        ["keys/home-debug.keystore"],
        allow_empty = True,
    ) + [
        "@rules_android//tools/android:debug_keystore",
    ],
    outs = ["home_debug.keystore"],
    cmd = "\n".join([
        "set -e",
        "local_key=''",
        "for candidate in $(SRCS); do",
        "  case \"$$candidate\" in",
        "    */keys/home-debug.keystore) local_key=\"$$candidate\" ;;",
        "  esac",
        "done",
        "if [ -n \"$$local_key\" ]; then",
        "  cp \"$$local_key\" $@",
        "else",
        "  cp $(location @rules_android//tools/android:debug_keystore) $@",
        "  echo 'WARNING: platform/android/keys/home-debug.keystore is absent;' \\",
        "       'signing the APK with the public rules_android debug keystore.' \\",
        "       'Create the personal key (see projects/mobile/android/README.md)' \\",
        "       'to get an install-updatable build.' >&2",
        "fi",
    ]),
)

exports_files([
    "robolectric-deps.properties",
    "defs.bzl",
    "detekt.bzl",
    "lint.bzl",
    "apk_abi_test.sh",
    "apk_manifest_test.sh",
    "apk_runtime_closure.sh",
])

filegroup(
    name = "google_services_json",
    srcs = glob(
        ["keys/google-services.json"],
        allow_empty = True,
    ),
)

platform(
    name = "android_arm64",
    constraint_values = [
        "@platforms//os:android",
        "@platforms//cpu:arm64",
    ],
)

android_all_dir(
    name = "robolectric_android_all_sdk35",
    jar = "@maven//:org_robolectric_android_all_instrumented",
    jar_name = "android-all-instrumented-15-robolectric-13954326-i7.jar",
)
