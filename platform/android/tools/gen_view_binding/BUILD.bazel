load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary", "kt_jvm_library", "kt_jvm_test")

package(default_visibility = ["//visibility:public"])

kt_jvm_library(
    name = "gen_view_binding_lib",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    kotlinc_opts = "//platform/android:jvm17_options",
)

kt_jvm_binary(
    name = "gen_view_binding",
    main_class = "dev.proflyder.home.tools.genviewbinding.MainKt",
    kotlinc_opts = "//platform/android:jvm17_options",
    runtime_deps = [":gen_view_binding_lib"],
)

kt_jvm_test(
    name = "gen_view_binding_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    kotlinc_opts = "//platform/android:jvm17_options",
    test_class = "dev.proflyder.home.tools.genviewbinding.GenViewBindingTest",
    deps = [
        ":gen_view_binding_lib",
        "@maven//:junit_junit",
    ],
)
