load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary", "kt_jvm_library", "kt_jvm_test")

package(default_visibility = ["//visibility:public"])

kt_jvm_library(
    name = "lint_runner_lib",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    kotlinc_opts = "//platform/android:jvm17_options",
    deps = ["@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json"],
)

kt_jvm_binary(
    name = "lint_runner",
    main_class = "dev.proflyder.home.tools.lintrunner.MainKt",
    kotlinc_opts = "//platform/android:jvm17_options",
    runtime_deps = [":lint_runner_lib"],
)

kt_jvm_test(
    name = "lint_runner_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    kotlinc_opts = "//platform/android:jvm17_options",
    test_class = "dev.proflyder.home.tools.lintrunner.LintRunnerTest",
    deps = [
        ":lint_runner_lib",
        "@maven//:junit_junit",
        "@maven//:org_jetbrains_kotlinx_kotlinx_serialization_json",
    ],
)
