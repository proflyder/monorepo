load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_binary(
    name = "lint_runner",
    embed = [":lint_runner_lib"],
)

go_library(
    name = "lint_runner_lib",
    srcs = ["main.go"],
    importpath = "github.com/proflyder/monorepo/platform/android/tools/lint_runner",
    visibility = ["//visibility:private"],
)

go_test(
    name = "lint_runner_test",
    srcs = ["main_test.go"],
    embed = [":lint_runner_lib"],
)
