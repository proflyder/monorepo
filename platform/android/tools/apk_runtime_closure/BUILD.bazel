load("@rules_kotlin//kotlin:jvm.bzl", "kt_jvm_binary", "kt_jvm_library", "kt_jvm_test")

package(default_visibility = ["//visibility:public"])

kt_jvm_library(
    name = "apk_runtime_closure_lib",
    srcs = glob(["src/main/kotlin/**/*.kt"]),
    kotlinc_opts = "//platform/android:jvm17_options",
)

kt_jvm_binary(
    name = "apk_runtime_closure",
    main_class = "dev.proflyder.home.tools.apkruntimeclosure.MainKt",
    kotlinc_opts = "//platform/android:jvm17_options",
    runtime_deps = [":apk_runtime_closure_lib"],
)

kt_jvm_test(
    name = "apk_runtime_closure_test",
    srcs = glob(["src/test/kotlin/**/*.kt"]),
    kotlinc_opts = "//platform/android:jvm17_options",
    test_class = "dev.proflyder.home.tools.apkruntimeclosure.ApkRuntimeClosureTest",
    deps = [
        ":apk_runtime_closure_lib",
        "@maven//:junit_junit",
    ],
)
