load("@rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

package(default_visibility = ["//visibility:public"])

go_binary(
    name = "apk_runtime_closure",
    embed = [":apk_runtime_closure_lib"],
)

go_library(
    name = "apk_runtime_closure_lib",
    srcs = ["main.go"],
    importpath = "ricardo.local/monorepo/platform/android/tools/apk_runtime_closure",
