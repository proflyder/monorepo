# Android-only Bazel flags, activated with `--config=android`.
#
# Imported by the root `.bazelrc` (`try-import`) and selected by every task that
# builds Android targets:
#   * `mise run build|test <unit>` for the android units and the whole-workspace
#     `mise run build` / `mise run test:bazel`
#     (platform/mise-tasks/lib/units-cli.mjs, platform/mise-tasks/test/bazel.sh);
#   * `projects/mobile/android/distribute.sh`;
#   * `deploy-home`'s `warm-android` Android build.
#
# The split exists for CI routing: a flag in the root `.bazelrc` is a global
# input and re-runs every unit, while this file matches `platform/android/**`
# and therefore selects only the Android units (platform/ci/units.mjs).
#
# A bare `bazel build //projects/mobile/android:app` (no `--config=android`) is
# a mistake: the version defines below are missing, so manifest expansion fails
# instead of producing an APK with a literal `$(home_version_code)`. Once
# `--android_platforms=//platform/android:android_arm64` is added here, the
# missing config would also silently pick the wrong ABI;
# `//projects/mobile/android/app:apk_abi_test` guards that.

# Android app version defaults. `distribute.sh` overrides them with
# `--define` (after `--config=android`, so its values win) to give each App
# Distribution build a higher versionCode; ordinary builds stay 1 / 0.1.0.
build:android --define=home_version_code=1
build:android --define=home_version_name=0.1.0

# Package native libraries (JNI .so from AARs such as stream-webrtc-android)
# for the phone ABI, not the host CPU: rules_android filters AAR `jni/` entries
# by the target platform's CPU, and without this flag on a Linux CI host the APK
# got only x86_64 libs and failed with INSTALL_FAILED_NO_MATCHING_ABIS. The
# platform is defined in //platform/android:android_arm64; its C++ toolchain
# comes from the NDK registered in MODULE.bazel (rules_android_ndk).
# //projects/mobile/android/app:apk_abi_test guards the packaged ABIs.
#
# rules_android 0.8 aliases --android_platforms to a Starlark string_list flag
# whose values are converted with Label() inside the rules_android repository,
# so a repo-relative `//platform/...` would resolve to @rules_android. The
# canonical main-repo prefix `@@//` keeps the label pointing at this workspace.
build:android --android_platforms=@@//platform/android:android_arm64

# Android builder tools and rules_android sources use Java 17 language
# features (records, sealed types), and the Bazel tools that package them run
# on JDK 21. These flags affect build tools only, not the Android minSdk.
common:android --java_language_version=17
common:android --tool_java_language_version=17
common:android --java_runtime_version=remotejdk_21
common:android --tool_java_runtime_version=remotejdk_21

# Third-party javac sources that run as build tools (protobuf, the rules_android
# dexer tools) are compiled in the exec configuration and emit their own
# [removal]/deprecation warnings. They are not ours to fix and only add noise to
# every cold build, so silence javac there. First-party Kotlin/Java keeps
# `warn = "error"` (//platform/android:jvm17_options) in the target
# configuration, and android_lint still runs with -Werror.
build:android --host_javacopt=-Xlint:none
build:android --host_javacopt=-nowarn


# Dex and desugar Android libraries in persistent workers instead of one JVM per
# jar (~1200 actions for the Maven dependencies); output is unchanged.
build:android --persistent_android_dex_desugar

# minSdk is 26, so java.time/nio.stream APIs are platform classes and the j$
# core-library shims are unnecessary. rules_android 0.8 starlarkified this flag
# with a default of true; keep the pre-0.8 behaviour (no j$ rewriting) explicit.
build:android --@rules_android//flags:desugar_java8_libs=false

# Report every failing Android target in one run instead of stopping at the
# first broken module (CI rounds are expensive; the result is unchanged).
build:android --keep_going
